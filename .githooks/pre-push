#!/usr/bin/env bash
# Refuses a push whose tree or new commit messages carry unpublishable data
# (scripts/check-public.sh). Enable once per clone: git config core.hooksPath .githooks
set -uo pipefail
zero=0000000000000000000000000000000000000000
check="$(git rev-parse --show-toplevel)/scripts/check-public.sh"
status=0
seen=" "
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # a branch deletion pushes nothing
  case "$seen" in *" $local_sha "*) continue ;; esac
  seen+="$local_sha "
  if [ "$remote_sha" = "$zero" ]; then
    range="origin/main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  # The tree checked is the one being pushed, not the working copy.
  bash "$check" --rev "$local_sha" "$range" || status=1
done
[ $status -eq 0 ] || echo "pre-push: push refused. Fix the lines above (void-eval/harness/sanitize-results.py cleans saved results)."
exit $status

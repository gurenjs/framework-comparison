index 0000000..bf1be4e
--- /dev/null
+++ b/app/Http/Controllers/ApiPostController.ts
@@ -0,0 +1,30 @@
+import { Controller } from '@guren/core'
+import { Post, type PostRecord } from '../../Models/Post.js'
+import { API_USER_KEY } from '../Middleware/ApiTokenAuth.js'
+
+function present(post: PostRecord) {
+  return {
+    id: post.id,
+    title: post.title,
+    excerpt: post.excerpt,
+    authorId: post.authorId,
+    createdAt: new Date(post.createdAt).toISOString(),
+  }
+}
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+
+    return this.json({ data: posts.map(present) })
+  }
+
+  // guren-audit-ignore: the apiToken middleware authenticates the owner; any user may create posts (PostPolicy.create)
+  async store(): Promise<Response> {
+    const authorId = this.ctx.get(API_USER_KEY) as number
+    const { body } = this.validated('api.posts.store')
+    const post = await Post.create(body, { set: { authorId } })
+
+    return this.json({ data: present(post!) }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..2f6728e
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,30 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, HttpException } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { forgetApiTokenWindow, hashApiToken } from '../Middleware/ApiTokenAuth.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { name } = this.validated('profile.tokens.store').body
+    const token = randomBytes(32).toString('base64url')
+    const record = await ApiToken.create({ name }, { set: { userId: user.id, tokenHash: hashApiToken(token) } })
+
+    return this.json({ id: record?.id, name, token }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validated('profile.tokens.destroy').params
+    const record = await ApiToken.first({ id, userId: user.id })
+    if (!record) {
+      throw HttpException.notFound()
+    }
+
+    await ApiToken.delete({ id: record.id })
+    forgetApiTokenWindow(record.id)
+
+    return new Response(null, { status: 204 })
+  }
+}

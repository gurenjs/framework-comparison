diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..24f6d6d
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,46 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware, jsonResponse } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_KEY = 'apiTokenUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+// Per-process counters keyed by token id; a multi-process deploy needs a shared store.
+const windows = new Map<number, { count: number; resetAt: number }>()
+
+export const apiTokenAuth = defineMiddleware(async (c, next) => {
+  const header = c.req.header('Authorization') ?? ''
+  const match = /^Bearer ([A-Za-z0-9_-]{16,200})$/.exec(header)
+  const record = match ? await ApiToken.first({ tokenHash: hashApiToken(match[1]!) }) : null
+  if (!record) {
+    return jsonResponse({ message: 'Unauthenticated.' }, 401)
+  }
+
+  const now = Date.now()
+  let entry = windows.get(record.id)
+  if (!entry || entry.resetAt <= now) {
+    entry = { count: 0, resetAt: now + WINDOW_MS }
+    windows.set(record.id, entry)
+  }
+  entry.count += 1
+  if (entry.count > LIMIT) {
+    const retryAfter = Math.max(1, Math.min(60, Math.ceil((entry.resetAt - now) / 1000)))
+    return new Response(JSON.stringify({ message: 'Too many requests.' }), {
+      status: 429,
+      headers: { 'Content-Type': 'application/json', 'Retry-After': String(retryAfter) },
+    })
+  }
+
+  c.set(API_USER_KEY, record.userId)
+  await next()
+})
+
+export function forgetApiTokenWindow(id: number): void {
+  windows.delete(id)
+}

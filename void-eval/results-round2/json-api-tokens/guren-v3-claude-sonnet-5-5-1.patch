diff --git a/tests/ApiPosts.test.ts b/tests/ApiPosts.test.ts
new file mode 100644
index 0000000..89010c6
--- /dev/null
+++ b/tests/ApiPosts.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('api posts', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = (await User.create({ name: 'Ann', email: 'ann@example.com', password: 'secret-pass-1' })) as UserRecord
+  })
+
+  const issueToken = async (name: string) => {
+    const csrf = await http.actingAs(user).json().withCsrf()
+    const res = await csrf.post('/profile/tokens', { name })
+    expect(res.status).toBe(201)
+    return res.json<{ id: string; token: string }>()
+  }
+
+  const bearer = (token: string) => http.json().withHeaders({ Authorization: `Bearer ${token}` })
+
+  it('rejects a request without a valid bearer token', async () => {
+    await http.json().get('/api/posts').assertStatus(401)
+    await bearer('nope').get('/api/posts').assertStatus(401)
+    await bearer('abc|def').get('/api/posts').assertStatus(401)
+  })
+
+  it('creates posts for the token owner and lists them', async () => {
+    const { token } = await issueToken('CI')
+    const res = await bearer(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    expect(res.status).toBe(201)
+    expect((await res.json<{ data: { authorId: number } }>()).data.authorId).toBe(user.id)
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertStatus(422)
+    expect(await Post.newQuery().count()).toBe(1)
+    await bearer(token).get('/api/posts').assertJsonCount(1, 'data')
+  })
+
+  it('stops a revoked token only', async () => {
+    const first = await issueToken('one')
+    const second = await issueToken('two')
+    const csrf = await http.actingAs(user).json().withCsrf()
+    await csrf.delete(`/profile/tokens/${first.id}`).assertStatus(204)
+    await bearer(first.token).get('/api/posts').assertStatus(401)
+    await bearer(second.token).get('/api/posts').assertStatus(200)
+  })
+
+  it('rate limits per token', async () => {
+    const first = await issueToken('one')
+    const second = await issueToken('two')
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertStatus(200)
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await bearer(second.token).get('/api/posts').assertStatus(200)
+  })
+})

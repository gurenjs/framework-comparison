diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..cbe1bd7
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,41 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  defineMiddleware,
+  getApiToken,
+} from '@guren/core'
+import { apiTokens } from '../../../db/schema.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+const unauthenticated = () =>
+  new Response(JSON.stringify({ message: 'Unauthenticated.' }), {
+    status: 401,
+    headers: { 'Content-Type': 'application/json' },
+  })
+
+const authenticate = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: unauthenticated,
+})
+
+// Keyed by token id, not user, so each of an owner's tokens has its own budget.
+const throttle = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+  message: 'Too many requests.',
+})
+
+export const apiTokenAuth = defineMiddleware(async (c, next) => {
+  const rejected = await authenticate(c, async () => {
+    c.set('apiTokenAuthenticated', true)
+  })
+  if (rejected) return rejected
+  if (!c.get('apiTokenAuthenticated')) return unauthenticated()
+  return throttle(c, next)
+})

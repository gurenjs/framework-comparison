+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,69 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'secret-pass-1' })
+  })
+
+  const issue = async (name: string) => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name })
+    expect(res.status).toBe(201)
+    return res.json<{ id: number; token: string }>()
+  }
+
+  const bearer = (token: string) => http.withHeaders({ Authorization: `Bearer ${token}`, Accept: 'application/json' })
+
+  it('stores only a hash of the token', async () => {
+    const { token } = await issue('CI')
+    const rows = await ApiToken.all()
+    expect(JSON.stringify(rows)).not.toContain(token)
+  })
+
+  it('creates posts as the token owner and lists them', async () => {
+    const { token } = await issue('CI')
+    const created = await bearer(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    expect(created.status).toBe(201)
+    expect((await created.json<{ data: { authorId: number } }>()).data.authorId).toBe(Number(user.id))
+
+    const list = await bearer(token).get('/api/posts')
+    expect(list.status).toBe(200)
+    expect((await list.json<{ data: unknown[] }>()).data).toHaveLength(1)
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertUnprocessable()
+  })
+
+  it('rejects bad and revoked tokens', async () => {
+    const { id, token } = await issue('CI')
+    await bearer('nope').get('/api/posts').assertUnauthorized()
+    await http.json().get('/api/posts').assertUnauthorized()
+
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${id}`).assertNoContent()
+    await bearer(token).get('/api/posts').assertUnauthorized()
+  })
+
+  it('rate limits per token', async () => {
+    const first = await issue('one')
+    const second = await issue('two')
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})

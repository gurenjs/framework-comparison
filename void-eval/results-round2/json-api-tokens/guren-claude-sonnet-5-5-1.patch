+++ b/app/Http/Controllers/ApiPostController.ts
@@ -0,0 +1,25 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../Models/Post.js'
+import { API_TOKEN_CONTEXT_KEY } from '../Middleware/AuthenticateApiToken.js'
+import { PostResource } from '../Resources/PostResource.js'
+
+const present = (post: ConstructorParameters<typeof PostResource>[0]) => {
+  const { id, title, excerpt, authorId, createdAt } = new PostResource(post).toJSON()
+  return { id, title, excerpt, authorId, createdAt }
+}
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('createdAt', 'desc').orderBy('id', 'desc').get()
+
+    return this.json({ data: posts.map(present) })
+  }
+
+  async store(): Promise<Response> {
+    const { body: data } = this.validated('api.posts.store')
+    const token = this.ctx.get(API_TOKEN_CONTEXT_KEY) as { userId: number }
+    const post = await Post.create(data, { set: { authorId: token.userId } })
+
+    return this.created({ data: present(post) })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..c45e448
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,32 @@
+import { randomBytes } from 'node:crypto'
+import { Controller } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { hashApiToken } from '../Middleware/AuthenticateApiToken.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const plain = randomBytes(32).toString('hex')
+    const token = await ApiToken.create(body, {
+      set: { userId: user.id, tokenHash: hashApiToken(plain) },
+    })
+
+    return this.created({ id: token.id, name: token.name, token: plain })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+    const token = await ApiToken.first({ id, userId: user.id })
+    if (!token) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await ApiToken.delete({ id: token.id })
+
+    return this.noContent()
+  }
+}

diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..6ea79e6
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,33 @@
+import { createHash } from 'node:crypto'
+import { createRateLimitMiddleware, defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_TOKEN_CONTEXT_KEY = 'api-token'
+
+export const hashApiToken = (plain: string): string => createHash('sha256').update(plain).digest('hex')
+
+const unauthorized = () =>
+  Response.json({ message: 'Unauthenticated.' }, { status: 401, headers: { 'WWW-Authenticate': 'Bearer' } })
+
+const limitPerToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => String(c.get(API_TOKEN_CONTEXT_KEY).tokenHash),
+  onRateLimited: (_c, retryAfter) =>
+    Response.json(
+      { message: 'Too many requests.' },
+      { status: 429, headers: { 'Retry-After': String(Math.min(60, Math.max(1, Math.ceil(retryAfter)))) } },
+    ),
+})
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const match = /^Bearer +(\S+)$/i.exec(c.req.header('Authorization') ?? '')
+  if (!match) return unauthorized()
+
+  const token = await ApiToken.first({ tokenHash: hashApiToken(match[1]) })
+  if (!token) return unauthorized()
+
+  c.set(API_TOKEN_CONTEXT_KEY, token)
+  return limitPerToken(c, next)
+})

+            <input
+              type="text"
+              value={tokenForm.data.name}
+              maxLength={50}
+              onChange={(event) => tokenForm.setData('name', event.target.value)}
+            />
+            <button type="submit">Create token</button>
+          </form>
+          <ul>
+            {tokens.map((token) => (
+              <li key={token.id}>
+                <span>{token.name}</span>
+                <button
+                  type="button"
+                  onClick={() => router.delete(`/profile/tokens/${token.id}`, { preserveScroll: true })}
+                >
+                  Revoke
+                </button>
+              </li>
+            ))}
+          </ul>
+        </section>
       </section>
     </Layout>
   )

diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..efefe26
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,52 @@
+import { defineMiddleware, readBearerToken } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import { API_TOKEN_PREFIX, hashApiToken } from '../../Auth/ApiTokens.js'
+
+export const API_TOKEN_USER_KEY = 'apiToken.userId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Per process: with several instances the effective limit is LIMIT per instance.
+const windows = new Map<number, { count: number; resetAt: number }>()
+
+function hit(tokenId: number, now: number): { limited: boolean; retryAfter: number } {
+  if (windows.size > 10_000) {
+    for (const [key, entry] of windows) {
+      if (entry.resetAt <= now) windows.delete(key)
+    }
+  }
+
+  let entry = windows.get(tokenId)
+  if (!entry || entry.resetAt <= now) {
+    entry = { count: 0, resetAt: now + WINDOW_MS }
+    windows.set(tokenId, entry)
+  }
+  entry.count += 1
+
+  return {
+    limited: entry.count > LIMIT,
+    retryAfter: Math.min(60, Math.max(1, Math.ceil((entry.resetAt - now) / 1000))),
+  }
+}
+
+export default defineMiddleware(async (c, next) => {
+  const plain = readBearerToken(c.req.header('Authorization'))?.trim()
+  if (!plain || !plain.startsWith(API_TOKEN_PREFIX)) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  const token = await ApiToken.first({ tokenHash: hashApiToken(plain) })
+  if (!token) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  const { limited, retryAfter } = hit(token.id, Date.now())
+  if (limited) {
+    c.header('Retry-After', String(retryAfter))
+    return c.json({ message: 'Too many requests.' }, 429)
+  }
+
+  c.set(API_TOKEN_USER_KEY, token.userId)
+  return next()
+})

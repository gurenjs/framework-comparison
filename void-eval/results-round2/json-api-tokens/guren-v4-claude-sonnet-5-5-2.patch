diff --git a/app/Auth/ApiTokens.ts b/app/Auth/ApiTokens.ts
new file mode 100644
index 0000000..f65cd80
--- /dev/null
+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,13 @@
+import { createHash, randomBytes } from 'node:crypto'
+
+export const API_TOKEN_PREFIX = 'gat_'
+
+export function generateApiToken(): string {
+  return API_TOKEN_PREFIX + randomBytes(32).toString('hex')
+}
+
+// The raw token is already 256 bits of randomness, so a fast unsalted hash is
+// enough and lets the bearer lookup be a single indexed equality query.
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}

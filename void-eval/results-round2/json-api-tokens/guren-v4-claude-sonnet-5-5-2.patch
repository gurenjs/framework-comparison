diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..6f2e8da
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,72 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+
+const json = { Accept: 'application/json', 'Content-Type': 'application/json' }
+
+function call(path: string, init: RequestInit & { token?: string; cookie?: string } = {}) {
+  const { token, cookie, headers, ...rest } = init
+  return app.fetch(new Request(`http://localhost${path}`, {
+    ...rest,
+    headers: {
+      ...json,
+      ...(token ? { Authorization: `Bearer ${token}` } : {}),
+      ...(cookie ? { Cookie: cookie } : {}),
+      ...(headers as Record<string, string> | undefined),
+    },
+  }))
+}
+
+describe('api tokens', () => {
+  beforeAll(async () => {
+    await TestApp.fromApp(app)
+    await resetDatabase()
+    await User.create({ name: 'A', email: 'a@example.com', password: 'password123' })
+  })
+
+  it('rejects missing and unknown bearer tokens', async () => {
+    expect((await call('/api/posts')).status).toBe(401)
+    expect((await call('/api/posts', { token: 'nope' })).status).toBe(401)
+    const write = await call('/api/posts', { method: 'POST', token: 'gat_nope', body: '{}' })
+    expect(write.status).toBe(401)
+  })
+
+  it('stores only a hash and rate limits per token', async () => {
+    const user = (await User.first({ email: 'a@example.com' }))!
+    const session = await (await TestApp.fromApp(app)).actingAs(user).withCsrf()
+    const mint = async (name: string) => {
+      const res = await session.json().post('/profile/tokens', { name })
+      expect(res.status).toBe(201)
+      return (await res.json()) as { id: number; token: string }
+    }
+    const { token: plain } = await mint('CI')
+    const { id: otherId, token: other } = await mint('two')
+    expect((await session.json().post('/profile/tokens', { name: '' })).status).toBe(422)
+    for (const row of await ApiToken.newQuery().get()) {
+      expect(Object.values(row).some((v) => typeof v === 'string' && (v === plain || v === other))).toBe(false)
+    }
+
+    const created = await call('/api/posts', {
+      method: 'POST',
+      token: plain,
+      body: JSON.stringify({ title: 'T', excerpt: 'E', body: 'B', authorId: 999 }),
+    })
+    expect(created.status).toBe(201)
+    expect(((await created.json()) as { data: { authorId: number } }).data.authorId).toBe(user.id)
+
+    const invalid = await call('/api/posts', { method: 'POST', token: plain, body: JSON.stringify({ title: '' }) })
+    expect(invalid.status).toBe(422)
+
+    for (let i = 0; i < 58; i++) expect((await call('/api/posts', { token: plain })).status).toBe(200)
+    const limited = await call('/api/posts', { token: plain })
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    expect((await call('/api/posts', { token: other })).status).toBe(200)
+
+    expect((await session.json().delete(`/profile/tokens/${otherId}`)).status).toBe(204)
+    expect((await call('/api/posts', { token: other })).status).toBe(401)
+  })
+})

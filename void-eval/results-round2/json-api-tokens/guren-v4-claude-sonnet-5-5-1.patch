diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..f2fbcb0
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,40 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_TOKEN_USER_KEY = 'api-token-user-id'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Per-process counters, keyed by token id so two tokens of one user are
+// limited independently. Use a shared store if the app runs several processes.
+const windows = new Map<number, { start: number; count: number }>()
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+export default defineMiddleware(async (c, next) => {
+  const header = c.req.header('Authorization') ?? ''
+  const match = header.match(/^Bearer\s+(\S+)$/i)
+  const record = match ? await ApiToken.first({ tokenHash: hashApiToken(match[1]) }) : null
+  if (!record) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  const now = Date.now()
+  let entry = windows.get(record.id)
+  if (!entry || now - entry.start >= WINDOW_MS) {
+    entry = { start: now, count: 0 }
+    windows.set(record.id, entry)
+  }
+  entry.count += 1
+  if (entry.count > LIMIT) {
+    const retryAfter = Math.max(1, Math.min(60, Math.ceil((entry.start + WINDOW_MS - now) / 1000)))
+    return c.json({ message: 'Too many requests.' }, 429, { 'Retry-After': String(retryAfter) })
+  }
+
+  c.set(API_TOKEN_USER_KEY, record.userId)
+  return next()
+})

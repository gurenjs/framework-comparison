diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..f3cb433
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,23 @@
+import { API_TOKEN_KEY, createRateLimitMiddleware, defineMiddleware, readBearerToken, verifyApiToken } from '@guren/core'
+import type { VerifiedApiToken } from '@guren/core'
+import { apiTokenStore } from '../../Auth/ApiTokens.js'
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const plainText = readBearerToken(c.req.header('Authorization'))
+  const verified = plainText ? await verifyApiToken(plainText, apiTokenStore()) : null
+  if (!verified) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  c.set(API_TOKEN_KEY, verified)
+  return next()
+})
+
+// Keyed on the token, not the account: two tokens of one user get a limit each.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => (c.get(API_TOKEN_KEY) as VerifiedApiToken).token.id,
+  message: 'Too many requests.',
+})

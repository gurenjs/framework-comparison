diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..4bd8217
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,38 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_ID_KEY = 'apiUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Per process, per token: two tokens of one user never share a counter.
+const windows = new Map<number, { resetAt: number; count: number }>()
+
+export function hashApiToken(plain: string): string {
+  return createHash('sha256').update(plain).digest('hex')
+}
+
+export default defineMiddleware(async (c, next) => {
+  const match = /^Bearer ([^\s]+)$/i.exec(c.req.header('Authorization') ?? '')
+  const token = match ? await ApiToken.first({ tokenHash: hashApiToken(match[1]!) }) : null
+  if (!token) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  const now = Date.now()
+  let entry = windows.get(token.id)
+  if (!entry || entry.resetAt <= now) {
+    entry = { resetAt: now + WINDOW_MS, count: 0 }
+    windows.set(token.id, entry)
+  }
+  entry.count += 1
+  if (entry.count > LIMIT) {
+    const retryAfter = Math.min(60, Math.max(1, Math.ceil((entry.resetAt - now) / 1000)))
+    return c.json({ message: 'Too many requests.' }, 429, { 'Retry-After': String(retryAfter) })
+  }
+
+  c.set(API_USER_ID_KEY, token.userId)
+  await next()
+})

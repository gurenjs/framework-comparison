+        <h2>API tokens</h2>
+        {newToken ? <p>Copy your new token now, it will not be shown again: <code>{newToken}</code></p> : null}
+        <form onSubmit={createToken}>
+          <label>Token name</label>
+          <input type="text" value={tokenName} onChange={(event) => setTokenName(event.target.value)} />
+          {tokenError ? <p>{tokenError}</p> : null}
+          <button type="submit">Create token</button>
+        </form>
+        <ul>
+          {tokens.map((token) => (
+            <li key={token.id}>
+              {token.name}
+              <button type="button" onClick={() => revokeToken(token.id)}>Revoke</button>
+            </li>
+          ))}
+        </ul>
       </section>
     </Layout>
   )

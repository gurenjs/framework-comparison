diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..25a0f5f
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,62 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('api tokens', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'secret-pass-1' })
+  })
+
+  async function issue(name = 'CI') {
+    const session = await http.actingAs(user).withCsrf()
+    const res = await session.json().post('/profile/tokens', { name }).assertCreated()
+    return (await res.json()) as { id: number; name: string; token: string }
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  it('stores only a hash and authenticates as the owner', async () => {
+    const created = await issue()
+    expect(created.token.length).toBeGreaterThanOrEqual(16)
+    const rows = await ApiToken.where({}).get()
+    expect(JSON.stringify(rows)).not.toContain(created.token)
+
+    const res = await bearer(created.token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 }).assertCreated()
+    expect(((await res.json()) as { data: { authorId: number } }).data.authorId).toBe(user.id)
+    await bearer(created.token).get('/api/posts').assertOk()
+    expect(await Post.where({}).count()).toBe(1)
+  })
+
+  it('validates, rejects bad tokens, and revokes', async () => {
+    const created = await issue()
+    await bearer(created.token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertStatus(422)
+    await bearer(`${created.token}x`).get('/api/posts').assertStatus(401)
+    const session = await http.actingAs(user).withCsrf()
+    await session.json().post('/profile/tokens', { name: '' }).assertStatus(422)
+    await session.json().delete(`/profile/tokens/${created.id + 50}`).assertNotFound()
+    await session.json().delete(`/profile/tokens/${created.id}`).assertNoContent()
+    await bearer(created.token).get('/api/posts').assertStatus(401)
+  })
+
+  it('rate limits per token', async () => {
+    const a = await issue('a')
+    const b = await issue('b')
+    for (let i = 0; i < 60; i++) await bearer(a.token).get('/api/posts').assertOk()
+    const limited = await bearer(a.token).get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await bearer(b.token).get('/api/posts').assertOk()
+  })
+})

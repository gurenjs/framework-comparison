+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { authenticateApiToken, throttleApiToken } from '../app/Http/Middleware/ApiTokenAuth.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+export function registerApiRoutes(baseRouter: Router): void {
+  const router = baseRouter
+    .aliasMiddleware('api.auth', authenticateApiToken)
+    .aliasMiddleware('api.throttle', throttleApiToken)
+
+  router.group('/api', (api) => {
+    api.middleware('api.auth', 'api.throttle').group((authed) => {
+      authed.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      authed.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+    })
+  })
+}

diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..740e488
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,32 @@
+import { createHash } from 'node:crypto'
+import { MemoryRateLimitStore, createRateLimitMiddleware, defineMiddleware, readBearerToken } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_KEY = 'api.userId'
+const API_TOKEN_KEY = 'api.tokenHash'
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const plain = readBearerToken(c.req.header('Authorization'))?.trim()
+  const tokenHash = plain ? hashApiToken(plain) : null
+  const token = tokenHash ? await ApiToken.first({ tokenHash }) : null
+  if (!token || !tokenHash) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+  c.set(API_USER_KEY, token.userId)
+  c.set(API_TOKEN_KEY, tokenHash)
+  await next()
+})
+
+// Keyed by token (its hash) so each token of one user gets its own 60 a minute.
+export const throttleApiToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => String(c.get(API_TOKEN_KEY)),
+  message: 'Too many requests.',
+})

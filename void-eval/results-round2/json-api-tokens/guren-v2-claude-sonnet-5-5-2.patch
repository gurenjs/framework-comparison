diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..4a3ce39
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,42 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_ID_KEY = 'apiTokenUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+// Per-process counters keyed by token id; each window opens at the token's first request.
+const windows = new Map<number, { count: number; resetAt: number }>()
+
+function hit(tokenId: number, now: number): number | null {
+  for (const [id, entry] of windows) {
+    if (entry.resetAt <= now) windows.delete(id)
+  }
+  const entry = windows.get(tokenId) ?? { count: 0, resetAt: now + WINDOW_MS }
+  entry.count += 1
+  windows.set(tokenId, entry)
+  return entry.count > LIMIT ? Math.max(1, Math.ceil((entry.resetAt - now) / 1000)) : null
+}
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const header = c.req.header('authorization') ?? ''
+  const match = /^Bearer ([A-Za-z0-9_-]{16,200})$/.exec(header)
+  const record = match ? await ApiToken.first({ tokenHash: hashApiToken(match[1]!) }) : null
+  if (!record) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  const retryAfter = hit(record.id, Date.now())
+  if (retryAfter !== null) {
+    return c.json({ message: 'Too many requests.' }, 429, { 'Retry-After': String(retryAfter) })
+  }
+
+  c.set(API_USER_ID_KEY, record.userId)
+  await next()
+})

@@ -0,0 +1,26 @@
+import { Controller } from '@guren/core'
+import { Post } from '../../../Models/Post.js'
+import { API_USER_ID_KEY } from '../../Middleware/AuthenticateApiToken.js'
+import { PostResource } from '../../Resources/PostResource.js'
+import { PostPayloadSchema } from '../../Validators/PostValidator.js'
+
+function present(resource: PostResource) {
+  const { id, title, excerpt, authorId, createdAt } = resource.toJSON()
+  return { id, title, excerpt, authorId, createdAt }
+}
+
+export default class PostApiController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+
+    return this.json({ data: posts.map((post) => present(new PostResource(post))) })
+  }
+
+  async store(): Promise<Response> {
+    const authorId = this.ctx.get(API_USER_ID_KEY) as number
+    const data = await this.validateBody(PostPayloadSchema)
+    const post = await Post.forceCreate({ ...data, authorId })
+
+    return this.json({ data: present(new PostResource(post)) }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..403bcc9
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,32 @@
+import { Controller } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { ApiTokenIdParamSchema } from '../Validators/ApiTokenValidator.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const plainText = ApiToken.generatePlainText()
+    const record = await ApiToken.forceCreate({
+      userId: user.id,
+      name: body.name,
+      tokenHash: ApiToken.hash(plainText),
+    })
+
+    return this.json({ id: record.id, name: record.name, token: plainText }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validateParams(ApiTokenIdParamSchema)
+    const record = await ApiToken.first({ id, userId: user.id })
+    if (!record) {
+      return this.json({ message: 'Not found.' }, { status: 404 })
+    }
+
+    await ApiToken.delete({ id: record.id })
+
+    return new Response(null, { status: 204 })
+  }
+}

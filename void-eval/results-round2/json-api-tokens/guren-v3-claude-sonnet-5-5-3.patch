diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..7d828f4
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,41 @@
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_ID_KEY = 'apiUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+// Per-process fixed window keyed by token id, so two tokens of one user count separately.
+const windows = new Map<number, { start: number; count: number }>()
+
+function unauthorized(): Response {
+  return Response.json({ message: 'Unauthenticated.' }, { status: 401 })
+}
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const header = c.req.header('authorization') ?? ''
+  const match = /^Bearer ([A-Za-z0-9_-]{16,})$/.exec(header)
+  if (!match) return unauthorized()
+
+  const record = await ApiToken.first({ tokenHash: ApiToken.hash(match[1]!) })
+  if (!record) return unauthorized()
+
+  const now = Date.now()
+  let entry = windows.get(record.id)
+  if (!entry || now - entry.start >= WINDOW_MS) {
+    entry = { start: now, count: 0 }
+    windows.set(record.id, entry)
+  }
+  entry.count += 1
+  if (entry.count > LIMIT) {
+    const retryAfter = Math.max(1, Math.min(60, Math.ceil((entry.start + WINDOW_MS - now) / 1000)))
+    return Response.json(
+      { message: 'Too many requests.' },
+      { status: 429, headers: { 'Retry-After': String(retryAfter) } },
+    )
+  }
+
+  c.set(API_USER_ID_KEY, record.userId)
+  await next()
+})

+import PostApiController from '../app/Http/Controllers/Api/PostApiController.js'
+import { authenticateApiToken } from '../app/Http/Middleware/AuthenticateApiToken.js'
+
+export function registerApiRoutes(router: Router<'auth' | 'guest'>): void {
+  router.aliasMiddleware('api', authenticateApiToken).middleware('api').group((api) => {
+    api.get('/api/posts', [PostApiController, 'index']).name('api.posts.index')
+    api.post('/api/posts', [PostApiController, 'store']).name('api.posts.store')
+  })
+}

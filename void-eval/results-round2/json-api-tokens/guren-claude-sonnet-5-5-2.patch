+import type { Router } from '@guren/core'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+// Uses the 'api.token' and 'api.throttle' aliases routes/web.ts registers on this router.
+export function registerApiRoutes(router: Router<'api.token' | 'api.throttle'>): void {
+  router.group('/api', (api) => {
+    // Authentication first: the throttle keys on the verified token.
+    api.middleware('api.token', 'api.throttle').group((tokened) => {
+      tokened.get('/posts', [ApiPostController, 'index']).name('api.posts.index')
+      tokened.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+    })
+  })
+}

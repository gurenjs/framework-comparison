diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..54cd6c4
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, describe, it, expect } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { User } from '../app/Models/User.js'
+
+function bearer(token: string): Record<string, string> {
+  return { Authorization: `Bearer ${token}`, Accept: 'application/json', 'Content-Type': 'application/json' }
+}
+
+describe('api tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  it('rejects a missing or unknown bearer token', async () => {
+    await http.json().get('/api/posts').assertStatus(401)
+    const response = await app.fetch(
+      new Request('http://localhost:3333/api/posts', { headers: bearer('abc|def') }),
+    )
+    expect(response.status).toBe(401)
+  })
+
+  it('creates, uses, throttles and revokes a token', async () => {
+    const user = await User.create({
+      name: 'Tok',
+      email: `tok-${Date.now()}@example.com`,
+      password: 'password123',
+    })
+    const session = await (await http.actingAs(user).withCsrf()).json()
+
+    await session.post('/profile/tokens', { name: '' }).assertStatus(422)
+
+    const created = await session.post('/profile/tokens', { name: 'CI' })
+    created.assertCreated()
+    const { id, token } = await created.json<{ id: string; token: string }>()
+
+    const post = await app.fetch(
+      new Request('http://localhost:3333/api/posts', {
+        method: 'POST',
+        headers: bearer(token),
+        body: JSON.stringify({ title: 'T', excerpt: 'E', body: 'B', authorId: 999 }),
+      }),
+    )
+    expect(post.status).toBe(201)
+    expect((await post.json()).data.authorId).toBe(user.id)
+
+    const list = await app.fetch(new Request('http://localhost:3333/api/posts', { headers: bearer(token) }))
+    expect(list.status).toBe(200)
+
+    let last = list
+    for (let i = 0; i < 60; i++) {
+      last = await app.fetch(new Request('http://localhost:3333/api/posts', { headers: bearer(token) }))
+    }
+    expect(last.status).toBe(429)
+    expect(Number(last.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+
+    await session.delete(`/profile/tokens/${id}`).assertNoContent()
+    await session.delete(`/profile/tokens/${id}`).assertNotFound()
+    const revoked = await app.fetch(new Request('http://localhost:3333/api/posts', { headers: bearer(token) }))
+    expect(revoked.status).toBe(401)
+  })
+})

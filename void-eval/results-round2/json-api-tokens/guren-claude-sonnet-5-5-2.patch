diff --git a/app/Http/Middleware/ApiTokens.ts b/app/Http/Middleware/ApiTokens.ts
new file mode 100644
index 0000000..7b3fa59
--- /dev/null
+++ b/app/Http/Middleware/ApiTokens.ts
@@ -0,0 +1,36 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+} from '@guren/core'
+import type { MiddlewareHandler } from 'hono'
+import { apiTokens } from '../../../db/schema.js'
+
+// Built on first use: the store needs the ORM, which is configured at boot.
+let store: DatabaseApiTokenStore | undefined
+
+export function apiTokenStore(): DatabaseApiTokenStore {
+  store ??= new DatabaseApiTokenStore(apiTokens)
+  return store
+}
+
+export const authenticateApiToken: MiddlewareHandler = (c, next) =>
+  createBearerTokenMiddleware({
+    store: apiTokenStore(),
+    onUnauthorized: (ctx) => ctx.json({ message: 'Unauthenticated.' }, 401),
+  })(c, next)
+
+const REQUESTS_PER_MINUTE = 60
+
+// Runs after authenticateApiToken, so only verified tokens get a counter and
+// the key is the token's own id: two tokens of one user are counted apart.
+export const throttleApiToken: MiddlewareHandler = createRateLimitMiddleware({
+  limit: REQUESTS_PER_MINUTE,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'anonymous',
+  message: 'Too many requests.',
+})

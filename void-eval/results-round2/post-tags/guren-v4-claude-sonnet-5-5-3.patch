diff --git a/app/Services/PostTags.ts b/app/Services/PostTags.ts
new file mode 100644
index 0000000..4bc4666
--- /dev/null
+++ b/app/Services/PostTags.ts
@@ -0,0 +1,41 @@
+import { Tag } from '../Models/Tag.js'
+import { PostTag } from '../Models/PostTag.js'
+
+export type WithTags<T> = T & { tags: string[] }
+
+export async function attachTagNames<T extends { id: number }>(posts: T[]): Promise<WithTags<T>[]> {
+  if (posts.length === 0) return []
+
+  const links = await PostTag.newQuery()
+    .whereIn('postId', posts.map((post) => post.id))
+    .get()
+  const tagIds = [...new Set(links.map((link) => link.tagId))]
+  const tags = tagIds.length > 0 ? await Tag.newQuery().whereIn('id', tagIds).get() : []
+  const nameById = new Map(tags.map((tag) => [tag.id, tag.name]))
+
+  return posts.map((post) => ({
+    ...post,
+    tags: links
+      .filter((link) => link.postId === post.id)
+      .map((link) => nameById.get(link.tagId))
+      .filter((name): name is string => name !== undefined)
+      .sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)),
+  }))
+}
+
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  await PostTag.delete({ postId })
+
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    await PostTag.create({ postId, tagId: tag.id })
+  }
+}
+
+export async function postIdsForTag(name: string): Promise<number[]> {
+  const tag = await Tag.first({ name })
+  if (!tag) return []
+
+  const links = await PostTag.newQuery().where('tagId', tag.id).get()
+  return links.map((link) => link.postId)
+}

diff --git a/app/Models/PostTags.ts b/app/Models/PostTags.ts
new file mode 100644
index 0000000..601391d
--- /dev/null
+++ b/app/Models/PostTags.ts
@@ -0,0 +1,41 @@
+import type { PostRecord } from './Post.js'
+import { PostTag } from './PostTag.js'
+import { Tag } from './Tag.js'
+
+async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const names = new Map<number, string[]>()
+  if (postIds.length === 0) return names
+
+  const links = await PostTag.where({ postId: postIds }).get()
+  if (links.length === 0) return names
+  const tagRows = await Tag.where({ id: [...new Set(links.map((link) => link.tagId))] }).get()
+  const nameById = new Map(tagRows.map((tag) => [tag.id, tag.name]))
+
+  for (const link of links) {
+    const name = nameById.get(link.tagId)
+    if (name === undefined) continue
+    names.set(link.postId, [...(names.get(link.postId) ?? []), name])
+  }
+  for (const list of names.values()) list.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+  return names
+}
+
+export async function withTags<T extends PostRecord>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+  const names = await tagNamesByPost(posts.map((post) => post.id))
+  return posts.map((post) => ({ ...post, tags: names.get(post.id) ?? [] }))
+}
+
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const tag = await Tag.first({ name })
+  if (!tag) return []
+  const links = await PostTag.where({ tagId: tag.id }).get()
+  return links.map((link) => link.postId)
+}
+
+export async function syncTags(postId: number, names: string[]): Promise<void> {
+  await PostTag.delete({ postId })
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    await PostTag.create({ postId, tagId: tag.id })
+  }
+}

diff --git a/app/Models/PostTag.ts b/app/Models/PostTag.ts
new file mode 100644
index 0000000..c22a43d
--- /dev/null
+++ b/app/Models/PostTag.ts
@@ -0,0 +1,31 @@
+import { defineModel } from '@guren/core'
+import { Tag } from './Tag.js'
+import { postTags } from '../../db/schema.js'
+
+export type PostTagRecord = typeof postTags.$inferSelect
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
+
+export async function withTags<T extends { id: number }>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+  const links = await PostTag.where({ postId: posts.map((post) => post.id) }).get()
+  const tagRows = await Tag.where({ id: [...new Set(links.map((link) => link.tagId))] }).get()
+  const names = new Map(tagRows.map((tag) => [tag.id, tag.name]))
+
+  return posts.map((post) => ({
+    ...post,
+    tags: links
+      .filter((link) => link.postId === post.id)
+      .map((link) => names.get(link.tagId) as string)
+      .sort(),
+  }))
+}
+
+export async function syncTags(postId: number, names: string[]): Promise<void> {
+  await PostTag.delete({ postId })
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    await PostTag.create({ postId, tagId: tag.id })
+  }
+}

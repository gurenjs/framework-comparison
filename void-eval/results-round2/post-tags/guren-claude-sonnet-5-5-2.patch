+  private async withTags<T extends { id: number }>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+    const links = posts.length > 0 ? await PostTag.where({ postId: posts.map((post) => post.id) }).get() : []
+    const tagIds = [...new Set(links.map((link) => link.tagId))]
+    const tags = tagIds.length > 0 ? await Tag.where({ id: tagIds }).get() : []
+    const nameById = new Map(tags.map((tag) => [tag.id, tag.name]))
+
+    return posts.map((post) => ({
+      ...post,
+      tags: links
+        .filter((link) => link.postId === post.id)
+        .map((link) => nameById.get(link.tagId))
+        .filter((name): name is string => name !== undefined)
+        .sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)),
+    }))
+  }
+
+  private async syncTags(postId: number, names: string[]): Promise<void> {
+    const ids: number[] = []
+    for (const name of names) {
+      const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+      ids.push(tag.id)
+    }
+    await PostTag.delete({ postId })
+    for (const tagId of ids) await PostTag.create({ postId, tagId })
+  }
 }

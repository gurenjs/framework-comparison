diff --git a/app/Models/PostTagNames.ts b/app/Models/PostTagNames.ts
new file mode 100644
index 0000000..407d734
--- /dev/null
+++ b/app/Models/PostTagNames.ts
@@ -0,0 +1,38 @@
+import { Tag } from './Tag.js'
+import { PostTag } from './PostTag.js'
+
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const names = new Map<number, string[]>()
+  if (postIds.length === 0) return names
+
+  const links = await PostTag.whereIn('postId', postIds).get()
+  if (links.length === 0) return names
+  const tags = await Tag.whereIn('id', [...new Set(links.map((link) => link.tagId))]).get()
+  const nameById = new Map(tags.map((tag) => [tag.id, tag.name]))
+
+  for (const link of links) {
+    const name = nameById.get(link.tagId)
+    if (name === undefined) continue
+    names.set(link.postId, [...(names.get(link.postId) ?? []), name])
+  }
+  for (const list of names.values()) list.sort()
+  return names
+}
+
+export async function syncPostTags(postId: number, tagNames: string[]): Promise<void> {
+  const tagIds: number[] = []
+  for (const name of tagNames) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    tagIds.push(tag.id)
+  }
+
+  await PostTag.delete({ postId })
+  for (const tagId of tagIds) await PostTag.create({ postId, tagId })
+}
+
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const tag = await Tag.first({ name })
+  if (!tag) return []
+  const links = await PostTag.where({ tagId: tag.id }).get()
+  return links.map((link) => link.postId)
+}

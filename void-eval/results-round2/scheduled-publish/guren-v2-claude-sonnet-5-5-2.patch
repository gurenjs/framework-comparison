+const now = () => new Date().toISOString()
+
+// ISO 8601 UTC strings sort lexicographically, so a text comparison is a time comparison.
+function visibleTo<T extends { where: Function; whereNull: Function }>(query: T, viewerId: number | null): T {
+  return query.where((q: any) => {
+    q.whereNull('publishedAt').orWhere('publishedAt', '<=', now())
+    if (viewerId !== null) q.orWhere('authorId', viewerId)
+  })
+}
+
+function toStored(publishAt: string | null | undefined): string | null {
+  return publishAt ? new Date(publishAt).toISOString() : null
+}
+
+async function viewerId(auth: { id(): Promise<unknown> }): Promise<number | null> {
+  const id = await auth.id()
+  return id === null || id === undefined ? null : Number(id)
+}

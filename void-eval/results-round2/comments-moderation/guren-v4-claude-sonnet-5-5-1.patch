--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,17 @@
+import { defineModel, type BelongsToRecord } from '@guren/core'
+import { comments } from '../../db/schema.js'
+import type { UserRecord } from './User.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type CommentAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+
+export class Comment extends defineModel(comments, {
+  // `postId` and `userId` come from the route and the session, never from the body.
+  fillable: ['body'],
+}) {
+  static override relationTypes: { author: BelongsToRecord<CommentAuthorSummary> } = {
+    author: null,
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')

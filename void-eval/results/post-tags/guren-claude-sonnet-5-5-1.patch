diff --git a/app/Support/PostTags.ts b/app/Support/PostTags.ts
new file mode 100644
index 0000000..3aa5dc1
--- /dev/null
+++ b/app/Support/PostTags.ts
@@ -0,0 +1,33 @@
+import { PostTag } from '../Models/PostTag.js'
+import { Tag } from '../Models/Tag.js'
+
+export async function withTags<T extends { id: number }>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+  const links = posts.length > 0 ? await PostTag.where({ postId: posts.map((post) => post.id) }).get() : []
+  const tagIds = [...new Set(links.map((link) => link.tagId))]
+  const names = new Map((tagIds.length > 0 ? await Tag.where({ id: tagIds }).get() : []).map((tag) => [tag.id, tag.name]))
+
+  return posts.map((post) => ({
+    ...post,
+    tags: links
+      .filter((link) => link.postId === post.id)
+      .map((link) => names.get(link.tagId) as string)
+      .sort(),
+  }))
+}
+
+export async function syncTags(postId: number, names: string[]): Promise<void> {
+  const tagIds: number[] = []
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    tagIds.push(tag.id)
+  }
+
+  await PostTag.delete({ postId })
+  for (const tagId of tagIds) {
+    await PostTag.create({ postId, tagId })
+  }
+}
+
+export async function tagged<T extends { id: number }>(post: T): Promise<T & { tags: string[] }> {
+  return (await withTags([post]))[0] as T & { tags: string[] }
+}

diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..ae8538e
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,50 @@
+import { beforeEach, beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+const base = { title: 'Hello', excerpt: 'Ex', body: 'Body' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass-1' })
+  })
+
+  it('creates, dedupes, edits and filters by tag', async () => {
+    await (await http.actingAs(user).withCsrf()).post('/posts', { ...base, tags: ' bun ,bun, webdev,' }).assertRedirect()
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect((await PostTag.all()).length).toBe(2)
+
+    const post = (await Post.all())[0]!
+    await (await http.actingAs(user).withCsrf()).put(`/posts/${post.id}`, { ...base, tags: 'bun' }).assertRedirect()
+    expect((await PostTag.all()).length).toBe(1)
+
+    await (await http.actingAs(user).withCsrf()).post('/posts', { ...base, title: 'Other' }).assertRedirect()
+    const hit = await http.get('/posts?tag=bun')
+    const page = (await hit.text()).includes('Hello')
+    expect(page).toBe(true)
+    expect((await (await http.get('/posts?tag=none')).text()).includes('Hello')).toBe(false)
+
+    await (await http.actingAs(user).withCsrf()).delete(`/posts/${post.id}`).assertRedirect()
+  })
+
+  it('refuses invalid tag lists', async () => {
+    await (await http.actingAs(user).withCsrf()).post('/posts', { ...base, tags: 'a,b,c,d,e,f' }).assertStatus(422)
+    await (await http.actingAs(user).withCsrf()).post('/posts', { ...base, tags: 'x'.repeat(31) }).assertStatus(422)
+    expect((await Post.all()).length).toBe(0)
+    expect((await Tag.all()).length).toBe(0)
+    await (await http.actingAs(user).withCsrf()).post('/posts', { ...base, tags: 'x'.repeat(30) }).assertRedirect()
+  })
+})

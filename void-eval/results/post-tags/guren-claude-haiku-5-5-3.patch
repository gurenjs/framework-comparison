diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..f911659
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,140 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+const postFields = { title: 'Hello', excerpt: 'An excerpt', body: 'The body' }
+
+async function attachedTagNames(postId: number): Promise<string[]> {
+  const links = await PostTag.where({ postId }).get()
+  if (links.length === 0) {
+    return []
+  }
+  const tags = await Tag.where({ id: links.map((link) => link.tagId) }).get()
+  return tags.map((tag) => tag.name).sort()
+}
+
+async function inertiaProps(http: TestApp, path: string): Promise<Record<string, any>> {
+  const response = await http.withHeader('X-Inertia', 'true').get(path)
+  return (await response.json<{ props: Record<string, any> }>()).props
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let client: TestApp
+  let guest: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    const author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+    client = await http.actingAs(author).withCsrf()
+    guest = http
+  })
+
+  it('stores tags on create and shows them on the post page', async () => {
+    await client.post('/posts', { ...postFields, tags: 'bun, webdev' }).assertRedirect()
+
+    const post = (await Post.first({ title: 'Hello' }))!
+    expect(await attachedTagNames(post.id)).toEqual(['bun', 'webdev'])
+
+    const props = await inertiaProps(guest, `/posts/${post.id}`)
+    expect(props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('replaces tags on update and detaches removed names', async () => {
+    await client.post('/posts', { ...postFields, tags: 'bun, webdev' }).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+
+    await client.put(`/posts/${post.id}`, { ...postFields, tags: 'bun' }).assertRedirect()
+
+    expect(await attachedTagNames(post.id)).toEqual(['bun'])
+    const props = await inertiaProps(guest, `/posts/${post.id}`)
+    expect(props.post.tags).toEqual(['bun'])
+  })
+
+  it('filters the list by tag and reports untagged posts with an empty list', async () => {
+    await client.post('/posts', { ...postFields, title: 'Bun post', tags: 'bun' }).assertRedirect()
+    await client.post('/posts', { ...postFields, title: 'Other post', tags: 'webdev' }).assertRedirect()
+    await client.post('/posts', { ...postFields, title: 'Untagged', tags: '' }).assertRedirect()
+
+    const filtered = await inertiaProps(guest, '/posts?tag=bun')
+    expect(filtered.data.map((post: { title: string }) => post.title)).toEqual(['Bun post'])
+
+    const unused = await inertiaProps(guest, '/posts?tag=nobody-uses-this')
+    expect(unused.data).toEqual([])
+
+    const all = await inertiaProps(guest, '/posts')
+    const untagged = all.data.find((post: { title: string }) => post.title === 'Untagged')
+    expect(untagged.tags).toEqual([])
+  })
+
+  it('keeps the tag filter on page links', async () => {
+    for (let index = 0; index < 11; index++) {
+      await client.post('/posts', { ...postFields, title: `Bun ${index}`, tags: 'bun' }).assertRedirect()
+    }
+
+    const props = await inertiaProps(guest, '/posts?tag=bun')
+    const secondPage = props.pagination.links.pages.find((page: { page: number }) => page.page === 2)
+    expect(secondPage.url).toContain('tag=bun')
+    expect(props.data).toHaveLength(10)
+
+    const plain = await inertiaProps(guest, '/posts')
+    const plainSecond = plain.pagination.links.pages.find((page: { page: number }) => page.page === 2)
+    expect(plainSecond.url).not.toContain('tag=')
+    expect(plainSecond.url).not.toContain('?&')
+  })
+
+  it('shows the current tags on the edit form', async () => {
+    await client.post('/posts', { ...postFields, tags: 'bun, webdev' }).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+
+    const props = await inertiaProps(client, `/posts/${post.id}/edit`)
+    expect(props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('refuses more than five tags and writes nothing', async () => {
+    await client
+      .json()
+      .post('/posts', { ...postFields, tags: 'a,b,c,d,e,f' })
+      .assertUnprocessable()
+      .assertJsonPath('errors.tags.0', 'A post may have at most 5 tags.')
+
+    expect(await Post.all()).toEqual([])
+    expect(await Tag.all()).toEqual([])
+    expect(await PostTag.all()).toEqual([])
+  })
+
+  it('accepts a 30-character tag and refuses a 31-character one', async () => {
+    await client.json().post('/posts', { ...postFields, tags: 'x'.repeat(31) }).assertUnprocessable()
+    await client.post('/posts', { ...postFields, tags: 'x'.repeat(30) }).assertRedirect()
+
+    const post = (await Post.first({ title: 'Hello' }))!
+    expect(await attachedTagNames(post.id)).toEqual(['x'.repeat(30)])
+  })
+
+  it('trims and deduplicates tag names', async () => {
+    await client.post('/posts', { ...postFields, tags: ' bun ,bun' }).assertRedirect()
+
+    const post = (await Post.first({ title: 'Hello' }))!
+    expect(await attachedTagNames(post.id)).toEqual(['bun'])
+    expect(await PostTag.all()).toHaveLength(1)
+  })
+
+  it('deletes a tagged post', async () => {
+    await client.post('/posts', { ...postFields, tags: 'bun' }).assertRedirect()
+    const post = (await Post.first({ title: 'Hello' }))!
+
+    await client.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await PostTag.all()).toEqual([])
+  })
+})

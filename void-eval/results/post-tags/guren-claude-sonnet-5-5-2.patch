diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..87b1dce
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,65 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  const payload = (tags?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+  const tagNames = async () => (await Tag.all()).map((tag) => tag.name).sort()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-password' })
+  })
+
+  it('creates, shows, edits and filters tags', async () => {
+    const me = (await http.actingAs(author).withCsrf()).withHeader('X-Inertia', 'true')
+    await me.post('/posts', payload('bun, webdev')).assertRedirect()
+    const post = (await Post.all())[0]!
+
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: post.id }).get()).toHaveLength(2)
+    await me.get(`/posts/${post.id}`).assertJsonPath('props.post.tags', ['bun', 'webdev'])
+
+    await me.put(`/posts/${post.id}`, payload('bun')).assertRedirect()
+    expect(await PostTag.where({ postId: post.id }).get()).toHaveLength(1)
+    await me.get(`/posts/${post.id}`).assertJsonPath('props.post.tags', ['bun'])
+
+    const list = await (await me.get('/posts?tag=bun')).json<{ props: { data: { id: number }[] } }>()
+    expect(list.props.data.map((p) => p.id)).toEqual([post.id])
+    const none = await (await me.get('/posts?tag=nope')).json<{ props: { data: unknown[] } }>()
+    expect(none.props.data).toEqual([])
+
+    await me.delete(`/posts/${post.id}`).assertRedirect()
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+
+  it('refuses invalid tag lists without writing anything', async () => {
+    const me = (await http.actingAs(author).withCsrf()).withHeader('X-Inertia', 'true')
+    const refused = (await me.post('/posts', { ...payload(), title: '' })).status
+    await me.post('/posts', payload('a,b,c,d,e,f')).assertStatus(refused)
+    await me.post('/posts', payload('x'.repeat(31))).assertStatus(refused)
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+
+    await me.post('/posts', payload('x'.repeat(30))).assertRedirect()
+    expect(await Tag.all()).toHaveLength(1)
+  })
+
+  it('trims and de-duplicates names', async () => {
+    const me = (await http.actingAs(author).withCsrf()).withHeader('X-Inertia', 'true')
+    await me.post('/posts', payload(' bun ,bun,')).assertRedirect()
+    expect(await tagNames()).toEqual(['bun'])
+    expect(await PostTag.all()).toHaveLength(1)
+  })
+})

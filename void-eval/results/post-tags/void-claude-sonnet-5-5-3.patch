+/** Comma-separated tag names: trimmed, blanks dropped, duplicates collapsed, then 1–30 chars and at most 5. */
+export const tagsFieldSchema = z
+  .string()
+  .optional()
+  .transform((raw) => [...new Set((raw ?? "").split(",").map((t) => t.trim()).filter((t) => t.length > 0))])
+  .refine((names) => names.every((n) => n.length <= 30), "Each tag must be 30 characters or fewer.")
+  .refine((names) => names.length <= 5, "A post can have at most 5 tags.");

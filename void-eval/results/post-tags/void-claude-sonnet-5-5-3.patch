diff --git a/lib/tags.ts b/lib/tags.ts
new file mode 100644
index 0000000..d072985
--- /dev/null
+++ b/lib/tags.ts
@@ -0,0 +1,33 @@
+import { postTags, tags } from "@schema";
+import { db, eq, inArray } from "void/db";
+
+/** Adds a sorted `tags: string[]` to each post. */
+export async function withTags<T extends { id: number }>(rows: T[]): Promise<(T & { tags: string[] })[]> {
+  if (rows.length === 0) return [];
+  const found = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(
+      inArray(
+        postTags.postId,
+        rows.map((r) => r.id),
+      ),
+    );
+  const byPost = new Map<number, string[]>();
+  for (const { postId, name } of found) byPost.set(postId, [...(byPost.get(postId) ?? []), name]);
+  return rows.map((r) => ({ ...r, tags: (byPost.get(r.id) ?? []).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)) }));
+}
+
+/** Makes the post carry exactly `names`: creates unseen tags, attaches new ones, detaches removed ones. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+  if (names.length === 0) return;
+  for (const name of names) await db.insert(tags).values({ name }).onConflictDoNothing();
+  const rows = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names));
+  await db.insert(postTags).values(rows.map((t) => ({ postId, tagId: t.id })));
+}
+
+export async function deletePostTags(postId: number): Promise<void> {
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+}

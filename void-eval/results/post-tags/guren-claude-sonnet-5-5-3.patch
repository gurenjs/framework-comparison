diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..341fa81
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+const fields = { title: 'Hello', excerpt: 'Short', body: 'Long body' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'password123' })
+  })
+
+  async function store(tags: string | undefined) {
+    const csrf = await http.actingAs(author).withCsrf()
+    return csrf.json().post('/posts', { ...fields, tags })
+  }
+
+  it('creates, dedupes and attaches tags', async () => {
+    await store(' bun ,bun, webdev,')
+    expect((await Tag.all()).map((t) => t.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.all()).toHaveLength(2)
+  })
+
+  it('refuses six tags and 31-character names, writes nothing', async () => {
+    const six = await store('a,b,c,d,e,f')
+    six.assertUnprocessable()
+    const long = await store('x'.repeat(31))
+    long.assertUnprocessable()
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+    await store('x'.repeat(30))
+    expect(await Tag.all()).toHaveLength(1)
+  })
+
+  it('syncs on update and filters the list', async () => {
+    await store('bun, webdev')
+    const post = (await Post.all())[0]!
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, { ...fields, tags: 'bun' })
+    expect(await PostTag.all()).toHaveLength(1)
+    const inertia = http.withHeaders({ 'X-Inertia': 'true', 'X-Inertia-Version': '' })
+    const hit = await (await inertia.get('/posts?tag=bun')).json<{ props: { data: { tags: string[] }[] } }>()
+    expect(hit.props.data.map((p) => p.tags)).toEqual([['bun']])
+    const miss = await (await inertia.get('/posts?tag=nope')).json<{ props: { data: unknown[] } }>()
+    expect(miss.props.data).toEqual([])
+  })
+
+  it('deletes a tagged post', async () => {
+    await store('bun')
+    const post = (await Post.all())[0]!
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+})

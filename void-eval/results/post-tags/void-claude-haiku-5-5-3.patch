 import { z } from "zod";
 
+export const MAX_TAGS_PER_POST = 5;
+const TAG_MAX_LENGTH = 30;
+
+export function parseTagNames(raw: string | undefined): string[] {
+  const names = (raw ?? "").split(",").map((name) => name.trim()).filter((name) => name.length > 0);
+  return [...new Set(names)];
+}
+
+const tagNamesField = z
+  .string()
+  .optional()
+  .transform(parseTagNames)
+  .refine((names) => names.length <= MAX_TAGS_PER_POST, `A post may have at most ${MAX_TAGS_PER_POST} tags.`)
+  .refine(
+    (names) => names.every((name) => [...name].length <= TAG_MAX_LENGTH),
+    `Tags must be ${TAG_MAX_LENGTH} characters or fewer.`,
+  );
+
 export const postPayloadSchema = z.object({
   title: z.string().trim().min(1, "Title is required.").max(255, "Title must be 255 characters or fewer."),
   excerpt: z.string().trim().min(1, "Excerpt is required.").max(500, "Excerpt must be 500 characters or fewer."),
   body: z.string().trim().min(1, "Body is required."),
+  tags: tagNamesField,
 });
 

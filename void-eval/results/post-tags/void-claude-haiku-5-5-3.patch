diff --git a/lib/tags.ts b/lib/tags.ts
new file mode 100644
index 0000000..a5c715e
--- /dev/null
+++ b/lib/tags.ts
@@ -0,0 +1,28 @@
+import { postTags, tags } from "@schema";
+import { asc, db, eq, inArray } from "void/db";
+
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const namesByPost = new Map<number, string[]>();
+  if (postIds.length === 0) return namesByPost;
+  const rows = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+    .orderBy(asc(tags.name));
+  for (const row of rows) {
+    namesByPost.set(row.postId, [...(namesByPost.get(row.postId) ?? []), row.name]);
+  }
+  return namesByPost;
+}
+
+export async function replacePostTags(postId: number, names: string[]): Promise<void> {
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+  if (names.length === 0) return;
+  await db
+    .insert(tags)
+    .values(names.map((name) => ({ name })))
+    .onConflictDoNothing({ target: tags.name });
+  const rows = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names));
+  await db.insert(postTags).values(rows.map((row) => ({ postId, tagId: row.id })));
+}

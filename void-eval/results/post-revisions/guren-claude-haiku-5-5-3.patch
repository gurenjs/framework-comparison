+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostRevision } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const draft = (title: string) => ({ title, excerpt: `${title} excerpt`, body: `${title} body` })
+
+async function createUser(email: string): Promise<UserRecord> {
+  return (await User.create({ name: email, email, password: 'secret-password' })) as UserRecord
+}
+
+async function createPost(authorId: number, title: string) {
+  return Post.forceCreate({ ...draft(title), authorId })
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('keeps the previous version on each successful edit', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id, 'First')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.put(`/posts/${post.id}`, draft('Second')).assertRedirect(`/posts/${post.id}`)
+    await csrf.put(`/posts/${post.id}`, draft('Third')).assertRedirect(`/posts/${post.id}`)
+
+    const revisions = await PostRevision.where({ postId: post.id }).orderBy('id', 'desc').get()
+    expect(revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+  })
+
+  it('keeps nothing for a refused edit', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id, 'First')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'x' }).assertUnprocessable()
+
+    expect(await PostRevision.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('lists the revisions for the author, newest first', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id, 'First')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, draft('Second'))
+    await csrf.put(`/posts/${post.id}`, draft('Third'))
+
+    const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${post.id}/revisions`)
+    const page = await response.json<{ component: string; props: { revisions: { title: string }[] } }>()
+
+    expect(page.component).toBe('posts/Revisions')
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+  })
+
+  it('restores a revision and keeps the version it replaces', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id, 'First')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, draft('Second'))
+    await csrf.put(`/posts/${post.id}`, draft('Third'))
+
+    const first = await PostRevision.where({ postId: post.id, title: 'First' }).firstOrFail()
+    await csrf.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.body).toBe('First body')
+
+    const revisions = await PostRevision.where({ postId: post.id }).orderBy('id', 'desc').get()
+    expect(revisions.map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other users with 403 and guests with a login redirect', async () => {
+    const author = await createUser('author@example.com')
+    const other = await createUser('other@example.com')
+    const post = await createPost(author.id, 'First')
+    await PostRevision.create({ ...draft('Old') }, { set: { postId: post.id } })
+    const revision = await PostRevision.where({ postId: post.id }).firstOrFail()
+
+    await http.actingAs(other).get(`/posts/${post.id}/revisions`).assertForbidden()
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertForbidden()
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+  })
+
+  it('answers 404 for a revision that belongs to another post', async () => {
+    const author = await createUser('author@example.com')
+    const first = await createPost(author.id, 'First')
+    const second = await createPost(author.id, 'Second')
+    await PostRevision.create({ ...draft('Old') }, { set: { postId: second.id } })
+    const revision = await PostRevision.where({ postId: second.id }).firstOrFail()
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf.post(`/posts/${first.id}/revisions/${revision.id}/restore`).assertNotFound()
+    expect((await Post.findOrFail(first.id)).title).toBe('First')
+  })
+
+  it('deletes a post with its revisions and leaves other posts alone', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id, 'First')
+    const keep = await createPost(author.id, 'Keep')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, draft('Second'))
+    await csrf.put(`/posts/${keep.id}`, draft('Kept second'))
+
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await PostRevision.where({ postId: post.id }).count()).toBe(0)
+    expect(await PostRevision.where({ postId: keep.id }).count()).toBe(1)
+  })
+})

+import { postRevisions, posts } from "@schema";
+import { and, db, eq } from "void/db";
 import type { AuthUser } from "void/auth";
 import { users } from "./users";
 import { postIdSchema } from "./validators";
@@ -34,7 +34,26 @@ export async function findPostOrFail(id: number): Promise<PostWithAuthor> {
   return post;
 }
 
-/** Only a post's author may edit or delete it. */
+/** Only a post's author may edit, delete or see the revisions of a post. */
 export function authorizeAuthor(user: AuthUser, post: { authorId: string }): void {
   if (post.authorId !== user.id) throw new HTTPException(403, { message: "Forbidden" });
 }
+
+/** Keeps the post's current title, excerpt and body as a revision; run it with the write that replaces them. */
+export function keepRevision(post: PostWithAuthor) {
+  return db
+    .insert(postRevisions)
+    .values({ postId: post.id, title: post.title, excerpt: post.excerpt, body: post.body });
+}
+
+export async function findRevisionOrFail(postId: number, raw: string | undefined) {
+  const parsed = postIdSchema.safeParse(raw);
+  const [revision] = parsed.success
+    ? await db
+        .select()
+        .from(postRevisions)
+        .where(and(eq(postRevisions.id, parsed.data), eq(postRevisions.postId, postId)))
+    : [];
+  if (!revision) throw new HTTPException(404, { message: "Revision not found" });
+  return revision;
+}

@@ -0,0 +1,27 @@
+import { Link } from "@void/react";
+import type { Props } from "./revisions.server";
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <section>
+      <h1>Revisions of {post.title}</h1>
+      <p>
+        <Link href={`/posts/${post.id}`}>Back to post</Link>
+      </p>
+      {revisions.length === 0 ? (
+        <p>No earlier versions yet.</p>
+      ) : (
+        <ul>
+          {revisions.map((revision) => (
+            <li key={revision.id}>
+              {revision.title} <small>kept {new Date(revision.createdAt).toLocaleString()}</small>{" "}
+              <form method="post" action={`/posts/${post.id}/revisions/${revision.id}/restore`} style={{ display: "inline" }}>
+                <button type="submit">Restore</button>
+              </form>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
diff --git a/routes/posts/[id]/revisions/[revisionId]/restore.ts b/routes/posts/[id]/revisions/[revisionId]/restore.ts
new file mode 100644
index 0000000..6287cf0
--- /dev/null
+++ b/routes/posts/[id]/revisions/[revisionId]/restore.ts
@@ -0,0 +1,27 @@
+import { defineHandler } from "void";
+import { db, eq } from "void/db";
+import { posts } from "@schema";
+import {
+  authorizeAuthor,
+  findPostOrFail,
+  findRevisionOrFail,
+  keepRevision,
+  parsePostId,
+} from "../../../../../lib/posts";
+import { userOrRedirect } from "../../../../../lib/guards";
+
+export const POST = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const post = await findPostOrFail(parsePostId(c.req.param("id")));
+  authorizeAuthor(user, post);
+  const revision = await findRevisionOrFail(post.id, c.req.param("revisionId"));
+  await db.batch([
+    keepRevision(post),
+    db
+      .update(posts)
+      .set({ title: revision.title, excerpt: revision.excerpt, body: revision.body })
+      .where(eq(posts.id, post.id)),
+  ]);
+  return c.redirect(`/posts/${post.id}`);
+});

+
+  async function makeUser(email: string) {
+    return User.create({ name: email, email, password: 'secret' })
+  }
+
+  async function makePost(authorId: number, title: string) {
+    return Post.forceCreate({ title, excerpt: `${title} excerpt`, body: `${title} body`, authorId })
+  }
+
+  async function revisionTitles(postId: number): Promise<string[]> {
+    const rows = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+    return rows.map((row) => row.title)
+  }
+
+  it('keeps earlier versions and restores them', async () => {
+    const author = await makeUser('author@example.com')
+    const post = await makePost(author.id, 'First')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, { title: 'Second', excerpt: 'Second excerpt', body: 'Second body' }).assertRedirect()
+    await csrf.put(`/posts/${post.id}`, { title: 'Third', excerpt: 'Third excerpt', body: 'Third body' }).assertRedirect()
+
+    expect(await revisionTitles(post.id)).toEqual(['Second', 'First'])
+
+    const page = await csrf.withHeader('X-Inertia', 'true').get(`/posts/${post.id}/revisions`).assertOk()
+    const { component, props } = await page.json<{ component: string; props: { revisions: { title: string }[] } }>()
+    expect(component).toBe('posts/Revisions')
+    expect(props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+
+    const first = await PostRevision.first({ postId: post.id, title: 'First' })
+    await csrf.post(`/posts/${post.id}/revisions/${first!.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    const restored = await Post.findOrFail(post.id)
+    expect(restored.title).toBe('First')
+    expect(restored.excerpt).toBe('First excerpt')
+    expect(restored.body).toBe('First body')
+    expect(await revisionTitles(post.id)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('keeps nothing for a refused edit or a create', async () => {
+    const author = await makeUser('author@example.com')
+    const post = await makePost(author.id, 'First')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, { title: '', excerpt: 'x', body: 'x' }).assertUnprocessable()
+
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('refuses other signed-in users', async () => {
+    const author = await makeUser('author@example.com')
+    const other = await makeUser('other@example.com')
+    const post = await makePost(author.id, 'First')
+    const first = await PostRevision.forceCreate({ postId: post.id, title: 'Old', excerpt: 'o', body: 'o' })
+
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.get(`/posts/${post.id}/revisions`).assertForbidden()
+    await csrf.post(`/posts/${post.id}/revisions/${first.id}/restore`).assertForbidden()
+
+    expect(await revisionTitles(post.id)).toEqual(['Old'])
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+  })
+
+  it('redirects guests to login', async () => {
+    const author = await makeUser('author@example.com')
+    const post = await makePost(author.id, 'First')
+
+    await http.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+  })
+
+  it('404s when the revision belongs to another post', async () => {
+    const author = await makeUser('author@example.com')
+    const post = await makePost(author.id, 'First')
+    const otherPost = await makePost(author.id, 'Other')
+    const foreign = await PostRevision.forceCreate({ postId: otherPost.id, title: 'Foreign', excerpt: 'f', body: 'f' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${post.id}/revisions/${foreign.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+    expect(await revisionTitles(post.id)).toEqual([])
+  })
+
+  it('deletes a post with its revisions and leaves other posts alone', async () => {
+    const author = await makeUser('author@example.com')
+    const post = await makePost(author.id, 'First')
+    const keeper = await makePost(author.id, 'Keeper')
+    await PostRevision.forceCreate({ postId: post.id, title: 'Old', excerpt: 'o', body: 'o' })
+    await PostRevision.forceCreate({ postId: keeper.id, title: 'Kept', excerpt: 'k', body: 'k' })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await revisionTitles(post.id)).toEqual([])
+    expect(await revisionTitles(keeper.id)).toEqual(['Kept'])
+  })
+})

diff --git a/app/Models/PostRevision.ts b/app/Models/PostRevision.ts
new file mode 100644
index 0000000..04140cd
--- /dev/null
+++ b/app/Models/PostRevision.ts
@@ -0,0 +1,26 @@
+import { defineModel } from '@guren/core'
+import { postRevisions } from '../../db/schema.js'
+import { Post, type PostRecord } from './Post.js'
+
+export type PostRevisionRecord = typeof postRevisions.$inferSelect
+
+export type PostContent = Pick<PostRecord, 'title' | 'excerpt' | 'body'>
+
+export class PostRevision extends defineModel(postRevisions, {
+  // `postId` is chosen by the server, so it stays out of fillable.
+  fillable: ['title', 'excerpt', 'body'],
+}) {}
+
+// Keeps the post's current title, excerpt and body as a revision, then writes
+// `data` onto the post, both in one transaction.
+export async function replacePostContent(postId: number, data: PostContent): Promise<void> {
+  await Post.transaction(async (trx) => {
+    const current = await Post.inTransaction(trx).findOrFail(postId)
+
+    await PostRevision.inTransaction(trx).create(
+      { title: current.title, excerpt: current.excerpt, body: current.body },
+      { set: { postId } },
+    )
+    await Post.inTransaction(trx).update({ id: postId }, data)
+  })
+}

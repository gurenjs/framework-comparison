+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostRevision, type PostRevisionRecord } from '../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FIRST = { title: 'First', excerpt: 'First excerpt', body: 'First body' }
+
+let http: TestApp
+
+async function createUser(email: string): Promise<UserRecord> {
+  return User.create({ name: email, email, password: 'secret' })
+}
+
+async function createPost(authorId: number): Promise<PostRecord> {
+  return Post.forceCreate({ ...FIRST, authorId })
+}
+
+async function signedIn(user: UserRecord): Promise<TestApp> {
+  return (await http.actingAs(user).withCsrf()).json()
+}
+
+async function revisionsOf(postId: number): Promise<PostRevisionRecord[]> {
+  return PostRevision.where({ postId }).orderBy('id', 'desc').get()
+}
+
+async function revise(author: UserRecord, postId: number, title: string): Promise<void> {
+  await (await signedIn(author)).put(`/posts/${postId}`, { ...FIRST, title }).assertRedirect(`/posts/${postId}`)
+}
+
+describe('post revisions', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('keeps the previous version on each successful edit', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id)
+
+    await revise(author, post.id, 'Second')
+    await revise(author, post.id, 'Third')
+
+    expect((await revisionsOf(post.id)).map((revision) => revision.title)).toEqual(['Second', 'First'])
+  })
+
+  it('keeps nothing when the edit is refused', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id)
+
+    await (await signedIn(author)).put(`/posts/${post.id}`, { ...FIRST, title: '' }).assertUnprocessable()
+
+    expect(await revisionsOf(post.id)).toEqual([])
+  })
+
+  it('lists revisions newest first for the author', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id)
+    await revise(author, post.id, 'Second')
+    await revise(author, post.id, 'Third')
+
+    const response = await (await signedIn(author)).withHeader('X-Inertia', 'true').get(`/posts/${post.id}/revisions`)
+    const page = await response.json<{ component: string; props: { revisions: Array<{ id: number; title: string; createdAt: string }> } }>()
+
+    expect(page.component).toBe('posts/Revisions')
+    expect(page.props.revisions.map((revision) => revision.title)).toEqual(['Second', 'First'])
+    expect(page.props.revisions.map((revision) => revision.id)).toEqual((await revisionsOf(post.id)).map((revision) => revision.id))
+    expect(Number.isNaN(Date.parse(page.props.revisions[0].createdAt))).toBe(false)
+  })
+
+  it('restores a revision and keeps the version it replaced', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id)
+    await revise(author, post.id, 'Second')
+    await revise(author, post.id, 'Third')
+
+    const first = (await revisionsOf(post.id)).at(-1)!
+    await (await signedIn(author)).post(`/posts/${post.id}/revisions/${first.id}/restore`).assertRedirect(`/posts/${post.id}`)
+
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+    expect((await revisionsOf(post.id)).map((revision) => revision.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  it('refuses other signed-in users with 403 and changes nothing', async () => {
+    const author = await createUser('author@example.com')
+    const other = await createUser('other@example.com')
+    const post = await createPost(author.id)
+    await revise(author, post.id, 'Second')
+    const [revision] = await revisionsOf(post.id)
+
+    const stranger = await signedIn(other)
+    await stranger.get(`/posts/${post.id}/revisions`).assertForbidden()
+    await stranger.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertForbidden()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect((await revisionsOf(post.id)).map((item) => item.title)).toEqual(['First'])
+  })
+
+  it('redirects guests to login and changes nothing', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id)
+    await revise(author, post.id, 'Second')
+    const [revision] = await revisionsOf(post.id)
+
+    const guest = await http.withCsrf()
+    await guest.get(`/posts/${post.id}/revisions`).assertRedirect('/login')
+    await guest.post(`/posts/${post.id}/revisions/${revision.id}/restore`).assertRedirect('/login')
+
+    expect((await Post.findOrFail(post.id)).title).toBe('Second')
+    expect((await revisionsOf(post.id)).map((item) => item.title)).toEqual(['First'])
+  })
+
+  it('answers 404 for a revision that belongs to another post', async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id)
+    const otherPost = await createPost(author.id)
+    await revise(author, otherPost.id, 'Other')
+    const [otherRevision] = await revisionsOf(otherPost.id)
+
+    await (await signedIn(author)).post(`/posts/${post.id}/revisions/${otherRevision.id}/restore`).assertNotFound()
+
+    expect((await Post.findOrFail(post.id)).title).toBe('First')
+    expect((await revisionsOf(post.id))).toEqual([])
+  })
+
+  it("deletes a post's revisions with the post and leaves other posts alone", async () => {
+    const author = await createUser('author@example.com')
+    const post = await createPost(author.id)
+    const otherPost = await createPost(author.id)
+    await revise(author, post.id, 'Second')
+    await revise(author, otherPost.id, 'Other')
+
+    await (await signedIn(author)).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await revisionsOf(post.id)).toEqual([])
+    expect((await revisionsOf(otherPost.id)).map((revision) => revision.title)).toEqual(['First'])
+  })
+})

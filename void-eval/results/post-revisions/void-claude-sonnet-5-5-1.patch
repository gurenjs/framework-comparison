index 0000000..a20763a
--- /dev/null
+++ b/pages/posts/[id]/revisions.server.ts
@@ -0,0 +1,20 @@
+import { defineHandler, type InferProps } from "void";
+import { desc, db, eq } from "void/db";
+import { postRevisions } from "@schema";
+import { authorizeAuthor, findPostOrFail, parsePostId } from "../../../lib/posts";
+import { userOrRedirect } from "../../../lib/guards";
+
+export type Props = InferProps<typeof loader>;
+
+export const loader = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const post = await findPostOrFail(parsePostId(c.req.param("id")));
+  authorizeAuthor(user, post);
+  const revisions = await db
+    .select({ id: postRevisions.id, title: postRevisions.title, createdAt: postRevisions.createdAt })
+    .from(postRevisions)
+    .where(eq(postRevisions.postId, post.id))
+    .orderBy(desc(postRevisions.createdAt), desc(postRevisions.id));
+  return { post: { id: post.id, title: post.title }, revisions };
+});

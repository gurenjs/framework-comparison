@@ -0,0 +1,28 @@
+import { Link } from "@void/react";
+import type { Props } from "./revisions.server";
+
+export default function PostRevisions({ post, revisions }: Props) {
+  async function restore(revisionId: number) {
+    if (!confirm("Restore this revision?")) return;
+    await fetch(`/posts/${post.id}/revisions/${revisionId}/restore`, { method: "POST" });
+    window.location.href = `/posts/${post.id}`;
+  }
+
+  return (
+    <section>
+      <h1>Revisions of {post.title}</h1>
+      <p>
+        <Link href={`/posts/${post.id}`}>Back to post</Link>
+      </p>
+      {revisions.length === 0 && <p>No revisions yet.</p>}
+      <ul>
+        {revisions.map((revision) => (
+          <li key={revision.id}>
+            {revision.title} · <small>{new Date(revision.createdAt).toLocaleString()}</small>{" "}
+            <button type="button" onClick={() => restore(revision.id)}>Restore</button>
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
diff --git a/routes/posts/[id]/revisions/[revisionId]/restore.ts b/routes/posts/[id]/revisions/[revisionId]/restore.ts
new file mode 100644
index 0000000..dda3835
--- /dev/null
+++ b/routes/posts/[id]/revisions/[revisionId]/restore.ts
@@ -0,0 +1,30 @@
+import { HTTPException } from "hono/http-exception";
+import { defineHandler } from "void";
+import { and, db, eq } from "void/db";
+import { postRevisions } from "@schema";
+import { userOrRedirect } from "../../../../../lib/guards";
+import { authorizeAuthor, findPostOrFail, parsePostId, updatePostKeepingRevision } from "../../../../../lib/posts";
+
+export const POST = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const post = await findPostOrFail(parsePostId(c.req.param("id")));
+  authorizeAuthor(user, post);
+
+  const revisionId = Number(c.req.param("revisionId"));
+  if (!Number.isInteger(revisionId) || revisionId <= 0) {
+    throw new HTTPException(404, { message: "Revision not found" });
+  }
+  const [revision] = await db
+    .select()
+    .from(postRevisions)
+    .where(and(eq(postRevisions.id, revisionId), eq(postRevisions.postId, post.id)));
+  if (!revision) throw new HTTPException(404, { message: "Revision not found" });
+
+  await updatePostKeepingRevision(post, {
+    title: revision.title,
+    excerpt: revision.excerpt,
+    body: revision.body,
+  });
+  return c.redirect(`/posts/${post.id}`);
+});

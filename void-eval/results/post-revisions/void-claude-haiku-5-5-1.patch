@@ -0,0 +1,18 @@
+import { defineHandler } from "void";
+import { authorizeAuthor, findPostOrFail, parsePostId } from "../../../../../lib/posts";
+import { userOrRedirect } from "../../../../../lib/guards";
+import { findRevisionOrFail, parseRevisionId, replacePostContent } from "../../../../../lib/revisions";
+
+export const POST = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const post = await findPostOrFail(parsePostId(c.req.param("id")));
+  authorizeAuthor(user, post);
+  const revision = await findRevisionOrFail(post.id, parseRevisionId(c.req.param("revisionId")));
+  await replacePostContent(post, {
+    title: revision.title,
+    excerpt: revision.excerpt,
+    body: revision.body,
+  });
+  return c.redirect(`/posts/${post.id}`);
+});

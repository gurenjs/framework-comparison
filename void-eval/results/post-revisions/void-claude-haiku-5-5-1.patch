+import { Link } from "@void/react";
+import type { Props } from "./revisions.server";
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <section>
+      <h1>Revisions of {post.title}</h1>
+      <p>
+        <Link href={`/posts/${post.id}`}>Back to post</Link>
+      </p>
+      {revisions.length === 0 ? (
+        <p>No earlier versions yet.</p>
+      ) : (
+        <ul>
+          {revisions.map((revision) => (
+            <li key={revision.id}>
+              <span>{revision.title}</span>{" "}
+              <small>{new Date(revision.createdAt).toLocaleString()}</small>{" "}
+              <form method="post" action={`/posts/${post.id}/revisions/${revision.id}/restore`} style={{ display: "inline" }}>
+                <button type="submit">Restore</button>
+              </form>
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
diff --git a/routes/posts/[id]/revisions/[revisionId]/restore.ts b/routes/posts/[id]/revisions/[revisionId]/restore.ts

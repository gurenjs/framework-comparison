diff --git a/lib/revisions.ts b/lib/revisions.ts
new file mode 100644
index 0000000..390a462
--- /dev/null
+++ b/lib/revisions.ts
@@ -0,0 +1,44 @@
+import { HTTPException } from "hono/http-exception";
+import { postRevisions, posts } from "@schema";
+import { and, db, desc, eq } from "void/db";
+import type { PostWithAuthor } from "./posts";
+import { revisionIdSchema } from "./validators";
+
+export function parseRevisionId(raw: string | undefined): number {
+  const parsed = revisionIdSchema.safeParse(raw);
+  if (!parsed.success) throw new HTTPException(404, { message: "Revision not found" });
+  return parsed.data;
+}
+
+export function listRevisions(postId: number) {
+  return db
+    .select({ id: postRevisions.id, title: postRevisions.title, createdAt: postRevisions.createdAt })
+    .from(postRevisions)
+    .where(eq(postRevisions.postId, postId))
+    .orderBy(desc(postRevisions.id));
+}
+
+export async function findRevisionOrFail(postId: number, revisionId: number) {
+  const [revision] = await db
+    .select()
+    .from(postRevisions)
+    .where(and(eq(postRevisions.id, revisionId), eq(postRevisions.postId, postId)));
+  if (!revision) throw new HTTPException(404, { message: "Revision not found" });
+  return revision;
+}
+
+/** Keeps the post's current title, excerpt and body as a revision, then writes `next` to the post. */
+export function replacePostContent(
+  post: PostWithAuthor,
+  next: { title: string; excerpt: string; body: string },
+) {
+  return db.batch([
+    db.insert(postRevisions).values({
+      postId: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      body: post.body,
+    }),
+    db.update(posts).set(next).where(eq(posts.id, post.id)),
+  ]);
+}

+  fillable: ['body'],
+}) {
+  declare static relationTypes: { author: BelongsToRequiredRecord<CommentAuthorSummary> }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')

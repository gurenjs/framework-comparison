diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..a8f7a7b
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,104 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment, type CommentRecord } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+function pageComment(comment: CommentRecord, author: UserRecord) {
+  return {
+    id: comment.id,
+    body: comment.body,
+    author: { id: author.id, name: author.name },
+    createdAt: new Date(comment.createdAt).toISOString(),
+  }
+}
+
+describe('comments', () => {
+  let http: TestApp
+  let postAuthor: UserRecord
+  let commenter: UserRecord
+  let other: UserRecord
+  let post: { id: number }
+
+  const signedIn = async (user: UserRecord) => http.actingAs(user).withCsrf()
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    postAuthor = (await User.create({ name: 'Post Author', email: 'post@example.com', password: 'secret' }))!
+    commenter = (await User.create({ name: 'Commenter', email: 'commenter@example.com', password: 'secret' }))!
+    other = (await User.create({ name: 'Other', email: 'other@example.com', password: 'secret' }))!
+    post = await Post.create({ title: 'Hello', excerpt: 'Excerpt', body: 'Body' }, { set: { authorId: postAuthor.id } })
+  })
+
+  it('sends a guest to login and stores nothing', async () => {
+    const guest = await http.withCsrf()
+    await guest.post(`/posts/${post.id}/comments`, { body: 'Hi' }).assertRedirect('/login')
+
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('rejects a blank comment with a 422 and stores nothing', async () => {
+    const session = await signedIn(commenter)
+    await session.json().post(`/posts/${post.id}/comments`, { body: '   ' }).assertUnprocessable()
+
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('stores comments for the signed-in user and lists them oldest first', async () => {
+    const session = await signedIn(commenter)
+    await session.post(`/posts/${post.id}/comments`, { body: 'First' }).assertRedirect(`/posts/${post.id}`)
+    await session.post(`/posts/${post.id}/comments`, { body: 'Second' }).assertRedirect(`/posts/${post.id}`)
+
+    const [first, second] = await Comment.where({ postId: post.id }).orderBy('id', 'asc').get()
+    expect(first.userId).toBe(commenter.id)
+
+    await http.withHeader('X-Inertia', 'true').get(`/posts/${post.id}`).assertInertia('posts/Show', {
+      comments: [pageComment(first, commenter), pageComment(second, commenter)],
+    })
+  })
+
+  it('lets the comment author and the post author delete, and no one else', async () => {
+    const byCommenter = await Comment.create({ body: 'Mine' }, { set: { postId: post.id, userId: commenter.id } })
+    const byOther = await Comment.create({ body: 'Theirs' }, { set: { postId: post.id, userId: other.id } })
+
+    await (await signedIn(commenter)).delete(`/comments/${byCommenter.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(byCommenter.id)).toBeNull()
+
+    const stranger = (await User.create({ name: 'Stranger', email: 'stranger@example.com', password: 'secret' }))!
+    await (await signedIn(stranger)).delete(`/comments/${byOther.id}`).assertForbidden()
+    expect(await Comment.find(byOther.id)).not.toBeNull()
+
+    await (await signedIn(postAuthor)).delete(`/comments/${byOther.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(byOther.id)).toBeNull()
+  })
+
+  it('counts each reporter once and hides a comment after three reporters', async () => {
+    const comment = await Comment.create({ body: 'Spam' }, { set: { postId: post.id, userId: commenter.id } })
+
+    for (const reporter of [postAuthor, other, commenter]) {
+      await (await signedIn(reporter)).post(`/comments/${comment.id}/report`).assertNoContent()
+    }
+    await (await signedIn(other)).post(`/comments/${comment.id}/report`).assertNoContent()
+
+    expect(await CommentReport.where({ commentId: comment.id }).get()).toHaveLength(3)
+    expect(await Comment.find(comment.id)).not.toBeNull()
+    await http.withHeader('X-Inertia', 'true').get(`/posts/${post.id}`).assertInertia('posts/Show', { comments: [] })
+  })
+
+  it('removes a post\'s comments and their reports when the post is deleted', async () => {
+    const comment = await Comment.create({ body: 'Bye' }, { set: { postId: post.id, userId: commenter.id } })
+    await (await signedIn(other)).post(`/comments/${comment.id}/report`).assertNoContent()
+
+    await (await signedIn(postAuthor)).delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Comment.where({ postId: post.id }).get()).toHaveLength(0)
+    expect(await CommentReport.where({ commentId: comment.id }).get()).toHaveLength(0)
+  })
+})

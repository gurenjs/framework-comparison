diff --git a/lib/comments.ts b/lib/comments.ts
new file mode 100644
index 0000000..bdd8fe6
--- /dev/null
+++ b/lib/comments.ts
@@ -0,0 +1,42 @@
+import { HTTPException } from "hono/http-exception";
+import { commentReports, comments, posts } from "@schema";
+import { asc, db, eq, sql } from "void/db";
+import { users } from "./users";
+import { postIdSchema } from "./validators";
+
+/** Reports from this many different users hide a comment from the post page. */
+export const HIDE_THRESHOLD = 3;
+
+export async function listVisibleComments(postId: number) {
+  const rows = await db
+    .select({
+      id: comments.id,
+      body: comments.body,
+      createdAt: comments.createdAt,
+      author: { id: users.id, name: users.name },
+    })
+    .from(comments)
+    .innerJoin(users, eq(users.id, comments.userId))
+    .where(
+      sql`${comments.postId} = ${postId} and (select count(distinct ${commentReports.userId}) from ${commentReports} where ${commentReports.commentId} = ${comments.id}) < ${HIDE_THRESHOLD}`,
+    )
+    .orderBy(asc(comments.createdAt), asc(comments.id));
+  return rows.map((row) => ({ ...row, createdAt: new Date(row.createdAt).toISOString() }));
+}
+
+export async function findCommentOrFail(raw: string | undefined) {
+  const parsed = postIdSchema.safeParse(raw);
+  if (!parsed.success) throw new HTTPException(404, { message: "Comment not found" });
+  const [comment] = await db
+    .select({
+      id: comments.id,
+      userId: comments.userId,
+      postId: comments.postId,
+      postAuthorId: posts.authorId,
+    })
+    .from(comments)
+    .innerJoin(posts, eq(posts.id, comments.postId))
+    .where(eq(comments.id, parsed.data));
+  if (!comment) throw new HTTPException(404, { message: "Comment not found" });
+  return comment;
+}

--- /dev/null
+++ b/routes/comments/[id]/report.ts
@@ -0,0 +1,13 @@
+import { defineHandler } from "void";
+import { commentReports } from "@schema";
+import { db } from "void/db";
+import { findCommentOrFail } from "../../../lib/comments";
+import { userOrRedirect } from "../../../lib/guards";
+
+export const POST = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const comment = await findCommentOrFail(c.req.param("id"));
+  await db.insert(commentReports).values({ commentId: comment.id, userId: user.id }).onConflictDoNothing();
+  return c.body(null, 204);
+});

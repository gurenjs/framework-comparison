@@ -0,0 +1,20 @@
+import { HTTPException } from "hono/http-exception";
+import { defineHandler } from "void";
+import { commentReports, comments } from "@schema";
+import { db, eq } from "void/db";
+import { findCommentOrFail, parseCommentId } from "../../lib/comments";
+import { userOrRedirect } from "../../lib/guards";
+
+export const DELETE = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const comment = await findCommentOrFail(parseCommentId(c.req.param("id")));
+  if (user.id !== comment.userId && user.id !== comment.postAuthorId) {
+    throw new HTTPException(403, { message: "Forbidden" });
+  }
+  await db.batch([
+    db.delete(commentReports).where(eq(commentReports.commentId, comment.id)),
+    db.delete(comments).where(eq(comments.id, comment.id)),
+  ]);
+  return c.redirect(`/posts/${comment.postId}`);
+});

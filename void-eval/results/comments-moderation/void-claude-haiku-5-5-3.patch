@@ -27,7 +30,22 @@ export const actions = {
     const user = requireAuth(c);
     const post = await findPostOrFail(parsePostId(c.req.param("id")));
     authorizeAuthor(user, post);
-    await db.delete(posts).where(eq(posts.id, post.id));
+    const postComments = db.select({ id: comments.id }).from(comments).where(eq(comments.postId, post.id));
+    await db.batch([
+      db.delete(commentReports).where(inArray(commentReports.commentId, postComments)),
+      db.delete(comments).where(eq(comments.postId, post.id)),
+      db.delete(posts).where(eq(posts.id, post.id)),
+    ]);
     return c.redirect("/posts");
   }),
+
+  comment: defineHandler.withValidator({
+    body: commentPayloadSchema,
+  })(async (c, { body }) => {
+    const user = userOrRedirect(c);

@@ -38,3 +38,12 @@ export async function findPostOrFail(id: number): Promise<PostWithAuthor> {
 export function authorizeAuthor(user: AuthUser, post: { authorId: string }): void {
   if (post.authorId !== user.id) throw new HTTPException(403, { message: "Forbidden" });
 }
+
+export async function deletePost(postId: number): Promise<void> {
+  const postComments = db.select({ id: comments.id }).from(comments).where(eq(comments.postId, postId));

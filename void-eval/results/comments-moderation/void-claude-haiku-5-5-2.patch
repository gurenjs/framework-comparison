diff --git a/lib/comments.ts b/lib/comments.ts
new file mode 100644
index 0000000..49c37e7
--- /dev/null
+++ b/lib/comments.ts
@@ -0,0 +1,73 @@
+import { HTTPException } from "hono/http-exception";
+import { commentReports, comments, posts } from "@schema";
+import { and, asc, db, eq, notInArray, sql } from "void/db";
+import type { AuthUser } from "void/auth";
+import { users } from "./users";
+import { commentIdSchema } from "./validators";
+
+/** A comment with this many distinct reports is hidden from everyone. */
+export const HIDE_AFTER_REPORTS = 3;
+
+/** Comments on a post that have not reached the report threshold, oldest first. */
+export function listVisibleComments(postId: number) {
+  const hidden = db
+    .select({ id: commentReports.commentId })
+    .from(commentReports)
+    .groupBy(commentReports.commentId)
+    .having(sql`count(*) >= ${HIDE_AFTER_REPORTS}`);
+
+  return db
+    .select({
+      id: comments.id,
+      body: comments.body,
+      createdAt: comments.createdAt,
+      author: { id: users.id, name: users.name },
+    })
+    .from(comments)
+    .innerJoin(users, eq(users.id, comments.userId))
+    .where(and(eq(comments.postId, postId), notInArray(comments.id, hidden)))
+    .orderBy(asc(comments.createdAt), asc(comments.id));
+}
+
+/** Parses the `[id]` route param of a comment; anything that is not a positive integer is a 404. */
+export function parseCommentId(raw: string | undefined): number {
+  const parsed = commentIdSchema.safeParse(raw);
+  if (!parsed.success) throw new HTTPException(404, { message: "Comment not found" });
+  return parsed.data;
+}
+
+export async function findCommentOrFail(id: number) {
+  const [comment] = await db
+    .select({
+      id: comments.id,
+      postId: comments.postId,
+      userId: comments.userId,
+      postAuthorId: posts.authorId,
+    })
+    .from(comments)
+    .innerJoin(posts, eq(posts.id, comments.postId))
+    .where(eq(comments.id, id));
+  if (!comment) throw new HTTPException(404, { message: "Comment not found" });
+  return comment;
+}
+
+/** Only the comment's author or the post's author may delete it. */
+export function authorizeCommentDeletion(
+  user: AuthUser,
+  comment: { userId: string; postAuthorId: string },
+): void {
+  if (user.id !== comment.userId && user.id !== comment.postAuthorId) {
+    throw new HTTPException(403, { message: "Forbidden" });
+  }
+}
+
+export async function reportComment(commentId: number, userId: string): Promise<void> {
+  await db.insert(commentReports).values({ commentId, userId }).onConflictDoNothing();
+}
+
+export async function deleteComment(commentId: number): Promise<void> {
+  await db.batch([
+    db.delete(commentReports).where(eq(commentReports.commentId, commentId)),
+    db.delete(comments).where(eq(comments.id, commentId)),
+  ]);
+}

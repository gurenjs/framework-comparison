diff --git a/app/Models/Comment.ts b/app/Models/Comment.ts
new file mode 100644
index 0000000..41e64d5
--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,39 @@
+import { defineModel, type BelongsToRecord } from '@guren/core'
+import { comments } from '../../db/schema.js'
+import type { PostAuthorSummary } from './Post.js'
+import { CommentReport } from './CommentReport.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+
+// Comments with this many distinct reporters are hidden from the post page; the row stays for review.
+export const HIDDEN_AFTER_REPORTS = 3
+
+export class Comment extends defineModel(comments, {
+  // `postId` and `userId` are chosen by the server, never from request input.
+  fillable: ['body'],
+}) {
+  static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
+    author: null,
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
+
+export async function visibleCommentsFor(postId: number) {
+  const rows = await Comment.newQuery()
+    .with('author')
+    .where({ postId })
+    .orderBy('id', 'asc')
+    .get()
+  if (rows.length === 0) {
+    return rows
+  }
+
+  const reports = await CommentReport.where({ commentId: rows.map((row) => row.id) }).get()
+  const reportCounts = new Map<number, number>()
+  for (const report of reports) {
+    reportCounts.set(report.commentId, (reportCounts.get(report.commentId) ?? 0) + 1)
+  }
+
+  return rows.filter((row) => (reportCounts.get(row.id) ?? 0) < HIDDEN_AFTER_REPORTS)
+}

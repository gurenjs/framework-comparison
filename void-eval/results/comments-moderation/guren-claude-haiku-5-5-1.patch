+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+  postAuthorId: number
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts. The
+ * caller passes the comment's author and the post's author, since the
+ * post's author is not stored on the comment.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike): boolean {
+    return user !== null && (Number(user.id) === comment.userId || Number(user.id) === comment.postAuthorId)
+  }
+}

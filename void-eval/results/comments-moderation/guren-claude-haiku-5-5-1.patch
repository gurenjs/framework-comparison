diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..b895ca0
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,108 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+  let author: UserRecord
+  let reader: UserRecord
+  let other: UserRecord
+  let post: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret' })
+    reader = await User.create({ name: 'Reader', email: 'reader@example.com', password: 'secret' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret' })
+    post = await Post.create(
+      { title: 'Post', excerpt: 'Excerpt', body: 'Body' },
+      { set: { authorId: author.id } },
+    )
+  })
+
+  it('sends a guest who comments to the login page', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'Hi' }).assertRedirect('/login')
+    expect(await Comment.where({ postId: post.id }).get()).toHaveLength(0)
+  })
+
+  it('stores a comment for a signed-in user and lists it on the post', async () => {
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: '  Nice post  ' }).assertRedirect(`/posts/${post.id}`)
+
+    const stored = await Comment.where({ postId: post.id }).get()
+    expect(stored).toHaveLength(1)
+    expect(stored[0].userId).toBe(reader.id)
+    expect(stored[0].body).toBe('Nice post')
+
+    const page = await http.actingAs(other).get(`/posts/${post.id}`)
+    expect(page.status).toBe(200)
+    expect(await page.text()).toContain('Nice post')
+  })
+
+  it('rejects an empty comment and stores nothing', async () => {
+    const csrf = await http.actingAs(reader).withCsrf()
+    await csrf.json().post(`/posts/${post.id}/comments`, { body: '   ' }).assertUnprocessable()
+    expect(await Comment.where({ postId: post.id }).get()).toHaveLength(0)
+  })
+
+  it('lets only the comment author or the post author delete a comment', async () => {
+    const comment = await Comment.create({ body: 'Mine' }, { set: { postId: post.id, userId: reader.id } })
+
+    const stranger = await http.actingAs(other).withCsrf()
+    await stranger.delete(`/comments/${comment.id}`).assertForbidden()
+    expect(await Comment.find(comment.id)).not.toBeNull()
+
+    const commenter = await http.actingAs(reader).withCsrf()
+    await commenter.delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(comment.id)).toBeNull()
+
+    const second = await Comment.create({ body: 'Theirs' }, { set: { postId: post.id, userId: reader.id } })
+    const postAuthor = await http.actingAs(author).withCsrf()
+    await postAuthor.delete(`/comments/${second.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.find(second.id)).toBeNull()
+  })
+
+  it('answers 204 to a repeated report and counts it once', async () => {
+    const comment = await Comment.create({ body: 'Spam' }, { set: { postId: post.id, userId: reader.id } })
+
+    const csrf = await http.actingAs(other).withCsrf()
+    await csrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    await csrf.post(`/comments/${comment.id}/report`).assertNoContent()
+
+    expect(await CommentReport.where({ commentId: comment.id }).get()).toHaveLength(1)
+  })
+
+  it('hides a comment from the post page after three different reporters', async () => {
+    const comment = await Comment.create({ body: 'Bad' }, { set: { postId: post.id, userId: reader.id } })
+    const reporters = [author, other, reader]
+
+    for (const reporter of reporters) {
+      const csrf = await http.actingAs(reporter).withCsrf()
+      await csrf.post(`/comments/${comment.id}/report`).assertNoContent()
+    }
+
+    expect(await Comment.find(comment.id)).not.toBeNull()
+    const page = await http.get(`/posts/${post.id}`)
+    expect(page.status).toBe(200)
+    expect(await page.text()).not.toContain('Bad')
+  })
+
+  it('removes a post\'s comments when the post is deleted', async () => {
+    await Comment.create({ body: 'One' }, { set: { postId: post.id, userId: reader.id } })
+    await Comment.create({ body: 'Two' }, { set: { postId: post.id, userId: other.id } })
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where({ postId: post.id }).get()).toHaveLength(0)
+  })
+})

diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..2abe560
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,73 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function makeUser(name: string) {
+    return User.create({ name, email: `${name}@example.com`, password: 'password123' })
+  }
+
+  async function as(user: Awaited<ReturnType<typeof makeUser>>) {
+    return http.actingAs(user as never).withCsrf()
+  }
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const author = await makeUser('author')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: author.id })
+    const csrf = await http.withCsrf()
+
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('stores, deletes, reports and hides', async () => {
+    const author = await makeUser('author')
+    const reader = await makeUser('reader')
+    const other = await makeUser('other')
+    const third = await makeUser('third')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: author.id })
+
+    await (await as(reader)).json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await (await as(reader)).post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect(`/posts/${post.id}`)
+    const [comment] = await Comment.all()
+
+    await (await as(other)).delete(`/comments/${comment.id}`).assertForbidden()
+    expect(await Comment.all()).toHaveLength(1)
+
+    for (const user of [reader, other]) {
+      await (await as(user)).post(`/comments/${comment.id}/report`).assertNoContent()
+      await (await as(user)).post(`/comments/${comment.id}/report`).assertNoContent()
+    }
+    expect(await CommentReport.all()).toHaveLength(2)
+    await (await as(third)).post(`/comments/${comment.id}/report`).assertNoContent()
+
+    await (await as(author)).withHeader('X-Inertia', 'true').get(`/posts/${post.id}`).assertInertia('posts/Show', { comments: [] })
+    expect(await Comment.all()).toHaveLength(1)
+
+    await (await as(author)).delete(`/comments/${comment.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+
+  it('removes comments with their post', async () => {
+    const author = await makeUser('author')
+    const post = await Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId: author.id })
+    await (await as(author)).post(`/posts/${post.id}/comments`, { body: 'hi' })
+    await (await as(author)).delete(`/posts/${post.id}`)
+    expect(await Comment.all()).toHaveLength(0)
+  })
+})

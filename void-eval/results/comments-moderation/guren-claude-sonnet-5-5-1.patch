diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..d9ff3f9
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,95 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+let seq = 0
+async function makeUser() {
+  seq += 1
+  return User.create({ name: `Reader ${seq}`, email: `reader${seq}-${Date.now()}@example.com`, password: 'secret-pass-1' })
+}
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  async function as(user: Awaited<ReturnType<typeof makeUser>>) {
+    return http.actingAs(user as never).withCsrf()
+  }
+
+  async function makePost(authorId: number) {
+    return Post.forceCreate({ title: 't', excerpt: 'e', body: 'b', authorId })
+  }
+
+  it('sends a guest to the login page and stores nothing', async () => {
+    const author = await makeUser()
+    const post = await makePost(author.id)
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${post.id}/comments`, { body: 'hi' }).assertRedirect('/login')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('stores a valid comment and rejects an invalid one', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const post = await makePost(author.id)
+    const client = await as(reader)
+    await client.post(`/posts/${post.id}/comments`, { body: 'hello' }).assertRedirect(`/posts/${post.id}`)
+    await client.json().post(`/posts/${post.id}/comments`, { body: '' }).assertUnprocessable()
+    await client.json().post(`/posts/${post.id}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+    const rows = await Comment.where({ postId: post.id }).get()
+    expect(rows).toHaveLength(1)
+    expect(rows[0]?.userId).toBe(reader.id)
+  })
+
+  it('lets the comment author and the post author delete, and nobody else', async () => {
+    const author = await makeUser()
+    const reader = await makeUser()
+    const other = await makeUser()
+    const post = await makePost(author.id)
+    const a = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'a' })
+    const b = await Comment.forceCreate({ postId: post.id, userId: reader.id, body: 'b' })
+
+    await (await as(other)).delete(`/comments/${a.id}`).assertForbidden()
+    expect(await Comment.find(a.id)).not.toBeNull()
+
+    await (await as(reader)).delete(`/comments/${a.id}`).assertRedirect(`/posts/${post.id}`)
+    await (await as(author)).delete(`/comments/${b.id}`).assertRedirect(`/posts/${post.id}`)
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+
+  it('counts each reporter once and hides at three distinct reporters', async () => {
+    const author = await makeUser()
+    const post = await makePost(author.id)
+    const comment = await Comment.forceCreate({ postId: post.id, userId: author.id, body: 'spam' })
+    const reporters = [await makeUser(), await makeUser(), await makeUser()]
+
+    const first = await as(reporters[0]!)
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await (await as(reporters[1]!)).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.where({ commentId: comment.id }).count()).toBe(2)
+
+    const shown = await (await as(author)).withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${post.id}`)
+    expect(((await shown.json<{ props: { comments: unknown[] } }>()).props.comments)).toHaveLength(1)
+
+    await (await as(reporters[2]!)).post(`/comments/${comment.id}/report`).assertNoContent()
+    const hidden = await (await as(author)).withHeaders({ 'X-Inertia': 'true' }).get(`/posts/${post.id}`)
+    expect(((await hidden.json<{ props: { comments: unknown[] } }>()).props.comments)).toHaveLength(0)
+    expect(await Comment.find(comment.id)).not.toBeNull()
+  })
+
+  it('removes comments with their post', async () => {
+    const author = await makeUser()
+    const post = await makePost(author.id)
+    await Comment.forceCreate({ postId: post.id, userId: author.id, body: 'x' })
+    await (await as(author)).delete(`/posts/${post.id}`).assertRedirect('/posts')
+    expect(await Comment.where({ postId: post.id }).count()).toBe(0)
+  })
+})

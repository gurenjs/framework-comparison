new file mode 100644
index 0000000..2f2a65d
--- /dev/null
+++ b/routes/api/posts.ts
@@ -0,0 +1,34 @@
+import { defineHandler } from "void";
+import { count, db, desc, eq } from "void/db";
+import { z } from "zod";
+import { posts } from "@schema";
+import { selectPosts } from "../../lib/posts";
+import { paginationMeta } from "../../lib/pagination";
+
+const PER_PAGE = 10;
+
+// Query values arrive as strings; `page` must be a positive integer.
+const apiPostsQuerySchema = z.object({
+  page: z
+    .string()
+    .regex(/^[1-9]\d{0,8}$/, "page must be a positive integer")
+    .transform(Number)
+    .optional(),
+  author: z.string().min(1).optional(),
+});
+
+export const GET = defineHandler.withValidator({
+  query: apiPostsQuerySchema,
+})(async (_c, { query }) => {
+  const page = query.page ?? 1;
+  const filter = query.author ? eq(posts.authorId, query.author) : undefined;
+
+  const [{ total }] = await db.select({ total: count() }).from(posts).where(filter);
+  const data = await selectPosts()
+    .where(filter)
+    .orderBy(desc(posts.id))
+    .limit(PER_PAGE)
+    .offset((page - 1) * PER_PAGE);
+
+  return { data, meta: paginationMeta(page, PER_PAGE, total, data.length) };
+});

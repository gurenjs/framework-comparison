--- /dev/null
+++ b/routes/api/posts.ts
@@ -0,0 +1,34 @@
+import { defineHandler } from "void";
+import { posts } from "@schema";
+import { db, desc } from "void/db";
+import { authenticateToken } from "../../lib/tokens";
+import { postPayloadSchema } from "../../lib/validators";
+
+const publicColumns = {
+  id: posts.id,
+  title: posts.title,
+  excerpt: posts.excerpt,
+  authorId: posts.authorId,
+  createdAt: posts.createdAt,
+};
+
+export const GET = defineHandler(async (c) => {
+  const auth = await authenticateToken(c);
+  if (auth instanceof Response) return auth;
+  const data = await db.select(publicColumns).from(posts).orderBy(desc(posts.createdAt), desc(posts.id));
+  return c.json({ data });
+});
+
+export const POST = defineHandler(async (c) => {
+  const auth = await authenticateToken(c);
+  if (auth instanceof Response) return auth;
+  const body = await c.req.json().catch(() => null);
+  const parsed = postPayloadSchema.safeParse(body);
+  if (!parsed.success) return c.json({ error: "Validation failed", issues: parsed.error.issues }, 422);
+
+  const [post] = await db
+    .insert(posts)
+    .values({ ...parsed.data, authorId: auth.userId })
+    .returning(publicColumns);
+  return c.json({ data: post }, 201);
+});
diff --git a/routes/profile/tokens.ts b/routes/profile/tokens.ts
new file mode 100644
index 0000000..9cb4b06
--- /dev/null
+++ b/routes/profile/tokens.ts
@@ -0,0 +1,20 @@
+import { defineHandler } from "void";
+import { requireAuth } from "void/auth";
+import { apiTokens } from "@schema";
+import { db } from "void/db";
+import { generateToken, hashToken } from "../../lib/tokens";
+import { tokenPayloadSchema } from "../../lib/validators";
+
+export const POST = defineHandler(async (c) => {
+  const user = requireAuth(c);
+  const body = await c.req.json().catch(() => null);
+  const parsed = tokenPayloadSchema.safeParse(body);
+  if (!parsed.success) return c.json({ error: "Invalid token name", issues: parsed.error.issues }, 422);
+
+  const token = generateToken();
+  const [row] = await db
+    .insert(apiTokens)
+    .values({ userId: user.id, name: parsed.data.name, tokenHash: await hashToken(token) })
+    .returning({ id: apiTokens.id, name: apiTokens.name });
+  return c.json({ id: row.id, name: row.name, token }, 201, { "Cache-Control": "no-store" });
+});
diff --git a/routes/profile/tokens/[id].ts b/routes/profile/tokens/[id].ts
new file mode 100644
index 0000000..5910bc0
--- /dev/null
+++ b/routes/profile/tokens/[id].ts
@@ -0,0 +1,17 @@
+import { defineHandler } from "void";
+import { requireAuth } from "void/auth";
+import { apiTokens } from "@schema";
+import { and, db, eq } from "void/db";
+
+export const DELETE = defineHandler(async (c) => {
+  const user = requireAuth(c);
+  const id = Number(c.req.param("id"));
+  if (!Number.isSafeInteger(id) || id <= 0) return c.json({ error: "Token not found" }, 404);
+
+  const deleted = await db
+    .delete(apiTokens)
+    .where(and(eq(apiTokens.id, id), eq(apiTokens.userId, user.id)))
+    .returning({ id: apiTokens.id });
+  if (deleted.length === 0) return c.json({ error: "Token not found" }, 404);
+  return c.body(null, 204);
+});

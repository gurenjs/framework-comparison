diff --git a/lib/tokens.ts b/lib/tokens.ts
new file mode 100644
index 0000000..6d09123
--- /dev/null
+++ b/lib/tokens.ts
@@ -0,0 +1,56 @@
+import type { Context } from "hono";
+import { apiTokens } from "@schema";
+import { db, eq, sql } from "void/db";
+
+export const RATE_LIMIT = 60;
+const WINDOW_SECONDS = 60;
+
+export async function hashToken(token: string): Promise<string> {
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(token));
+  return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+/** A fresh random token: 32 random bytes, base64url encoded. */
+export function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32));
+  return btoa(String.fromCharCode(...bytes))
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+}
+
+/**
+ * Authenticates a bearer request and counts it against the token's rate limit.
+ * Returns the token owner's id, or a JSON 401/429 response.
+ */
+export async function authenticateToken(c: Context): Promise<{ userId: string } | Response> {
+  const header = c.req.header("authorization") ?? "";
+  const match = /^Bearer ([A-Za-z0-9_-]{16,256})$/.exec(header);
+  const unauthorized = () => c.json({ error: "Unauthorized" }, 401, { "WWW-Authenticate": "Bearer" });
+  if (!match) return unauthorized();
+
+  const [row] = await db
+    .select({ id: apiTokens.id, userId: apiTokens.userId })
+    .from(apiTokens)
+    .where(eq(apiTokens.tokenHash, await hashToken(match[1])));
+  if (!row) return unauthorized();
+
+  const nowSeconds = Math.floor(Date.now() / 1000);
+  const minute = Math.floor(nowSeconds / WINDOW_SECONDS);
+  // Single atomic statement: SQLite evaluates every right-hand side against the old row.
+  const [counter] = await db
+    .update(apiTokens)
+    .set({
+      hits: sql`CASE WHEN ${apiTokens.windowStart} = ${minute} THEN ${apiTokens.hits} + 1 ELSE 1 END`,
+      windowStart: minute,
+    })
+    .where(eq(apiTokens.id, row.id))
+    .returning({ hits: apiTokens.hits });
+  if (!counter) return unauthorized(); // revoked in between
+
+  if (counter.hits > RATE_LIMIT) {
+    const retryAfter = Math.min(WINDOW_SECONDS, Math.max(1, (minute + 1) * WINDOW_SECONDS - nowSeconds));
+    return c.json({ error: "Too many requests" }, 429, { "Retry-After": String(retryAfter) });
+  }
+  return { userId: row.userId };
+}

diff --git a/lib/api-tokens.ts b/lib/api-tokens.ts
new file mode 100644
index 0000000..2efe162
--- /dev/null
+++ b/lib/api-tokens.ts
@@ -0,0 +1,46 @@
+import type { Context } from "hono";
+import { apiTokens } from "@schema";
+import { db, eq, sql } from "void/db";
+
+const RATE_LIMIT_PER_MINUTE = 60;
+const WINDOW_MS = 60_000;
+
+function toHex(bytes: ArrayBuffer | Uint8Array): string {
+  return Array.from(new Uint8Array(bytes), (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+async function sha256Hex(value: string): Promise<string> {
+  return toHex(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value)));
+}
+
+export async function createApiToken(userId: string, name: string) {
+  const token = toHex(crypto.getRandomValues(new Uint8Array(32)));
+  const [row] = await db
+    .insert(apiTokens)
+    .values({ userId, name, tokenHash: await sha256Hex(token) })
+    .returning({ id: apiTokens.id, name: apiTokens.name });
+  return { id: row.id, name: row.name, token };
+}
+
+/** Returns the token owner's id, or a JSON 401/429 response to send back. */
+export async function authenticateApiRequest(c: Context): Promise<{ userId: string } | Response> {
+  const match = /^Bearer\s+(\S+)$/i.exec(c.req.header("Authorization") ?? "");
+  if (!match) return c.json({ error: "Unauthorized" }, 401);
+
+  const window = Math.floor(Date.now() / WINDOW_MS);
+  const [row] = await db
+    .update(apiTokens)
+    .set({
+      rateWindow: window,
+      rateCount: sql`CASE WHEN ${apiTokens.rateWindow} = ${window} THEN ${apiTokens.rateCount} + 1 ELSE 1 END`,
+    })
+    .where(eq(apiTokens.tokenHash, await sha256Hex(match[1])))
+    .returning({ userId: apiTokens.userId, rateCount: apiTokens.rateCount });
+  if (!row) return c.json({ error: "Unauthorized" }, 401);
+
+  if (row.rateCount > RATE_LIMIT_PER_MINUTE) {
+    const retryAfter = Math.ceil((WINDOW_MS - (Date.now() % WINDOW_MS)) / 1000);
+    return c.json({ error: "Rate limit exceeded" }, 429, { "Retry-After": String(retryAfter) });
+  }
+  return { userId: row.userId };
+}

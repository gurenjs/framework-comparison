+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,15 @@
+import { createBearerTokenMiddleware, createRateLimitMiddleware, DatabaseApiTokenStore, getApiTokenOrFail } from '@guren/core'
+import { apiTokens } from '../../../db/schema.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export const requireApiToken = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+export const apiTokenRateLimit = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  keyGenerator: (c) => `api-token:${getApiTokenOrFail(c).token.id}`,
+})

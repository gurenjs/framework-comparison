diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..d6f1ca3
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,132 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { createApiToken } from '@guren/core'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { apiTokenStore } from '../app/Http/Middleware/ApiTokenAuth.js'
+import { User } from '../app/Models/User.js'
+
+let http: TestApp
+let emailSeq = 0
+
+async function makeUser() {
+  emailSeq += 1
+  return User.create({ name: 'Author', email: `author${emailSeq}@example.test`, password: 'secret-password' })
+}
+
+async function bearerFor(userId: number, name = 'CI') {
+  const { plainTextToken, token } = await createApiToken(apiTokenStore, { name, userId })
+  return { plainTextToken, id: token.id, client: http.withHeader('Authorization', `Bearer ${plainTextToken}`).json() }
+}
+
+describe('personal API tokens', () => {
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('creates a token from a session and stores only its hash', async () => {
+    const user = await makeUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    const response = await csrf.json().post('/profile/tokens', { name: 'CI' }).assertCreated()
+    const body = await response.json<{ id: string; name: string; token: string }>()
+
+    expect(body.name).toBe('CI')
+    expect(body.token.startsWith(`${body.id}|`)).toBe(true)
+    expect(body.token.split('|')[1].length).toBeGreaterThanOrEqual(16)
+
+    const stored = await apiTokenStore.findByUserId(user.id)
+    expect(stored).toHaveLength(1)
+    expect(JSON.stringify(stored)).not.toContain(body.token.split('|')[1])
+  })
+
+  it('rejects an empty token name without creating a token', async () => {
+    const user = await makeUser()
+    const csrf = await http.actingAs(user).withCsrf()
+
+    await csrf.json().post('/profile/tokens', { name: '   ' }).assertUnprocessable()
+    expect(await apiTokenStore.findByUserId(user.id)).toHaveLength(0)
+  })
+
+  it('redirects a guest away from token creation', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.json().post('/profile/tokens', { name: 'CI' }).assertRedirect('/login')
+  })
+
+  it('lists and creates posts as the token owner', async () => {
+    const user = await makeUser()
+    const { client } = await bearerFor(user.id)
+
+    await client.get('/api/posts').assertOk().assertJsonStructure(['data'])
+
+    const created = await client
+      .post('/api/posts', { title: 'Release notes', excerpt: 'Version 2', body: 'Details', authorId: 9999 })
+      .assertCreated()
+    const payload = await created.json<{ data: { title: string; authorId: number; createdAt: string } }>()
+
+    expect(payload.data.title).toBe('Release notes')
+    expect(payload.data.authorId).toBe(user.id)
+    expect(new Date(payload.data.createdAt).toISOString()).toBe(payload.data.createdAt)
+  })
+
+  it('answers 422 for an invalid post and creates nothing', async () => {
+    const user = await makeUser()
+    const { client } = await bearerFor(user.id)
+
+    await client.post('/api/posts', { title: '', excerpt: 'Version 2', body: 'Details' }).assertUnprocessable()
+    const listed = await client.get('/api/posts').assertOk()
+    const payload = await listed.json<{ data: unknown[] }>()
+    expect(payload.data).toHaveLength(0)
+  })
+
+  it('answers 401 for missing, unknown and revoked tokens', async () => {
+    const user = await makeUser()
+    const { client, plainTextToken, id } = await bearerFor(user.id)
+
+    await http.json().get('/api/posts').assertUnauthorized()
+    await http.withHeader('Authorization', 'Bearer not-a-token').json().get('/api/posts').assertUnauthorized()
+    await http.withHeader('Authorization', `Bearer ${id}|${'0'.repeat(64)}`).json().get('/api/posts').assertUnauthorized()
+
+    await client.get('/api/posts').assertOk()
+    const csrf = await http.actingAs(user).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${id}`).assertNoContent()
+    await client.get('/api/posts').assertUnauthorized()
+    await http.withHeader('Authorization', `Bearer ${plainTextToken}`).json().post('/api/posts', {
+      title: 'Nope',
+      excerpt: 'Nope',
+      body: 'Nope',
+    }).assertUnauthorized()
+  })
+
+  it('revokes only the owner’s own tokens', async () => {
+    const owner = await makeUser()
+    const other = await makeUser()
+    const ownerToken = await bearerFor(owner.id, 'CI')
+    const otherToken = await bearerFor(other.id, 'Laptop')
+
+    const ownerCsrf = await http.actingAs(owner).withCsrf()
+    await ownerCsrf.json().delete(`/profile/tokens/${otherToken.id}`).assertNotFound()
+    await otherToken.client.get('/api/posts').assertOk()
+
+    await ownerCsrf.json().delete(`/profile/tokens/${ownerToken.id}`).assertNoContent()
+    await ownerToken.client.get('/api/posts').assertUnauthorized()
+  })
+
+  it('limits each token to 60 requests a minute with Retry-After on the 61st', async () => {
+    const user = await makeUser()
+    const first = await bearerFor(user.id, 'CI')
+    const second = await bearerFor(user.id, 'Laptop')
+
+    for (let attempt = 0; attempt < 60; attempt += 1) {
+      await first.client.get('/api/posts').assertOk()
+    }
+    const limited = await first.client.get('/api/posts').assertStatus(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+
+    await second.client.get('/api/posts').assertOk()
+  })
+})

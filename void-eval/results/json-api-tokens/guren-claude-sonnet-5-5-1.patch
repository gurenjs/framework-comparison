diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..1975d72
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,26 @@
+import { createRateLimitMiddleware, defineMiddleware, MemoryRateLimitStore } from '@guren/core'
+import { ApiToken, hashApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_ID_KEY = 'apiUserId'
+const API_TOKEN_ID_KEY = 'apiTokenId'
+
+const limiter = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  store: new MemoryRateLimitStore(),
+  keyPrefix: 'api-token:',
+  keyGenerator: (ctx) => String(ctx.get(API_TOKEN_ID_KEY)),
+})
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const header = c.req.header('Authorization') ?? ''
+  const match = /^Bearer ([A-Za-z0-9_-]+)$/i.exec(header)
+  const record = match ? await ApiToken.first({ tokenHash: hashApiToken(match[1]!) }) : null
+  if (!record) {
+    return c.json({ message: 'Unauthenticated.' }, 401)
+  }
+
+  c.set(API_USER_ID_KEY, record.userId)
+  c.set(API_TOKEN_ID_KEY, record.id)
+  return limiter(c, next)
+})

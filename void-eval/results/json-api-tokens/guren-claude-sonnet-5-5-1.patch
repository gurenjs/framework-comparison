@@ -0,0 +1,43 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { User } from '../app/Models/User.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    user = await User.create({ name: 'Tokens', email: `tokens-${Date.now()}@example.com`, password: 'password123' })
+  })
+
+  const bearer = (token: string) => ({ Authorization: `Bearer ${token}`, Accept: 'application/json' })
+
+  it('creates, uses, rate limits and revokes tokens', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    const created = await csrf.json().post('/profile/tokens', { name: 'CI' })
+    created.assertStatus(201)
+    const { id, token } = (await created.json()) as { id: number; token: string }
+    expect(token.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await ApiToken.all()
+    expect(JSON.stringify(rows)).not.toContain(token)
+
+    const res = await app.fetch(new Request('http://localhost/api/posts', { headers: bearer(token) }))
+    expect(res.status).toBe(200)
+    const unauthenticated = await app.fetch(new Request('http://localhost/api/posts', { headers: bearer(`${token}x`) }))
+    expect(unauthenticated.status).toBe(401)
+
+    let last = 200
+    for (let i = 0; i < 60; i++) {
+      last = (await app.fetch(new Request('http://localhost/api/posts', { headers: bearer(token) }))).status
+    }
+    expect(last).toBe(429)
+
+    await csrf.json().delete(`/profile/tokens/${id}`).assertStatus(204)
+    const revoked = await app.fetch(new Request('http://localhost/api/posts', { headers: bearer(token) }))
+    expect(revoked.status).toBe(401)
+  })
+})

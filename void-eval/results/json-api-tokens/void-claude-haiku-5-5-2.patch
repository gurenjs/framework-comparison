@@ -0,0 +1,37 @@
+import { posts } from "@schema";
+import { defineHandler } from "void";
+import { db, desc } from "void/db";
+import { apiUserOrRespond } from "../../../lib/api-tokens";
+import { postPayloadSchema } from "../../../lib/validators";
+
+const postColumns = {
+  id: posts.id,
+  title: posts.title,
+  excerpt: posts.excerpt,
+  authorId: posts.authorId,
+  createdAt: posts.createdAt,
+};
+
+export const GET = defineHandler(async (c) => {
+  const auth = await apiUserOrRespond(c);
+  if (auth instanceof Response) return auth;
+
+  const data = await db.select(postColumns).from(posts).orderBy(desc(posts.id));
+  return { data };
+});
+
+export const POST = defineHandler(async (c) => {
+  const auth = await apiUserOrRespond(c);
+  if (auth instanceof Response) return auth;
+
+  const parsed = postPayloadSchema.safeParse(await c.req.json().catch(() => null));
+  if (!parsed.success) {
+    return c.json({ error: "Validation failed", issues: parsed.error.issues }, 400);
+  }
+
+  const [post] = await db
+    .insert(posts)
+    .values({ ...parsed.data, authorId: auth.userId })
+    .returning(postColumns);
+  return c.json({ data: post }, 201);
+});
diff --git a/routes/profile/tokens/[id].ts b/routes/profile/tokens/[id].ts
new file mode 100644
index 0000000..0c2ea96
--- /dev/null
+++ b/routes/profile/tokens/[id].ts
@@ -0,0 +1,19 @@
+import { apiTokens } from "@schema";
+import { defineHandler } from "void";
+import { requireAuth } from "void/auth";
+import { and, db, eq } from "void/db";
+import { tokenIdSchema } from "../../../lib/validators";
+
+export const DELETE = defineHandler(async (c) => {
+  const user = requireAuth(c);
+  const parsed = tokenIdSchema.safeParse(c.req.param("id"));
+  if (!parsed.success) return c.json({ error: "Token not found" }, 404);
+
+  const [deleted] = await db
+    .delete(apiTokens)
+    .where(and(eq(apiTokens.id, parsed.data), eq(apiTokens.userId, user.id)))
+    .returning({ id: apiTokens.id });
+  if (!deleted) return c.json({ error: "Token not found" }, 404);
+
+  return c.body(null, 204);
+});

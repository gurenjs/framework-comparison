-        {form.errors.email && <p className="error">{form.errors.email}</p>}
-        {form.recentlySuccessful && <p>Profile updated successfully.</p>}
-        <button disabled={form.pending}>Save</button>
-      </Form>
+        {error && <p className="error">{error}</p>}
+        <button disabled={name.trim().length === 0}>Create token</button>
+      </form>
+      {tokens.length === 0 ? (
+        <p>No API tokens yet.</p>
+      ) : (
+        <ul>
+          {tokens.map((t) => (
+            <li key={t.id}>
+              {t.name} <button onClick={() => revokeToken(t.id)}>Revoke</button>
+            </li>
+          ))}
+        </ul>
+      )}
     </section>
   );
 }

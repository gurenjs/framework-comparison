diff --git a/lib/api-tokens.ts b/lib/api-tokens.ts
new file mode 100644
index 0000000..fb7feda
--- /dev/null
+++ b/lib/api-tokens.ts
@@ -0,0 +1,53 @@
+import type { Context } from "hono";
+import { apiTokens } from "@schema";
+import { db, eq, sql } from "void/db";
+
+const RATE_LIMIT_PER_MINUTE = 60;
+const BEARER_PATTERN = /^Bearer ([0-9a-f]{64})$/;
+
+function toHex(bytes: ArrayBuffer | Uint8Array): string {
+  return Array.from(new Uint8Array(bytes), (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+async function hashToken(token: string): Promise<string> {
+  return toHex(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(token)));
+}
+
+/** Creates a token for the user. The plain-text token is returned once and never stored. */
+export async function createApiToken(userId: string, name: string) {
+  const token = toHex(crypto.getRandomValues(new Uint8Array(32)));
+  const [row] = await db
+    .insert(apiTokens)
+    .values({ userId, name, tokenHash: await hashToken(token) })
+    .returning({ id: apiTokens.id, name: apiTokens.name });
+  return { id: row.id, name: row.name, token };
+}
+
+/** Returns the token owner, or a 401/429 JSON response to send back. */
+export async function apiUserOrRespond(c: Context): Promise<{ userId: string } | Response> {
+  const token = BEARER_PATTERN.exec(c.req.header("Authorization") ?? "")?.[1];
+  if (!token) return c.json({ error: "Unauthorized" }, 401);
+
+  const [row] = await db
+    .select({ id: apiTokens.id, userId: apiTokens.userId })
+    .from(apiTokens)
+    .where(eq(apiTokens.tokenHash, await hashToken(token)));
+  if (!row) return c.json({ error: "Unauthorized" }, 401);
+
+  const now = Date.now();
+  const window = Math.floor(now / 60_000);
+  const [usage] = await db
+    .update(apiTokens)
+    .set({
+      rateWindow: window,
+      rateCount: sql`CASE WHEN ${apiTokens.rateWindow} = ${window} THEN ${apiTokens.rateCount} + 1 ELSE 1 END`,
+    })
+    .where(eq(apiTokens.id, row.id))
+    .returning({ rateCount: apiTokens.rateCount });
+  if (usage.rateCount > RATE_LIMIT_PER_MINUTE) {
+    c.header("Retry-After", String(60 - (Math.floor(now / 1000) % 60)));
+    return c.json({ error: "Rate limit exceeded" }, 429);
+  }
+
+  return { userId: row.userId };
+}

+import { Resource } from '@guren/core'
+import type { PostRecord } from '../../Models/Post.js'
+
+export interface ApiPostResourceData extends Record<string, unknown> {
+  id: number
+  title: string
+  excerpt: string
+  authorId: number
+  createdAt: string
+}
+
+export class ApiPostResource extends Resource<PostRecord, ApiPostResourceData> {
+  toArray(): ApiPostResourceData {
+    const post = this.resource
+
+    return {
+      id: post.id,
+      title: post.title,
+      excerpt: post.excerpt,
+      authorId: post.authorId,
+      createdAt: new Date(post.createdAt).toISOString(),
+    }
+  }
+}

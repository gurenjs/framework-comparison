diff --git a/app/Http/Middleware/AuthenticateApiToken.ts b/app/Http/Middleware/AuthenticateApiToken.ts
new file mode 100644
index 0000000..5d89f29
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateApiToken.ts
@@ -0,0 +1,47 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_USER_ID_KEY = 'apiTokenUserId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+// Per-process fixed window per token id; swap for a shared store when running several instances.
+const windows = new Map<string, { count: number; resetAt: number }>()
+
+function unauthorized(): Response {
+  return Response.json({ message: 'Unauthenticated.' }, { status: 401, headers: { 'WWW-Authenticate': 'Bearer' } })
+}
+
+export const authenticateApiToken = defineMiddleware(async (c, next) => {
+  const header = c.req.header('Authorization') ?? ''
+  const match = /^Bearer\s+(\S+)$/i.exec(header.trim())
+  if (!match) return unauthorized()
+
+  const tokenHash = hashApiToken(match[1]!)
+  const record = await ApiToken.first({ tokenHash })
+  if (!record) return unauthorized()
+
+  const now = Date.now()
+  let entry = windows.get(tokenHash)
+  if (!entry || entry.resetAt <= now) {
+    entry = { count: 0, resetAt: now + WINDOW_MS }
+    windows.set(tokenHash, entry)
+  }
+  entry.count += 1
+  if (entry.count > LIMIT) {
+    const retryAfter = Math.min(60, Math.max(1, Math.ceil((entry.resetAt - now) / 1000)))
+    return Response.json(
+      { message: 'Too many requests.' },
+      { status: 429, headers: { 'Retry-After': String(retryAfter) } },
+    )
+  }
+
+  c.set(API_USER_ID_KEY, record.userId)
+  await next()
+})

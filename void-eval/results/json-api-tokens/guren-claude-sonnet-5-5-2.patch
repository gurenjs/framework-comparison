diff --git a/tests/ApiToken.test.ts b/tests/ApiToken.test.ts
new file mode 100644
index 0000000..90a75da
--- /dev/null
+++ b/tests/ApiToken.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let owner: Awaited<ReturnType<typeof User.create>>
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    owner = await User.create({ name: 'Ann', email: 'ann@example.com', password: 'password123' })
+  })
+
+  const session = async () => http.actingAs(owner).withCsrf()
+
+  async function issue(name = 'CI'): Promise<{ id: number; token: string }> {
+    const res = await (await session()).json().post('/profile/tokens', { name })
+    res.assertCreated()
+    return res.json<{ id: number; token: string }>()
+  }
+
+  it('stores only a hash of the token', async () => {
+    const { token } = await issue()
+    const rows = await ApiToken.all()
+    expect(rows.length).toBe(1)
+    expect(JSON.stringify(rows)).not.toContain(token)
+  })
+
+  it('rejects invalid names', async () => {
+    await (await session()).json().post('/profile/tokens', { name: '' }).assertStatus(422)
+    await (await session()).json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertStatus(422)
+    expect((await ApiToken.all()).length).toBe(0)
+  })
+
+  it('authenticates, creates posts for the owner, and revokes', async () => {
+    const { id, token } = await issue()
+    const api = http.json().withHeader('Authorization', `Bearer ${token}`)
+
+    await api.post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 }).assertCreated()
+    expect((await Post.all())[0]!.authorId).toBe(Number(owner.id))
+    await api.post('/api/posts', { title: '', excerpt: 'E', body: 'B' }).assertStatus(422)
+    await api.get('/api/posts').assertOk().assertJsonCount(1, 'data')
+
+    await http.json().withHeader('Authorization', `Bearer ${token}x`).get('/api/posts').assertUnauthorized()
+    await (await session()).json().delete(`/profile/tokens/${id}`).assertNoContent()
+    await api.get('/api/posts').assertUnauthorized()
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const first = await issue('one')
+    const second = await issue('two')
+    const api = http.json().withHeader('Authorization', `Bearer ${first.token}`)
+    for (let i = 0; i < 60; i++) await api.get('/api/posts').assertOk()
+    const limited = await api.get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    await http.json().withHeader('Authorization', `Bearer ${second.token}`).get('/api/posts').assertOk()
+  })
+})

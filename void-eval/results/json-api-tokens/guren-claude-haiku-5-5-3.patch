diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..7c02411
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,127 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { apiTokenStore } from '../app/Auth/ApiTokenStore.js'
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    alice = await User.create({ name: 'Alice', email: 'alice@example.test', password: 'password123' }) as UserRecord
+    bob = await User.create({ name: 'Bob', email: 'bob@example.test', password: 'password123' }) as UserRecord
+  })
+
+  async function createToken(user: UserRecord, name: string): Promise<CreatedToken> {
+    const session = await http.actingAs(user).withCsrf()
+    const res = await session.json().post('/profile/tokens', { name })
+    expect(res.status).toBe(201)
+    return res.json<CreatedToken>()
+  }
+
+  function api(token: string) {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  it('creates a token shown once, stored only as a hash', async () => {
+    const created = await createToken(alice, 'CI')
+
+    expect(created.name).toBe('CI')
+    expect(created.token.startsWith(`${created.id}|`)).toBe(true)
+    expect(created.token.split('|')[1].length).toBeGreaterThanOrEqual(16)
+
+    const [row] = await apiTokenStore.findByUserId(alice.id)
+    expect(row.id).toBe(created.id)
+    expect(row.hashedToken).not.toContain(created.token.split('|')[1])
+  })
+
+  it('rejects an empty or over-long name without creating a token', async () => {
+    const session = await http.actingAs(alice).withCsrf()
+
+    await session.json().post('/profile/tokens', { name: '   ' }).assertUnprocessable()
+    await session.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+  })
+
+  it('lists posts and creates one owned by the token user', async () => {
+    const created = await createToken(alice, 'CI')
+    const client = api(created.token)
+
+    await client.post('/api/posts', { title: 'Release', excerpt: 'Notes', body: 'Body', authorId: bob.id }).assertCreated()
+
+    const listed = await (await client.get('/api/posts')).json<{ data: Array<{ title: string; authorId: number }> }>()
+    expect(listed.data).toHaveLength(1)
+    expect(listed.data[0].title).toBe('Release')
+    expect(listed.data[0].authorId).toBe(alice.id)
+
+    const stored = await Post.where({ title: 'Release' }).first()
+    expect(stored?.authorId).toBe(alice.id)
+  })
+
+  it('answers 422 for invalid post input and creates nothing', async () => {
+    const created = await createToken(alice, 'CI')
+
+    await api(created.token).post('/api/posts', { title: '', excerpt: 'Notes' }).assertUnprocessable()
+    expect(await Post.newQuery().get()).toHaveLength(0)
+  })
+
+  it('answers 401 for missing, malformed, unknown and tampered tokens', async () => {
+    const created = await createToken(alice, 'CI')
+
+    await http.json().get('/api/posts').assertUnauthorized()
+    await api('not-a-token').get('/api/posts').assertUnauthorized()
+    await api(`${created.id}|wrong-secret-value-here`).get('/api/posts').assertUnauthorized()
+  })
+
+  it('stops a revoked token at once and keeps the owner’s other tokens working', async () => {
+    const first = await createToken(alice, 'CI')
+    const second = await createToken(alice, 'laptop')
+
+    const session = await http.actingAs(alice).withCsrf()
+    await session.json().delete(`/profile/tokens/${first.id}`).assertNoContent()
+
+    await api(first.token).get('/api/posts').assertUnauthorized()
+    await api(second.token).get('/api/posts').assertOk()
+  })
+
+  it('answers 404 when revoking another user’s token, which keeps working', async () => {
+    const bobsToken = await createToken(bob, 'bob-ci')
+
+    const session = await http.actingAs(alice).withCsrf()
+    await session.json().delete(`/profile/tokens/${bobsToken.id}`).assertNotFound()
+
+    await api(bobsToken.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests a minute', async () => {
+    const created = await createToken(alice, 'busy')
+    const client = api(created.token)
+
+    for (let i = 0; i < 60; i++) {
+      await client.get('/api/posts').assertOk()
+    }
+
+    const limited = await client.get('/api/posts')
+    expect(limited.status).toBe(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    const other = await createToken(alice, 'other')
+    await api(other.token).get('/api/posts').assertOk()
+  })
+})

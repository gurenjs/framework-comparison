+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiToken, type Router } from '@guren/core'
+import PostApiController from '../app/Http/Controllers/Api/PostApiController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+import { apiTokenStore } from '../app/Auth/ApiTokenStore.js'
+import { User } from '../app/Models/User.js'
+
+export function registerApiRoutes(baseRouter: Router): void {
+  const bearer = createBearerTokenMiddleware({
+    store: apiTokenStore,
+    loadUser: (userId) => User.find(Number(userId)),
+  })
+
+  // One limiter instance shared by every /api route, so the 60 requests a minute
+  // are counted per token across endpoints. Authenticated requests only: the
+  // bearer middleware has already rejected anything else.
+  const perToken = createRateLimitMiddleware({
+    limit: 60,
+    windowMs: 60_000,
+    keyPrefix: 'api-token:',
+    keyGenerator: (ctx) => `token:${getApiToken(ctx)?.token.id ?? 'anonymous'}`,
+  })
+
+  baseRouter.group('/api', (api) => {
+    api.middleware(bearer, perToken).group((authed) => {
+      authed.get('/posts', [PostApiController, 'index']).name('api.posts.index')
+      authed.post('/posts', { name: 'api.posts.store', body: PostPayloadSchema }, [PostApiController, 'store'])
+    })
+  })
+}

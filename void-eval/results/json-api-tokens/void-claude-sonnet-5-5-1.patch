diff --git a/lib/api-tokens.ts b/lib/api-tokens.ts
new file mode 100644
index 0000000..d2aa9fe
--- /dev/null
+++ b/lib/api-tokens.ts
@@ -0,0 +1,59 @@
+import type { Context } from "hono";
+import { apiTokens } from "@schema";
+import { db, eq, sql } from "void/db";
+
+export const RATE_LIMIT = 60;
+const WINDOW_MS = 60_000;
+const TOKEN_PREFIX = "vbt_";
+
+function toHex(bytes: Uint8Array): string {
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+/** The only form of a token that is ever stored. Tokens are 256-bit random, so a plain digest is enough. */
+export async function hashToken(token: string): Promise<string> {
+  return toHex(new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(token))));
+}
+
+export function generateToken(): string {
+  return TOKEN_PREFIX + toHex(crypto.getRandomValues(new Uint8Array(32)));
+}
+
+function jsonError(c: Context, status: 401 | 429, message: string, headers?: Record<string, string>) {
+  return c.json({ error: message }, status, headers);
+}
+
+/**
+ * Authenticates a request by its bearer token and applies the per-token rate limit.
+ * Returns the token owner's id, or a JSON error Response (401 / 429).
+ */
+export async function authenticateApiRequest(c: Context): Promise<{ userId: string } | Response> {
+  const match = /^Bearer ([^\s]+)$/.exec(c.req.header("authorization") ?? "");
+  if (!match || !match[1].startsWith(TOKEN_PREFIX)) return jsonError(c, 401, "Invalid or missing API token.");
+
+  const [row] = await db
+    .select({ id: apiTokens.id, userId: apiTokens.userId })
+    .from(apiTokens)
+    .where(eq(apiTokens.tokenHash, await hashToken(match[1])));
+  if (!row) return jsonError(c, 401, "Invalid or missing API token.");
+
+  // Atomic fixed-window counter: reset the window when it has elapsed, otherwise increment.
+  const now = Date.now();
+  const expired = sql`${apiTokens.windowStart} <= ${now - WINDOW_MS}`;
+  const [window] = await db
+    .update(apiTokens)
+    .set({
+      windowStart: sql`CASE WHEN ${expired} THEN ${now} ELSE ${apiTokens.windowStart} END`,
+      windowCount: sql`CASE WHEN ${expired} THEN 1 ELSE ${apiTokens.windowCount} + 1 END`,
+    })
+    .where(eq(apiTokens.id, row.id))
+    .returning({ windowStart: apiTokens.windowStart, windowCount: apiTokens.windowCount });
+  // Revoked between lookup and update.
+  if (!window) return jsonError(c, 401, "Invalid or missing API token.");
+
+  if (window.windowCount > RATE_LIMIT) {
+    const retryAfter = Math.min(60, Math.max(1, Math.ceil((window.windowStart + WINDOW_MS - now) / 1000)));
+    return jsonError(c, 429, "Rate limit exceeded.", { "Retry-After": String(retryAfter) });
+  }
+  return { userId: row.userId };
+}

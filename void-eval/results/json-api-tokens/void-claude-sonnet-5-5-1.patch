--- /dev/null
+++ b/routes/api/posts.ts
@@ -0,0 +1,34 @@
+import { defineHandler } from "void";
+import { posts } from "@schema";
+import { db, desc } from "void/db";
+import { authenticateApiRequest } from "../../lib/api-tokens";
+import { postPayloadSchema } from "../../lib/validators";
+
+const publicColumns = {
+  id: posts.id,
+  title: posts.title,
+  excerpt: posts.excerpt,
+  authorId: posts.authorId,
+  createdAt: posts.createdAt,
+};
+
+export const GET = defineHandler(async (c) => {
+  const auth = await authenticateApiRequest(c);
+  if (auth instanceof Response) return auth;
+  const data = await db.select(publicColumns).from(posts).orderBy(desc(posts.createdAt), desc(posts.id));
+  return c.json({ data });
+});
+
+export const POST = defineHandler(async (c) => {
+  const auth = await authenticateApiRequest(c);
+  if (auth instanceof Response) return auth;
+
+  const parsed = postPayloadSchema.safeParse(await c.req.json().catch(() => null));
+  if (!parsed.success) return c.json({ error: "Validation failed", issues: parsed.error.issues.map((i) => i.message) }, 400);
+
+  const [data] = await db
+    .insert(posts)
+    .values({ ...parsed.data, authorId: auth.userId })
+    .returning(publicColumns);
+  return c.json({ data }, 201);
+});
diff --git a/routes/profile/tokens.ts b/routes/profile/tokens.ts
new file mode 100644
index 0000000..684b983
--- /dev/null
+++ b/routes/profile/tokens.ts
@@ -0,0 +1,18 @@
+import { defineHandler } from "void";
+import { requireAuth } from "void/auth";
+import { apiTokens } from "@schema";
+import { db } from "void/db";
+import { generateToken, hashToken } from "../../lib/api-tokens";
+import { tokenNameSchema } from "../../lib/validators";
+
+export const POST = defineHandler(async (c) => {
+  const user = requireAuth(c);
+  const body = await c.req.json().catch(() => null);
+  const parsed = tokenNameSchema.safeParse(body);
+  if (!parsed.success) return c.json({ error: "Validation failed", issues: parsed.error.issues.map((i) => i.message) }, 400);
+
+  const id = crypto.randomUUID();
+  const token = generateToken();
+  await db.insert(apiTokens).values({ id, userId: user.id, name: parsed.data.name, tokenHash: await hashToken(token) });
+  return c.json({ id, name: parsed.data.name, token }, 201);
+});

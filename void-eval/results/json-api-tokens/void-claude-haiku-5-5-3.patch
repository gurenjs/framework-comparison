+++ b/routes/api/posts.ts
@@ -0,0 +1,34 @@
+import { defineHandler } from "void";
+import { posts } from "@schema";
+import { db, desc } from "void/db";
+import { authenticateApiToken } from "../../lib/api-tokens";
+import { postPayloadSchema } from "../../lib/validators";
+
+const postColumns = {
+  id: posts.id,
+  title: posts.title,
+  excerpt: posts.excerpt,
+  authorId: posts.authorId,
+  createdAt: posts.createdAt,
+};
+
+export const GET = defineHandler(async (c) => {
+  const auth = await authenticateApiToken(c);
+  if (auth instanceof Response) return auth;
+  const data = await db.select(postColumns).from(posts).orderBy(desc(posts.createdAt), desc(posts.id));
+  return { data };
+});
+
+export const POST = defineHandler(async (c) => {
+  const auth = await authenticateApiToken(c);
+  if (auth instanceof Response) return auth;
+  const parsed = postPayloadSchema.safeParse(await c.req.json().catch(() => null));
+  if (!parsed.success) {
+    return c.json({ error: "Validation failed", issues: parsed.error.issues }, 400);
+  }
+  const [post] = await db
+    .insert(posts)
+    .values({ ...parsed.data, authorId: auth.userId })
+    .returning(postColumns);
+  return c.json({ data: post }, 201);
+});

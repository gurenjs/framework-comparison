diff --git a/lib/api-tokens.ts b/lib/api-tokens.ts
new file mode 100644
index 0000000..4f51d2e
--- /dev/null
+++ b/lib/api-tokens.ts
@@ -0,0 +1,49 @@
+import type { Context } from "hono";
+import { apiTokens } from "@schema";
+import { db, eq, sql } from "void/db";
+
+export const API_RATE_LIMIT_PER_MINUTE = 60;
+
+export function generateApiToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32));
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+export async function hashApiToken(token: string): Promise<string> {
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(token));
+  return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+function unauthorized(c: Context): Response {
+  return c.json({ error: "Unauthorized" }, 401, { "WWW-Authenticate": "Bearer" });
+}
+
+/** Resolves `Authorization: Bearer <token>` to the token's owner, or returns the 401/429 response to send. */
+export async function authenticateApiToken(c: Context): Promise<{ userId: string } | Response> {
+  const match = /^Bearer\s+(\S+)$/i.exec(c.req.header("authorization") ?? "");
+  if (!match) return unauthorized(c);
+
+  const [token] = await db
+    .select({ id: apiTokens.id, userId: apiTokens.userId })
+    .from(apiTokens)
+    .where(eq(apiTokens.tokenHash, await hashApiToken(match[1])));
+  if (!token) return unauthorized(c);
+
+  const minute = Math.floor(Date.now() / 60_000);
+  const [usage] = await db
+    .update(apiTokens)
+    .set({
+      rateCount: sql`CASE WHEN ${apiTokens.rateWindow} = ${minute} THEN ${apiTokens.rateCount} + 1 ELSE 1 END`,
+      rateWindow: minute,
+    })
+    .where(eq(apiTokens.id, token.id))
+    .returning({ rateCount: apiTokens.rateCount });
+  if (!usage) return unauthorized(c);
+
+  if (usage.rateCount > API_RATE_LIMIT_PER_MINUTE) {
+    const retryAfter = 60 - (Math.floor(Date.now() / 1000) % 60);
+    return c.json({ error: "Rate limit exceeded" }, 429, { "Retry-After": String(retryAfter) });
+  }
+
+  return { userId: token.userId };
+}

+        <ul>
+          {tokens.map((t) => (
+            <li key={t.id}>
+              {t.name} <button type="button" onClick={() => revokeToken(t.id)}>Revoke</button>
+            </li>
+          ))}
+        </ul>
+      </section>
+    </>
   );
 }

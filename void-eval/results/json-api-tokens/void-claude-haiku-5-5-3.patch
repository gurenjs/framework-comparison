--- /dev/null
+++ b/routes/profile/tokens.ts
@@ -0,0 +1,18 @@
+import { defineHandler } from "void";
+import { requireAuth } from "void/auth";
+import { apiTokens } from "@schema";
+import { db } from "void/db";
+import { generateApiToken, hashApiToken } from "../../lib/api-tokens";
+import { apiTokenPayloadSchema } from "../../lib/validators";
+
+export const POST = defineHandler.withValidator({
+  body: apiTokenPayloadSchema,
+})(async (c, { body }) => {
+  const user = requireAuth(c);
+  const token = generateApiToken();
+  const [created] = await db
+    .insert(apiTokens)
+    .values({ userId: user.id, name: body.name, tokenHash: await hashApiToken(token) })
+    .returning({ id: apiTokens.id, name: apiTokens.name });
+  return c.json({ id: created.id, name: created.name, token }, 201);
+});

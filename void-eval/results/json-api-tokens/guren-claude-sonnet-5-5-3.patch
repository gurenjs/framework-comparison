diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..773c3a3
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,117 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { getDatabase, resetDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let alice: UserRecord
+  let bob: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    alice = (await User.create({ name: 'Alice', email: 'alice@example.com', password: 'secret-pass' })) as UserRecord
+    bob = (await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-pass' })) as UserRecord
+  })
+
+  async function createToken(user: UserRecord, name = 'CI') {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name })
+    expect(res.status).toBe(201)
+    return res.json<{ id: string; name: string; token: string }>()
+  }
+
+  async function tokenRows(): Promise<Record<string, unknown>[]> {
+    const db = (await getDatabase()) as { select(): { from(table: unknown): Promise<Record<string, unknown>[]> } }
+    return db.select().from(apiTokens)
+  }
+
+  const bearer = (token: string) => http.withHeaders({ Authorization: `Bearer ${token}`, Accept: 'application/json' })
+
+  it('creates a token, stores only a derived value, and rejects bad names', async () => {
+    const created = await createToken(alice)
+    expect(created.token.split('|')[1]!.length).toBeGreaterThanOrEqual(16)
+
+    const rows = await tokenRows()
+    expect(rows).toHaveLength(1)
+    const secret = created.token.split('|')[1]!
+    for (const value of Object.values(rows[0]!)) {
+      expect(String(value)).not.toContain(secret)
+    }
+
+    const csrf = await http.actingAs(alice).withCsrf()
+    await csrf.json().post('/profile/tokens', {}).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: '' }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+    expect(await tokenRows()).toHaveLength(1)
+  })
+
+  it('authenticates posts API requests as the token owner', async () => {
+    const { token } = await createToken(alice)
+    await Post.forceCreate({ title: 'Old', excerpt: 'e', body: 'b', authorId: bob.id })
+
+    const created = await bearer(token)
+      .post('/api/posts', { title: 'New', excerpt: 'x', body: 'y', authorId: bob.id })
+    expect(created.status).toBe(201)
+    const body = await created.json<{ data: { authorId: number } }>()
+    expect(body.data.authorId).toBe(alice.id)
+
+    const list = await (await bearer(token).get('/api/posts')).json<{ data: { title: string }[] }>()
+    expect(list.data.map((post) => post.title)).toEqual(['New', 'Old'])
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'x', body: 'y' }).assertUnprocessable()
+    await bearer(token).post('/api/posts', { title: 't', excerpt: 'x' }).assertUnprocessable()
+  })
+
+  it('answers 401 for missing, malformed, tampered and revoked tokens', async () => {
+    const { id, token } = await createToken(alice)
+    const other = await createToken(alice, 'other')
+
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('garbage').get('/api/posts').assertUnauthorized()
+    await bearer(`${token}x`).get('/api/posts').assertUnauthorized()
+    await bearer('nope|' + token.split('|')[1]).get('/api/posts').assertUnauthorized()
+
+    const csrf = await http.actingAs(alice).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${id}`).assertNoContent()
+    await bearer(token).get('/api/posts').assertUnauthorized()
+    await bearer(token).post('/api/posts', { title: 't', excerpt: 'x', body: 'y' }).assertUnauthorized()
+    await bearer(other.token).get('/api/posts').assertOk()
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it("hides another user's token from revocation", async () => {
+    const { id, token } = await createToken(alice)
+    const csrf = await http.actingAs(bob).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${id}`).assertNotFound()
+    await bearer(token).get('/api/posts').assertOk()
+  })
+
+  it('gives guests no token', async () => {
+    const csrf = await http.withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name: 'CI' })
+    expect([302, 401]).toContain(res.status)
+  })
+
+  it('rate limits per token', async () => {
+    const first = await createToken(alice, 'one')
+    const second = await createToken(alice, 'two')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    expect(limited.status).toBe(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})

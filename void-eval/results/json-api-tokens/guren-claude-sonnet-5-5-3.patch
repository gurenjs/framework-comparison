diff --git a/app/Http/Middleware/ApiTokens.ts b/app/Http/Middleware/ApiTokens.ts
new file mode 100644
index 0000000..88b9246
--- /dev/null
+++ b/app/Http/Middleware/ApiTokens.ts
@@ -0,0 +1,34 @@
+import {
+  DatabaseApiTokenStore,
+  MemoryRateLimitStore,
+  createBearerTokenMiddleware,
+  createRateLimitMiddleware,
+  getApiToken,
+} from '@guren/core'
+import { apiTokens } from '../../../db/schema.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+const rateLimitStore = new MemoryRateLimitStore()
+
+const authenticateBearer = createBearerTokenMiddleware({
+  store: apiTokenStore,
+  onUnauthorized: (c) => c.json({ message: 'Unauthenticated.' }, 401),
+})
+
+// Keyed by token id, not user or IP: each token gets its own budget.
+const throttleToken = createRateLimitMiddleware({
+  limit: 60,
+  windowMs: 60_000,
+  store: rateLimitStore,
+  keyPrefix: 'api-token:',
+  keyGenerator: (c) => getApiToken(c)?.token.id ?? 'anonymous',
+  message: 'Too many requests.',
+  onRateLimited: (c, retryAfter) => {
+    c.header('Retry-After', String(retryAfter))
+    return c.json({ message: 'Too many requests.' }, 429)
+  },
+})
+
+// Order matters: throttling reads the token authentication resolved.
+export const apiTokenAuth = [authenticateBearer, throttleToken]

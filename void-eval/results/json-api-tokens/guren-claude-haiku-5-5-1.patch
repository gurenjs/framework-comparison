new file mode 100644
index 0000000..c9912a4
--- /dev/null
+++ b/routes/api.ts
@@ -0,0 +1,23 @@
+import { createBearerTokenMiddleware, createRateLimitMiddleware, getApiToken, type Router } from '@guren/core'
+import { apiTokenStore } from '../app/Auth/ApiTokens.js'
+import ApiPostController from '../app/Http/Controllers/Api/PostController.js'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+export function registerApiRoutes(router: Router): void {
+  const bearer = createBearerTokenMiddleware({ store: apiTokenStore })
+
+  // Mounted after `bearer`, so only authenticated requests reach the counter and it can key on the token.
+  const perToken = createRateLimitMiddleware({
+    limit: 60,
+    windowMs: 60_000,
+    keyPrefix: 'rl:api-token:',
+    keyGenerator: (ctx) => `token:${getApiToken(ctx)?.token.id ?? 'anonymous'}`,
+  })
+
+  router.group('/api/posts', (posts) => {
+    posts.middleware(bearer, perToken).group((authed) => {
+      authed.get('/', { name: 'api.posts.index' }, [ApiPostController, 'index'])
+      authed.post('/', { name: 'api.posts.store', body: PostPayloadSchema }, [ApiPostController, 'store'])
+    })
+  })
+}

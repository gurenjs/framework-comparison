+++ b/app/Auth/ApiTokens.ts
@@ -0,0 +1,15 @@
+import { DatabaseApiTokenStore } from '@guren/core'
+import { apiTokens } from '../../db/schema.js'
+
+export const apiTokenStore = new DatabaseApiTokenStore(apiTokens)
+
+export async function apiTokensForUser(userId: number) {
+  const tokens = await apiTokenStore.findByUserId(userId)
+
+  return tokens.map((token) => ({
+    id: token.id,
+    name: token.name,
+    createdAt: token.createdAt.toISOString(),
+    lastUsedAt: token.lastUsedAt?.toISOString() ?? null,
+  }))
+}

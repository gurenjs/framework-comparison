diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..8b2f532
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,137 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { getDatabase, resetDatabase } from '../config/database.js'
+import { apiTokens } from '../db/schema.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+
+interface CreatedToken {
+  id: string
+  name: string
+  token: string
+}
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'password123' })
+  })
+
+  async function createToken(name: string, user: UserRecord = author): Promise<CreatedToken> {
+    const csrf = await http.actingAs(user).withCsrf()
+    const response = await csrf.json().post('/profile/tokens', { name })
+    expect(response.status).toBe(201)
+    return (await response.json()) as CreatedToken
+  }
+
+  function bearer(token: string) {
+    return http.json().withHeader('Authorization', `Bearer ${token}`)
+  }
+
+  it('creates a token and stores only its hash', async () => {
+    const created = await createToken('CI')
+    const [, secret] = created.token.split('|')
+
+    expect(created.name).toBe('CI')
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+
+    type RawSelect = { select(): { from(table: typeof apiTokens): Promise<Record<string, unknown>[]> } }
+    const rows = await ((await getDatabase()) as RawSelect).select().from(apiTokens)
+    expect(rows).toHaveLength(1)
+    const columns = JSON.stringify(rows)
+    expect(columns.includes(secret)).toBe(false)
+    expect(columns.includes(created.token)).toBe(false)
+  })
+
+  it('rejects an empty or over-long token name without creating a token', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().post('/profile/tokens', { name: '   ' }).assertUnprocessable()
+    await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) }).assertUnprocessable()
+  })
+
+  it('authenticates bearer requests and creates posts as the token owner', async () => {
+    const other = await User.create({ name: 'Grace', email: 'grace@example.com', password: 'password123' })
+    const { token } = await createToken('CI')
+
+    await bearer(token).get('/api/posts').assertOk()
+
+    const created = await bearer(token)
+      .post('/api/posts', { title: 'Release', excerpt: 'Notes', body: 'Body', authorId: other.id })
+      .assertCreated()
+    const data = (await created.json<{ data: { authorId: number } }>()).data
+    expect(data.authorId).toBe(author.id)
+  })
+
+  it('answers 422 for invalid post input and creates nothing', async () => {
+    const { token } = await createToken('CI')
+
+    await bearer(token).post('/api/posts', { title: '', excerpt: 'Notes', body: 'Body' }).assertUnprocessable()
+    const list = await (await bearer(token).get('/api/posts')).json<{ data: unknown[] }>()
+    expect(list.data).toEqual([])
+  })
+
+  it('rejects missing, malformed, unknown and tampered tokens with 401', async () => {
+    const { token } = await createToken('CI')
+    const [id, secret] = token.split('|')
+
+    await http.json().get('/api/posts').assertUnauthorized()
+    await bearer('not-a-token').get('/api/posts').assertUnauthorized()
+    await bearer(`${id}|${secret}x`).get('/api/posts').assertUnauthorized()
+    await bearer(`unknown|${secret}`).get('/api/posts').assertUnauthorized()
+  })
+
+  it('lists posts from every author newest first', async () => {
+    const other = await User.create({ name: 'Grace', email: 'grace@example.com', password: 'password123' })
+    await Post.forceCreate({ title: 'Old', excerpt: 'e', body: 'b', authorId: author.id, createdAt: '2026-01-01T00:00:00.000Z' })
+    await Post.forceCreate({ title: 'New', excerpt: 'e', body: 'b', authorId: other.id, createdAt: '2026-02-01T00:00:00.000Z' })
+    const { token } = await createToken('CI')
+
+    const payload = await (await bearer(token).get('/api/posts')).json<{ data: { title: string; authorId: number }[] }>()
+    expect(payload.data.map((post) => post.title)).toEqual(['New', 'Old'])
+  })
+
+  it('revokes only the chosen token and stops it at once', async () => {
+    const first = await createToken('CI')
+    const second = await createToken('old laptop')
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${first.id}`).assertNoContent()
+
+    await bearer(first.token).get('/api/posts').assertUnauthorized()
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+
+  it('does not revoke another user\'s token', async () => {
+    const intruder = await User.create({ name: 'Eve', email: 'eve@example.com', password: 'password123' })
+    const created = await createToken('CI')
+
+    const csrf = await http.actingAs(intruder).withCsrf()
+    await csrf.json().delete(`/profile/tokens/${created.id}`).assertNotFound()
+
+    await bearer(created.token).get('/api/posts').assertOk()
+  })
+
+  it('limits each token to 60 requests a minute, separately per token', async () => {
+    const first = await createToken('CI')
+    const second = await createToken('old laptop')
+
+    for (let i = 0; i < 60; i++) {
+      await bearer(first.token).get('/api/posts').assertOk()
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    expect(limited.status).toBe(429)
+    const retryAfter = Number(limited.headers.get('Retry-After'))
+    expect(retryAfter).toBeGreaterThan(0)
+    expect(retryAfter).toBeLessThanOrEqual(60)
+
+    await bearer(second.token).get('/api/posts').assertOk()
+  })
+})

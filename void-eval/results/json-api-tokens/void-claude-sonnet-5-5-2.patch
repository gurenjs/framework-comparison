new file mode 100644
index 0000000..2fd7ee4
--- /dev/null
+++ b/routes/api/posts.ts
@@ -0,0 +1,36 @@
+import { defineHandler } from "void";
+import { posts } from "@schema";
+import { db, desc } from "void/db";
+import { authorizeApi } from "../../lib/api-tokens";
+import { selectPosts } from "../../lib/posts";
+import { postPayloadSchema } from "../../lib/validators";
+
+type ApiPost = { id: number; title: string; excerpt: string; authorId: string; createdAt: string };
+
+function present(p: ApiPost): ApiPost {
+  return { id: p.id, title: p.title, excerpt: p.excerpt, authorId: p.authorId, createdAt: p.createdAt };
+}
+
+export const GET = defineHandler(async (c) => {
+  const auth = await authorizeApi(c);
+  if (auth instanceof Response) return auth;
+  const rows = await selectPosts().orderBy(desc(posts.createdAt), desc(posts.id));
+  return c.json({ data: rows.map(present) });
+});
+
+export const POST = defineHandler(async (c) => {
+  const auth = await authorizeApi(c);
+  if (auth instanceof Response) return auth;
+
+  const raw = await c.req.json().catch(() => null);
+  const parsed = postPayloadSchema.safeParse(raw && typeof raw === "object" ? raw : {});
+  if (!parsed.success) {
+    return c.json({ error: "Validation failed", issues: parsed.error.issues.map((i) => ({ path: i.path.join("."), message: i.message })) }, 422);
+  }
+
+  const [post] = await db
+    .insert(posts)
+    .values({ ...parsed.data, authorId: auth.userId })
+    .returning();
+  return c.json({ data: present(post) }, 201);
+});
diff --git a/routes/profile/tokens.ts b/routes/profile/tokens.ts
new file mode 100644
index 0000000..966c887
--- /dev/null
+++ b/routes/profile/tokens.ts
@@ -0,0 +1,24 @@
+import { defineHandler } from "void";
+import { getUser } from "void/auth";
+import { apiTokens } from "@schema";
+import { db } from "void/db";
+import { generateToken, hashToken } from "../../lib/api-tokens";
+import { tokenNameSchema } from "../../lib/validators";
+
+export const POST = defineHandler(async (c) => {
+  const user = getUser();
+  if (!user) return c.json({ error: "Unauthorized" }, 401);
+
+  const raw = await c.req.json().catch(() => null);
+  const parsed = tokenNameSchema.safeParse(raw && typeof raw === "object" ? (raw as { name?: unknown }).name : undefined);
+  if (!parsed.success) {
+    return c.json({ error: "Validation failed", issues: [{ path: "name", message: parsed.error.issues[0].message }] }, 422);
+  }
+
+  const token = generateToken();
+  const [row] = await db
+    .insert(apiTokens)
+    .values({ userId: user.id, name: parsed.data, tokenHash: await hashToken(token) })
+    .returning({ id: apiTokens.id });
+  return c.json({ id: row.id, name: parsed.data, token }, 201);
+});
diff --git a/routes/profile/tokens/[id].ts b/routes/profile/tokens/[id].ts
new file mode 100644
index 0000000..bb767b3
--- /dev/null
+++ b/routes/profile/tokens/[id].ts
@@ -0,0 +1,20 @@
+import { defineHandler } from "void";
+import { getUser } from "void/auth";
+import { apiTokens } from "@schema";
+import { and, db, eq } from "void/db";
+import { postIdSchema } from "../../../lib/validators";
+
+export const DELETE = defineHandler(async (c) => {
+  const user = getUser();
+  if (!user) return c.json({ error: "Unauthorized" }, 401);
+
+  const id = postIdSchema.safeParse(c.req.param("id"));
+  if (!id.success) return c.json({ error: "Token not found" }, 404);
+
+  const deleted = await db
+    .delete(apiTokens)
+    .where(and(eq(apiTokens.id, id.data), eq(apiTokens.userId, user.id)))
+    .returning({ id: apiTokens.id });
+  if (deleted.length === 0) return c.json({ error: "Token not found" }, 404);
+  return c.body(null, 204);
+});

diff --git a/lib/api-tokens.ts b/lib/api-tokens.ts
new file mode 100644
index 0000000..1572518
--- /dev/null
+++ b/lib/api-tokens.ts
@@ -0,0 +1,69 @@
+import type { Context } from "hono";
+import { apiRateLimits, apiTokens } from "@schema";
+import { db, eq, lt, and, sql } from "void/db";
+
+export const RATE_LIMIT = 60;
+const WINDOW_SECONDS = 60;
+
+export type ApiAuth = { tokenId: number; userId: string };
+
+/** The database only ever sees this digest, never the token itself. */
+export async function hashToken(token: string): Promise<string> {
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(token));
+  return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+export function generateToken(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32));
+  let binary = "";
+  for (const b of bytes) binary += String.fromCharCode(b);
+  const encoded = btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+  return `vbt_${encoded}`;
+}
+
+function bearerToken(c: Context): string | null {
+  const match = /^Bearer +([^\s]+)$/i.exec(c.req.header("authorization")?.trim() ?? "");
+  return match ? match[1] : null;
+}
+
+/** Resolves the bearer token to its owner, or null when missing/unknown/revoked. */
+export async function authenticateToken(c: Context): Promise<ApiAuth | null> {
+  const token = bearerToken(c);
+  if (!token || token.length > 256) return null;
+  const [row] = await db
+    .select({ tokenId: apiTokens.id, userId: apiTokens.userId })
+    .from(apiTokens)
+    .where(eq(apiTokens.tokenHash, await hashToken(token)));
+  return row ?? null;
+}
+
+/**
+ * Authenticates and rate-limits an API request. Returns the token owner, or a
+ * JSON error response (401 / 429) to send back.
+ */
+export async function authorizeApi(c: Context): Promise<ApiAuth | Response> {
+  const auth = await authenticateToken(c);
+  if (!auth) {
+    return c.json({ error: "Unauthorized" }, 401, { "WWW-Authenticate": "Bearer" });
+  }
+
+  const nowSeconds = Math.floor(Date.now() / 1000);
+  const window = Math.floor(nowSeconds / WINDOW_SECONDS);
+  const [row] = await db
+    .insert(apiRateLimits)
+    .values({ tokenId: auth.tokenId, window, count: 1 })
+    .onConflictDoUpdate({
+      target: [apiRateLimits.tokenId, apiRateLimits.window],
+      set: { count: sql`${apiRateLimits.count} + 1` },
+    })
+    .returning({ count: apiRateLimits.count });
+
+  if (row.count === 1) {
+    await db.delete(apiRateLimits).where(and(eq(apiRateLimits.tokenId, auth.tokenId), lt(apiRateLimits.window, window)));
+  }
+  if (row.count > RATE_LIMIT) {
+    const retryAfter = Math.min(WINDOW_SECONDS, Math.max(1, (window + 1) * WINDOW_SECONDS - nowSeconds));
+    return c.json({ error: "Too many requests" }, 429, { "Retry-After": String(retryAfter) });
+  }
+  return auth;
+}

diff --git a/tests/PostScheduling.test.ts b/tests/PostScheduling.test.ts
new file mode 100644
index 0000000..d1002f8
--- /dev/null
+++ b/tests/PostScheduling.test.ts
@@ -0,0 +1,87 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
+const PAST = new Date(Date.now() - 60 * 60 * 1000).toISOString()
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let stranger: UserRecord
+  let scheduled: PostRecord
+  let published: PostRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+    const stamp = `${Date.now()}-${Math.random().toString(36).slice(2)}`
+    author = (await User.create({ name: 'Author', email: `author-${stamp}@example.test`, password: 'secret-pass' })) as UserRecord
+    stranger = (await User.create({ name: 'Stranger', email: `stranger-${stamp}@example.test`, password: 'secret-pass' })) as UserRecord
+    scheduled = (await Post.forceCreate({
+      title: `Scheduled ${stamp}`,
+      excerpt: 'soon',
+      body: 'later',
+      authorId: author.id,
+      publishedAt: FUTURE,
+    })) as PostRecord
+    published = (await Post.forceCreate({
+      title: `Published ${stamp}`,
+      excerpt: 'now',
+      body: 'now',
+      authorId: author.id,
+      publishedAt: PAST,
+    })) as PostRecord
+  })
+
+  it('hides a scheduled post page from guests and other users', async () => {
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(stranger).get(`/posts/${scheduled.id}`).assertNotFound()
+  })
+
+  it('shows a scheduled post page to its author with publishedAt', async () => {
+    const response = await http.actingAs(author).withHeader('X-Inertia', 'true').get(`/posts/${scheduled.id}`).assertOk()
+    const page = await response.json<{ component: string; props: { post: { publishedAt: string } } }>()
+    expect(page.component).toBe('posts/Show')
+    expect(page.props.post.publishedAt).toBe(FUTURE)
+  })
+
+  it('shows a past-dated post to guests', async () => {
+    await http.get(`/posts/${published.id}`).assertOk()
+  })
+
+  it('lists scheduled posts only for their author', async () => {
+    const guestHtml = await (await http.get('/posts').assertOk()).text()
+    expect(guestHtml).not.toContain(scheduled.title)

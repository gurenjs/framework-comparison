+  // ISO 8601 strings in UTC compare correctly as text.
+  static visibleTo(viewerId: number | null) {
+    const now = new Date().toISOString()
+    return Post.newQuery().where((q) => {
+      q.whereNull('publishedAt').orWhere('publishedAt', '<=', now)

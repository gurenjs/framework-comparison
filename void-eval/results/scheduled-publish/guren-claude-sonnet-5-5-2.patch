+import { describe, expect, it } from 'bun:test'
+import { PostPayloadSchema } from '../app/Http/Validators/PostValidator.js'
+
+const base = { title: 'T', excerpt: 'E', body: 'B' }
+
+describe('PostPayloadSchema publishAt', () => {
+  it('accepts an absent, null or ISO 8601 value', () => {
+    expect(PostPayloadSchema.safeParse(base).success).toBe(true)
+    expect(PostPayloadSchema.safeParse({ ...base, publishAt: null }).success).toBe(true)
+    expect(PostPayloadSchema.safeParse({ ...base, publishAt: '2026-10-01T09:00:00.000Z' }).success).toBe(true)
+  })
+
+  it('rejects a value that is not a date and time', () => {
+    expect(PostPayloadSchema.safeParse({ ...base, publishAt: 'next tuesday' }).success).toBe(false)
+  })
+})

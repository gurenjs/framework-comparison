--- /dev/null
+++ b/resources/js/lib/publish-at.ts
@@ -0,0 +1,17 @@
+// datetime-local inputs carry local wall-clock time without a zone, so the
+// conversions shift by the timezone offset to round-trip through UTC ISO strings.
+export function toPublishAtInput(iso: string | null): string {
+  if (iso === null) {
+    return ''
+  }
+  const date = new Date(iso)
+  return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16)
+}
+
+export function fromPublishAtInput(value: string): string | null {
+  return value === '' ? null : new Date(value).toISOString()
+}
+
+export function isScheduled(iso: string | null): boolean {
+  return iso !== null && new Date(iso).getTime() > Date.now()
+}

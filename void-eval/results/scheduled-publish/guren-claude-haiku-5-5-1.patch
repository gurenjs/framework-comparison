+              onChange={(event) => form.setData('publishAt', event.target.value)}
+              className={fieldClass}
+            />
+            <p className="mt-1 text-sm text-g-muted">Leave empty to publish as soon as it is saved.</p>
+            {form.errors.publishAt ? <p className="mt-1 text-sm text-g-danger">{form.errors.publishAt}</p> : null}
+          </div>
+
           <button
             type="submit"
             disabled={form.processing}

diff --git a/tests/PostScheduling.test.ts b/tests/PostScheduling.test.ts
new file mode 100644
index 0000000..4a72809
--- /dev/null
+++ b/tests/PostScheduling.test.ts
@@ -0,0 +1,95 @@
+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User } from '../app/Models/User.js'
+
+const FUTURE = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
+const PAST = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString()
+
+async function makeUser(email: string) {
+  return User.create({ name: email, email, password: 'secret-password' })
+}
+
+async function makePost(authorId: number, publishedAt: string | null, title = 'Post') {
+  return Post.forceCreate({ title, excerpt: 'excerpt', body: 'body', authorId, publishedAt })
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+  })
+
+  it('stores publishAt as a normalized UTC timestamp on create', async () => {
+    const author = await makeUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'Later', excerpt: 'Soon', body: 'Body', publishAt: FUTURE })
+      .assertRedirect()
+
+    const row = await Post.first({ title: 'Later' })
+    expect(row?.publishedAt).toBe(new Date(FUTURE).toISOString())
+  })
+
+  it('rejects a publishAt that is not a date and time', async () => {
+    const author = await makeUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .json()
+      .post('/posts', { title: 'Later', excerpt: 'Soon', body: 'Body', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+
+    expect(await Post.all()).toHaveLength(0)
+  })
+
+  it('hides a scheduled post from guests and other users but not its author', async () => {
+    const author = await makeUser('author@example.com')
+    const other = await makeUser('other@example.com')
+    const post = await makePost(author.id, FUTURE, 'Secret launch')
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+
+    const guestList = await http.get('/posts')
+    expect(await guestList.text()).not.toContain('Secret launch')
+    const authorList = await http.actingAs(author).get('/posts')
+    expect(await authorList.text()).toContain('Secret launch')
+
+    const guestSearch = await http.query('/posts/search', { keywords: ['Secret'] })
+    expect(await guestSearch.json()).toEqual({ data: [] })
+    const authorSearch = await http.actingAs(author).query('/posts/search', { keywords: ['Secret'] })
+    expect((await authorSearch.json<{ data: unknown[] }>()).data).toHaveLength(1)
+  })
+
+  it('shows a post to everyone once its time has passed, without any further action', async () => {
+    const author = await makeUser('author@example.com')
+    const post = await makePost(author.id, FUTURE, 'Becomes live')
+    await Post.forceUpdate({ id: post.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('updates and clears publishAt on edit', async () => {
+    const author = await makeUser('author@example.com')
+    const post = await makePost(author.id, null, 'Editable')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .json()
+      .put(`/posts/${post.id}`, { title: 'Editable', excerpt: 'excerpt', body: 'body', publishAt: FUTURE })
+      .assertRedirect()
+    expect((await Post.find(post.id))?.publishedAt).toBe(new Date(FUTURE).toISOString())
+
+    await csrf
+      .json()
+      .put(`/posts/${post.id}`, { title: 'Editable', excerpt: 'excerpt', body: 'body', publishAt: null })
+      .assertRedirect()
+    expect((await Post.find(post.id))?.publishedAt).toBeNull()
+  })
+})

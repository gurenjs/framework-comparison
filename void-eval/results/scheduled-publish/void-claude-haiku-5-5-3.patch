diff --git a/lib/publish-at.ts b/lib/publish-at.ts
new file mode 100644
index 0000000..d7b70a5
--- /dev/null
+++ b/lib/publish-at.ts
@@ -0,0 +1,11 @@
+/** ISO timestamp (UTC) to the `YYYY-MM-DDTHH:mm` value a datetime-local input shows in the viewer's time zone. */
+export function toLocalInputValue(iso: string | null | undefined): string {
+  if (!iso) return "";
+  const date = new Date(iso);
+  return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
+}
+
+/** datetime-local value in the viewer's time zone to an ISO timestamp (UTC); empty stays empty. */
+export function fromLocalInputValue(value: string): string {
+  return value ? new Date(value).toISOString() : "";
+}

+import { defineModel, type BelongsToRecord, type WhereGroupCallback } from '@guren/core'
 import { posts } from '../../db/schema.js'
 import type { UserRecord } from './User.js'
 
@@ -8,11 +8,24 @@ export type PostAuthorSummary = Pick<UserRecord, 'id' | 'name'>
 
 export class Post extends defineModel(posts, {
   // `authorId` is set from the signed-in user, never from request input.
-  fillable: ['title', 'excerpt', 'body'],
+  fillable: ['title', 'excerpt', 'body', 'publishedAt'],
 }) {
   static override relationTypes: { author: BelongsToRecord<PostAuthorSummary> } = {
     author: null,
   }
 }
 
+/**
+ * Where-group callback narrowing a query to what `viewerId` may see:
+ * unscheduled and already-live posts, plus the viewer's own. Time passing needs
+ * no job: the comparison runs against the clock on every read.
+ */
+export function publiclyVisible(viewerId: number | null): WhereGroupCallback<PostRecord> {
+  const now = new Date().toISOString()
+  return (q) => {
+    q.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+    if (viewerId !== null) q.orWhere('authorId', viewerId)
+  }
+}
+
 Post.belongsTo('author', () => import('./User.js').then((module) => module.User), 'authorId', 'id')

diff --git a/lib/schedule.ts b/lib/schedule.ts
new file mode 100644
index 0000000..adc6984
--- /dev/null
+++ b/lib/schedule.ts
@@ -0,0 +1,15 @@
+/** Turns a `datetime-local` value (the viewer's wall-clock time) into the UTC ISO text the server expects. */
+export function localInputToIso(value: string): string {
+  return value ? new Date(value).toISOString() : "";
+}
+
+/** Shows a stored UTC instant as a `datetime-local` value in the viewer's time zone. */
+export function isoToLocalInput(iso: string | null | undefined): string {
+  if (!iso) return "";
+  const date = new Date(iso);
+  return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
+}
+
+export function isScheduled(publishedAt: string | null): boolean {
+  return publishedAt !== null && new Date(publishedAt).getTime() > Date.now();
+}

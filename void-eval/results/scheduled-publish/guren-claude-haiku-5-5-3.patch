+import { beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const hourFromNow = () => new Date(Date.now() + 60 * 60 * 1000).toISOString()
+const hourAgo = () => new Date(Date.now() - 60 * 60 * 1000).toISOString()
+
+describe('scheduled posts', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeEach(async () => {
+    await resetDatabase()
+    http = await TestApp.fromApp(app)
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret-password' })
+    other = await User.create({ name: 'Other', email: 'other@example.com', password: 'secret-password' })
+  })
+
+  async function createPost(publishedAt: string | null) {
+    return Post.forceCreate({
+      title: 'Launch plan',
+      excerpt: 'Upcoming launch',
+      body: 'Body',
+      authorId: author.id,
+      publishedAt,
+    })
+  }
+
+  it('hides a scheduled post from guests and other users', async () => {
+    const post = await createPost(hourFromNow())
+
+    await http.get(`/posts/${post.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${post.id}`).assertNotFound()
+
+    expect(await (await http.get('/posts')).text()).not.toContain('Launch plan')
+    expect(await (await http.actingAs(other).get('/posts')).text()).not.toContain('Launch plan')
+
+    const search = await http.query('/posts/search', { keywords: ['Launch'] }).assertOk()
+    expect((await search.json<{ data: unknown[] }>()).data).toHaveLength(0)
+  })
+
+  it('shows a scheduled post to its author with the publish date', async () => {
+    const post = await createPost(hourFromNow())
+
+    await http.actingAs(author).get(`/posts/${post.id}`).assertOk()
+    expect(await (await http.actingAs(author).get('/posts')).text()).toContain('Launch plan')
+  })
+
+  it('makes a post public once its publish time has passed', async () => {
+    const post = await createPost(hourFromNow())
+    await Post.forceUpdate({ id: post.id }, { publishedAt: hourAgo() })
+
+    await http.get(`/posts/${post.id}`).assertOk()
+    expect(await (await http.get('/posts')).text()).toContain('Launch plan')
+  })
+
+  it('shows posts without a publish date to everyone', async () => {
+    const post = await createPost(null)
+
+    await http.get(`/posts/${post.id}`).assertOk()
+  })
+
+  it('rejects a publish date that is not a date and time', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.actingAs(author).json().post('/posts', {
+      title: 'Next',
+      excerpt: 'Next excerpt',
+      body: 'Body',
+      publishAt: 'next tuesday',
+    }).assertUnprocessable()
+
+    expect(await Post.first({ title: 'Next' })).toBeNull()
+  })
+
+  it('stores the publish date from the create request as an ISO timestamp', async () => {
+    const csrf = await http.withCsrf()
+    await csrf.actingAs(author).json().post('/posts', {
+      title: 'Next',
+      excerpt: 'Next excerpt',
+      body: 'Body',
+      publishAt: '2030-10-01T09:00:00.000Z',
+    })
+
+    const stored = await Post.first({ title: 'Next' })
+    expect(stored?.publishedAt).toBe('2030-10-01T09:00:00.000Z')
+  })
+})

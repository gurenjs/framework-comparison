+
+// A post with no publish date, or one whose date has passed, is public. Otherwise
+// only its author can see it. ISO 8601 UTC strings order the same as their instants.
+export function visibleTo(viewerId: number | null): WhereGroupCallback<PostRecord> {
+  const now = new Date().toISOString()
+  return (query) => {
+    query.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+    if (viewerId !== null) {
+      query.orWhere('authorId', viewerId)
+    }
+  }
+}
+
+export function isVisibleTo(post: Pick<PostRecord, 'authorId' | 'publishedAt'>, viewerId: number | null): boolean {
+  if (viewerId !== null && post.authorId === viewerId) {
+    return true
+  }
+  return post.publishedAt === null || new Date(post.publishedAt) <= new Date()
+}

diff --git a/durable-objects/api-token-limiter.ts b/durable-objects/api-token-limiter.ts
new file mode 100644
index 0000000..6628796
--- /dev/null
+++ b/durable-objects/api-token-limiter.ts
@@ -0,0 +1,24 @@
+import { defineDurableState } from "void/durable";
+
+// One instance per API token (ApiTokenLimiter.get(tokenId)): a fixed window
+// of `limit` requests per `windowMs`.
+export const ApiTokenLimiter = defineDurableState({
+  initialState: { windowStart: 0, count: 0 },
+  methods: {
+    hit(context, limit: number, windowMs: number) {
+      const now = Date.now();
+      if (now - context.state.windowStart >= windowMs) {
+        context.state.windowStart = now;
+        context.state.count = 0;
+      }
+      if (context.state.count >= limit) {
+        const retryAfterMs = context.state.windowStart + windowMs - now;
+        return { allowed: false, retryAfter: Math.max(1, Math.ceil(retryAfterMs / 1000)) };
+      }
+      context.state.count += 1;
+      return { allowed: true, retryAfter: 0 };
+    },
+  },
+});
+
+export default ApiTokenLimiter;
diff --git a/lib/api-tokens.ts b/lib/api-tokens.ts
new file mode 100644
index 0000000..9ec6612
--- /dev/null
+++ b/lib/api-tokens.ts
@@ -0,0 +1,92 @@
+import { apiTokens } from "@schema";
+import { and, db, desc, eq } from "void/db";
+import { defineMiddleware } from "void";
+import { users } from "./users";
+import { ApiTokenLimiter } from "../durable-objects/api-token-limiter";
+
+export interface ApiUser {
+  id: string;
+  name: string;
+  email: string;
+}
+
+declare module "void" {
+  interface CloudContextVariables {
+    apiUser: ApiUser;
+    apiTokenId: string;
+  }
+}
+
+const RATE_LIMIT = 60;
+const RATE_WINDOW_MS = 60_000;
+
+function toHex(bytes: ArrayBuffer | Uint8Array): string {
+  return [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+async function hashToken(token: string): Promise<string> {
+  return toHex(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(token)));
+}
+
+export interface CreatedApiToken {
+  id: string;
+  name: string;
+  token: string;
+}
+
+/** Creates a token for `userId`. The plain text is returned once and never stored. */
+export async function createApiToken(userId: string, name: string): Promise<CreatedApiToken> {
+  const id = crypto.randomUUID();
+  const token = toHex(crypto.getRandomValues(new Uint8Array(32)));
+  await db.insert(apiTokens).values({ id, name, userId, tokenHash: await hashToken(token) });
+  return { id, name, token };
+}
+
+/** The user's tokens for the profile page: names and dates, never the hash. */
+export function listApiTokens(userId: string) {
+  return db
+    .select({ id: apiTokens.id, name: apiTokens.name, lastUsedAt: apiTokens.lastUsedAt, createdAt: apiTokens.createdAt })
+    .from(apiTokens)
+    .where(eq(apiTokens.userId, userId))
+    .orderBy(desc(apiTokens.createdAt));
+}
+
+/** Deletes the token only if `userId` owns it; false when there is no such token of theirs. */
+export async function revokeApiToken(userId: string, id: string): Promise<boolean> {
+  const deleted = await db
+    .delete(apiTokens)
+    .where(and(eq(apiTokens.id, id), eq(apiTokens.userId, userId)))
+    .returning({ id: apiTokens.id });
+  return deleted.length > 0;
+}
+
+const unauthenticated = () => Response.json({ message: "Unauthenticated." }, { status: 401 });
+
+/** Authenticates the request by its `Authorization: Bearer <token>` header alone. */
+export const apiTokenAuth = defineMiddleware(async (c, next) => {
+  const match = /^Bearer\s+(\S+)\s*$/i.exec(c.req.header("Authorization") ?? "");
+  if (!match) return unauthenticated();
+  const [row] = await db
+    .select({ tokenId: apiTokens.id, id: users.id, name: users.name, email: users.email })
+    .from(apiTokens)
+    .innerJoin(users, eq(users.id, apiTokens.userId))
+    .where(eq(apiTokens.tokenHash, await hashToken(match[1])));
+  if (!row) return unauthenticated();
+
+  await db.update(apiTokens).set({ lastUsedAt: new Date().toISOString() }).where(eq(apiTokens.id, row.tokenId));
+  c.set("apiTokenId", row.tokenId);
+  c.set("apiUser", { id: row.id, name: row.name, email: row.email });
+  await next();
+});
+
+/** 60 requests per minute per token. Runs after apiTokenAuth, which sets the token id. */
+export const apiTokenRateLimit = defineMiddleware(async (c, next) => {
+  const { allowed, retryAfter } = await ApiTokenLimiter.get(c.get("apiTokenId")).hit(RATE_LIMIT, RATE_WINDOW_MS);
+  if (!allowed) {
+    return Response.json(
+      { message: "Too many requests." },
+      { status: 429, headers: { "Retry-After": String(retryAfter) } },
+    );
+  }
+  await next();
+});

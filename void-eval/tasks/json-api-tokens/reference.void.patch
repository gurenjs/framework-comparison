--- /dev/null
+++ b/routes/api/posts.ts
@@ -0,0 +1,36 @@
+import { posts } from "@schema";
+import { defineHandler } from "void";
+import { db, desc } from "void/db";
+import { apiTokenAuth, apiTokenRateLimit } from "../../lib/api-tokens";
+import { postPayloadSchema } from "../../lib/validators";
+
+const apiPostColumns = {
+  id: posts.id,
+  title: posts.title,
+  excerpt: posts.excerpt,
+  authorId: posts.authorId,
+  createdAt: posts.createdAt,
+};
+
+function toApiPost(post: { id: number; title: string; excerpt: string; authorId: string; createdAt: string }) {
+  return { ...post, createdAt: new Date(post.createdAt).toISOString() };
+}
+
+// GET /api/posts: every post, newest first.
+export const GET = defineHandler(apiTokenAuth, apiTokenRateLimit, async () => {
+  const rows = await db.select(apiPostColumns).from(posts).orderBy(desc(posts.createdAt), desc(posts.id));
+  return { data: rows.map(toApiPost) };
+});
+
+// POST /api/posts: created as the token's owner; any authorId in the body is ignored.
+export const POST = defineHandler(
+  apiTokenAuth,
+  apiTokenRateLimit,
+  defineHandler.withValidator({ body: postPayloadSchema })(async (c, { body }) => {
+    const [post] = await db
+      .insert(posts)
+      .values({ ...body, authorId: c.get("apiUser").id })
+      .returning(apiPostColumns);
+    return c.json({ data: toApiPost(post) }, 201);
+  }),
+);

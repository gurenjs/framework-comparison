+      router.refresh();
+    } catch (e) {
+      if (!(e instanceof FetchError)) throw e;
+      setError("Enter a name of 1 to 50 characters.");
+    }
+  }
+
+  async function revokeToken(id: string) {
+    await fetch("/profile/tokens/:id", { method: "DELETE", params: { id } });
+    router.refresh();
+  }
+
+  return (
+    <section>
+      <h2>API tokens</h2>
+      <p>Scripts send a token with each request to read and write posts as you.</p>
+      {created && (
+        <p>
+          Copy the token for {created.name} now. It is not shown again: <code>{created.token}</code>
+        </p>
+      )}
+      <form onSubmit={createToken}>
+        <label>
+          Token name <input value={name} onChange={(e) => setName(e.target.value)} />
+        </label>
+        <button>Create token</button>
+      </form>
+      {error && <p className="error">{error}</p>}
+      <ul>
+        {tokens.map((token) => (
+          <li key={token.id}>
+            {token.name} {token.lastUsedAt ? `(last used ${new Date(token.lastUsedAt).toLocaleString()})` : "(never used)"}{" "}
+            <button type="button" onClick={() => revokeToken(token.id)}>
+              Revoke
+            </button>
+          </li>
+        ))}
+      </ul>
     </section>
   );
 }

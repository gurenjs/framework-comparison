+++ b/routes/profile/tokens/[id].ts
@@ -0,0 +1,13 @@
+import { HTTPException } from "hono/http-exception";
+import { defineHandler } from "void";
+import { requireAuth } from "void/auth";
+import { revokeApiToken } from "../../../lib/api-tokens";
+
+// DELETE /profile/tokens/:id: only the owner may revoke; anyone else gets 404.
+export const DELETE = defineHandler(async (c) => {
+  const user = requireAuth(c);
+  if (!(await revokeApiToken(user.id, c.req.param("id") ?? ""))) {
+    throw new HTTPException(404, { message: "API token not found." });
+  }
+  return null;
+});

diff --git a/lib/comments.ts b/lib/comments.ts
new file mode 100644
index 0000000..9a1dff0
--- /dev/null
+++ b/lib/comments.ts
@@ -0,0 +1,58 @@
+import { HTTPException } from "hono/http-exception";
+import { commentReports, comments, posts } from "@schema";
+import { and, asc, count, db, eq, gte, notInArray } from "void/db";
+import type { AuthUser } from "void/auth";
+import { users } from "./users";
+import { commentIdSchema } from "./validators";
+
+/** A comment reported by this many different users is hidden from the post page. */
+export const HIDE_AFTER_REPORTS = 3;
+
+/** The post's visible comments, oldest first, each with its author. */
+export function visibleComments(postId: number) {
+  const hidden = db
+    .select({ commentId: commentReports.commentId })
+    .from(commentReports)
+    .groupBy(commentReports.commentId)
+    .having(gte(count(), HIDE_AFTER_REPORTS));
+  return db
+    .select({
+      id: comments.id,
+      body: comments.body,
+      createdAt: comments.createdAt,
+      author: { id: users.id, name: users.name },
+    })
+    .from(comments)
+    .innerJoin(users, eq(users.id, comments.userId))
+    .where(and(eq(comments.postId, postId), notInArray(comments.id, hidden)))
+    .orderBy(asc(comments.createdAt), asc(comments.id));
+}
+
+export type CommentWithAuthor = Awaited<ReturnType<typeof visibleComments>>[number];
+
+/** Parses the `[id]` route param; anything that is not a positive integer is a 404. */
+export function parseCommentId(raw: string | undefined): number {
+  const parsed = commentIdSchema.safeParse(raw);
+  if (!parsed.success) throw new HTTPException(404, { message: "Comment not found" });
+  return parsed.data;
+}
+
+/** The comment with the author of the post it is on. */
+export async function findCommentOrFail(id: number) {
+  const [comment] = await db
+    .select({ id: comments.id, postId: comments.postId, userId: comments.userId, postAuthorId: posts.authorId })
+    .from(comments)
+    .innerJoin(posts, eq(posts.id, comments.postId))
+    .where(eq(comments.id, id));
+  if (!comment) throw new HTTPException(404, { message: "Comment not found" });
+  return comment;
+}
+
+export function canDeleteComment(user: { id: string } | null, comment: { userId: string; postAuthorId: string }): boolean {
+  return !!user && (comment.userId === user.id || comment.postAuthorId === user.id);
+}
+
+/** Only the comment's author or the post's author may delete a comment. */
+export function authorizeCommentDelete(user: AuthUser, comment: { userId: string; postAuthorId: string }): void {
+  if (!canDeleteComment(user, comment)) throw new HTTPException(403, { message: "Forbidden" });
+}

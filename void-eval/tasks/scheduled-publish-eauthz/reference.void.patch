+/** `<input type="datetime-local">` value (local time) for an ISO instant. */
+function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return "";
+  const date = new Date(iso);
+  const pad = (n: number) => String(n).padStart(2, "0");
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
+}
+
+/** True while a post's publish date lies in the future. */
+export function isScheduled(publishedAt: string | null | undefined): boolean {
+  return publishedAt ? new Date(publishedAt).getTime() > Date.now() : false;
+}
+
+/** The "Publish at" field: holds an ISO 8601 UTC instant, or null for "publish now". */
+export default function PublishAtField({
+  value,
+  onChange,
+  error,
+}: {
+  value: string | null | undefined;
+  onChange: (value: string | null) => void;
+  error?: string;
+}) {
+  return (
+    <>
+      <label>
+        Publish at{" "}
+        <input
+          type="datetime-local"
+          value={toLocalInput(value)}
+          onChange={(e) => onChange(e.target.value ? new Date(e.target.value).toISOString() : null)}
+        />{" "}
+        <small>Leave empty to publish now.</small>
+      </label>
+      {error && <p className="error">{error}</p>}
+    </>
+  );
+}

index 0000000..8522ad8
--- /dev/null
+++ b/src/components/TagLinks.tsx
@@ -0,0 +1,15 @@
+import { Link } from "@void/react";
+
+/** Each tag links to the posts list filtered by it, on the first page. */
+export default function TagLinks({ tags }: { tags: string[] }) {
+  if (tags.length === 0) return null;
+  return (
+    <ul className="tags">
+      {tags.map((tag) => (
+        <li key={tag}>
+          <Link href="/posts" data={{ tag }}>#{tag}</Link>
+        </li>
+      ))}
+    </ul>
+  );
+}

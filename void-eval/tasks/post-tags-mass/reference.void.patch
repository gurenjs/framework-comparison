diff --git a/lib/tags.ts b/lib/tags.ts
new file mode 100644
index 0000000..1a76737
--- /dev/null
+++ b/lib/tags.ts
@@ -0,0 +1,46 @@
+import { postTags, tags } from "@schema";
+import { asc, db, eq, inArray } from "void/db";
+
+/** Tag names per post id, each list sorted alphabetically; posts without tags are absent. */
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const byPost = new Map<number, string[]>();
+  if (postIds.length === 0) return byPost;
+  const rows = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, postIds))
+    .orderBy(asc(tags.name));
+  for (const row of rows) byPost.set(row.postId, [...(byPost.get(row.postId) ?? []), row.name]);
+  return byPost;
+}
+
+/** Adds `tags: string[]` to each post. */
+export async function withTags<T extends { id: number }>(list: T[]): Promise<Array<T & { tags: string[] }>> {
+  const byPost = await tagNamesByPost(list.map((post) => post.id));
+  return list.map((post) => ({ ...post, tags: byPost.get(post.id) ?? [] }));
+}
+
+/** Ids of the posts carrying the tag `name`, as a subquery for `inArray(posts.id, …)`. */
+export function postIdsTagged(name: string) {
+  return db
+    .select({ id: postTags.postId })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(eq(tags.name, name));
+}
+
+/** Makes `names` the post's tags exactly: unknown names become tags, missing ones are detached. */
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const detach = db.delete(postTags).where(eq(postTags.postId, postId));
+  if (names.length === 0) {
+    await detach;
+    return;
+  }
+  await db
+    .insert(tags)
+    .values(names.map((name) => ({ name })))
+    .onConflictDoNothing({ target: tags.name });
+  const found = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names));
+  await db.batch([detach, db.insert(postTags).values(found.map((tag) => ({ postId, tagId: tag.id })))]);
+}

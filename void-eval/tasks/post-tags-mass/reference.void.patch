 import { z } from "zod";
 
+export const TAG_NAME_MAX = 30;
+export const TAGS_PER_POST_MAX = 5;
+
+/** " bun ,bun,,webdev" -> ["bun", "webdev"]: trimmed, blanks dropped, duplicates counted once. */
+function parseTagList(raw: string): string[] {
+  const names = raw
+    .split(",")
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0);
+  return [...new Set(names)];
+}
+
+// The form sends one comma-separated string; the action receives the parsed list.
+export const tagListSchema = z
+  .string()
+  .default("")
+  .transform(parseTagList)
+  .refine((names) => names.every((name) => name.length <= TAG_NAME_MAX), `Each tag must be ${TAG_NAME_MAX} characters or fewer.`)
+  .refine((names) => names.length <= TAGS_PER_POST_MAX, `Use at most ${TAGS_PER_POST_MAX} tags.`);
+
 export const postPayloadSchema = z.object({
   title: z.string().trim().min(1, "Title is required.").max(255, "Title must be 255 characters or fewer."),
   excerpt: z.string().trim().min(1, "Excerpt is required.").max(500, "Excerpt must be 500 characters or fewer."),
   body: z.string().trim().min(1, "Body is required."),
-  authorId: z.string().optional(),

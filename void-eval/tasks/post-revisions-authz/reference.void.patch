+++ b/pages/posts/[id]/revisions.server.ts
@@ -0,0 +1,14 @@
+import { defineHandler, type InferProps } from "void";
+import { authorizeAuthor, findPostOrFail, parsePostId } from "../../../lib/posts";
+import { userOrRedirect } from "../../../lib/guards";
+import { listRevisions } from "../../../lib/revisions";
+
+export type Props = InferProps<typeof loader>;
+
+export const loader = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const post = await findPostOrFail(parsePostId(c.req.param("id")));
+  authorizeAuthor(user, post);
+  return { post: { id: post.id, title: post.title }, revisions: await listRevisions(post.id) };
+});
diff --git a/pages/posts/[id]/revisions.tsx b/pages/posts/[id]/revisions.tsx
new file mode 100644
index 0000000..18e009a
--- /dev/null
+++ b/pages/posts/[id]/revisions.tsx
@@ -0,0 +1,32 @@
+import { Link } from "@void/react";
+import type { Props } from "./revisions.server";
+
+export default function PostRevisions({ post, revisions }: Props) {
+  async function restore(revisionId: number) {
+    if (!confirm("Restore this version? The current one is kept as a revision.")) return;
+    const res = await fetch(`/posts/${post.id}/revisions/${revisionId}/restore`, { method: "POST" });
+    window.location.href = res.redirected ? res.url : `/posts/${post.id}`;
+  }
+
+  return (
+    <section>
+      <h1>Revisions</h1>
+      <p>Earlier versions of “{post.title}”, newest first.</p>
+      {revisions.length === 0 ? (
+        <p>No earlier versions yet.</p>
+      ) : (
+        <ul>
+          {revisions.map((revision) => (
+            <li key={revision.id}>
+              <strong>{revision.title}</strong> <small>{new Date(revision.createdAt).toLocaleString()}</small>{" "}
+              <button type="button" onClick={() => restore(revision.id)}>Restore</button>
+            </li>
+          ))}
+        </ul>
+      )}
+      <p>
+        <Link href={`/posts/${post.id}`}>← Back to post</Link>
+      </p>
+    </section>
+  );
+}
diff --git a/routes/posts/[id]/revisions/[revisionId]/restore.ts b/routes/posts/[id]/revisions/[revisionId]/restore.ts
new file mode 100644
index 0000000..375ef81
--- /dev/null
+++ b/routes/posts/[id]/revisions/[revisionId]/restore.ts
@@ -0,0 +1,16 @@
+import { defineHandler } from "void";
+import { authorizeAuthor, findPostOrFail, parsePostId } from "../../../../../lib/posts";
+import { userOrRedirect } from "../../../../../lib/guards";
+import { findRevisionOrFail, updateKeepingRevision } from "../../../../../lib/revisions";
+
+// POST /posts/:id/revisions/:revisionId/restore: put a revision back on the
+// post. Restoring is an edit, so the pre-restore version is kept as well.
+export const POST = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const post = await findPostOrFail(parsePostId(c.req.param("id")));
+  authorizeAuthor(user, post);
+  const revision = await findRevisionOrFail(post.id, parsePostId(c.req.param("revisionId")));
+  await updateKeepingRevision(post, revision);
+  return c.redirect(`/posts/${post.id}`);
+});

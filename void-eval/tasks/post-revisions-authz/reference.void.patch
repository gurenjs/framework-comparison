diff --git a/lib/revisions.ts b/lib/revisions.ts
new file mode 100644
index 0000000..0f84888
--- /dev/null
+++ b/lib/revisions.ts
@@ -0,0 +1,36 @@
+import { HTTPException } from "hono/http-exception";
+import { postRevisions, posts } from "@schema";
+import { and, db, desc, eq } from "void/db";
+
+type PostContent = { title: string; excerpt: string; body: string };
+
+/**
+ * Replace a post's title, excerpt and body, keeping the version it had
+ * before as a revision. D1 has no transactions; one batch runs both
+ * statements atomically.
+ */
+export async function updateKeepingRevision(post: { id: number } & PostContent, next: PostContent) {
+  await db.batch([
+    db.insert(postRevisions).values({ postId: post.id, title: post.title, excerpt: post.excerpt, body: post.body }),
+    db.update(posts).set({ title: next.title, excerpt: next.excerpt, body: next.body }).where(eq(posts.id, post.id)),
+  ]);
+}
+
+/** A post's revisions, newest first. */
+export function listRevisions(postId: number) {
+  return db
+    .select({ id: postRevisions.id, title: postRevisions.title, createdAt: postRevisions.createdAt })
+    .from(postRevisions)
+    .where(eq(postRevisions.postId, postId))
+    .orderBy(desc(postRevisions.createdAt), desc(postRevisions.id));
+}
+
+/** A revision of this post; a revision of any other post is a 404. */
+export async function findRevisionOrFail(postId: number, revisionId: number) {
+  const [revision] = await db
+    .select()
+    .from(postRevisions)
+    .where(and(eq(postRevisions.id, revisionId), eq(postRevisions.postId, postId)));
+  if (!revision) throw new HTTPException(404, { message: "Revision not found" });
+  return revision;
+}

diff --git a/app/Services/PostTags.ts b/app/Services/PostTags.ts
new file mode 100644
index 0000000..3b7a2e8
--- /dev/null
+++ b/app/Services/PostTags.ts
@@ -0,0 +1,61 @@
+import { PostTag } from '../Models/PostTag.js'
+import { Tag } from '../Models/Tag.js'
+
+/** Attaches `tags: string[]` (sorted names) to each post and returns the same posts. */
+export async function loadTags<T extends { id: number }>(posts: T[]): Promise<Array<T & { tags: string[] }>> {
+  const byPost = new Map<number, string[]>()
+
+  if (posts.length > 0) {
+    const links = await PostTag.newQuery()
+      .whereIn(
+        'postId',
+        posts.map((post) => post.id),
+      )
+      .get()
+    const tags = links.length
+      ? await Tag.newQuery()
+          .whereIn(
+            'id',
+            links.map((link) => link.tagId),
+          )
+          .get()
+      : []
+    const nameById = new Map(tags.map((tag) => [tag.id, tag.name]))
+
+    for (const link of links) {
+      const name = nameById.get(link.tagId)
+      if (name === undefined) continue
+      byPost.set(link.postId, [...(byPost.get(link.postId) ?? []), name])
+    }
+  }
+
+  return posts.map((post) =>
+    Object.assign(post, { tags: (byPost.get(post.id) ?? []).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)) }),
+  )
+}
+
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const tag = await Tag.first({ name })
+  if (!tag) return []
+
+  const links = await PostTag.newQuery().where('tagId', tag.id).get()
+  return links.map((link) => link.postId)
+}
+
+/** Makes the post's tags exactly `names`, creating unknown tags. */
+export async function syncTags(postId: number, names: string[]): Promise<void> {
+  const tagIds: number[] = []
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    tagIds.push(tag.id)
+  }
+
+  await PostTag.delete({ postId })
+  for (const tagId of tagIds) {
+    await PostTag.create({ postId, tagId })
+  }
+}
+
+export async function detachAll(postId: number): Promise<void> {
+  await PostTag.delete({ postId })
+}

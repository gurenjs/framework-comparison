diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..9cf94c2
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,67 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const base = { title: 'Hello', excerpt: 'Short', body: 'Body' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let user: UserRecord
+  let csrf: TestApp
+  let inertia: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = (await User.forceCreate({ name: 'A', email: 'a@example.com', password: 'secret' })) as UserRecord
+    csrf = await http.actingAs(user).withCsrf()
+    inertia = http.withHeader('X-Inertia', 'true')
+  })
+
+  async function tagNames(): Promise<string[]> {
+    return (await Tag.newQuery().get()).map((tag) => tag.name).sort()
+  }
+
+  async function showTags(id: number): Promise<string[]> {
+    const page = await (await inertia.get(`/posts/${id}`)).json<{ props: { post: { tags: string[] } } }>()
+    return page.props.post.tags
+  }
+
+  it('creates, edits and shows tags', async () => {
+    await csrf.post('/posts', { ...base, tags: 'bun, webdev' }).assertRedirect()
+    const [post] = await Post.newQuery().get()
+    expect(await tagNames()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(2)
+
+    expect(await showTags(post.id)).toEqual(['bun', 'webdev'])
+
+    await csrf.put(`/posts/${post.id}`, { ...base, tags: 'bun' }).assertRedirect()
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(1)
+    expect(await showTags(post.id)).toEqual(['bun'])
+
+    const hit = await (await inertia.get('/posts?tag=bun')).json<{ props: { data: unknown[] } }>()
+    expect(hit.props.data).toHaveLength(1)
+    const miss = await (await inertia.get('/posts?tag=nope')).json<{ props: { data: unknown[] } }>()
+    expect(miss.props.data).toHaveLength(0)
+
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+  })
+
+  it('normalizes and validates the field', async () => {
+    await csrf.post('/posts', { ...base, tags: ' bun ,bun,,' }).assertRedirect()
+    expect(await PostTag.newQuery().count()).toBe(1)
+
+    await csrf.post('/posts', { ...base, tags: 'a,b,c,d,e,f' }).assertUnprocessable()
+    await csrf.post('/posts', { ...base, tags: 'x'.repeat(31) }).assertUnprocessable()
+    expect(await Post.newQuery().count()).toBe(1)
+    await csrf.post('/posts', { ...base, tags: 'x'.repeat(30) }).assertRedirect()
+  })
+})

diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..b5a3083
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,64 @@
+import { beforeAll, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { migrateDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const U = `t${Date.now()}`
+const payload = (tags?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    await migrateDatabase()
+    http = await TestApp.fromApp(app)
+    author = await User.create({
+      name: 'Tagger',
+      email: `tagger-${Date.now()}@example.com`,
+      password: 'secret',
+    })
+  })
+
+  async function tagNames(postId: number): Promise<string[]> {
+    const links = await PostTag.where({ postId }).get()
+    const names: string[] = []
+    for (const link of links) names.push((await Tag.findOrFail(link.tagId)).name)
+    return names.sort()
+  }
+
+  it('creates, edits and filters by tag', async () => {
+    const actor = await http.actingAs(author).withCsrf()
+    await actor.post('/posts', payload(`${U}, webdev`)).assertStatus(303)
+    const post = (await Post.where({ authorId: author.id }).orderBy('id', 'desc').first())!
+    expect(await tagNames(post.id)).toEqual([U, 'webdev'].sort())
+
+    const inertia = http.withHeader('X-Inertia', 'true').withHeader('X-Inertia-Version', '')
+    const listed = await (await inertia.get(`/posts?tag=${U}`)).json<{ props: { data: { id: number; tags: string[] }[] } }>()
+    expect(listed.props.data.map((row) => row.id)).toEqual([post.id])
+    expect(listed.props.data[0]!.tags).toEqual([U, 'webdev'].sort())
+    const none = await (await inertia.get('/posts?tag=nobody-uses-this')).json<{ props: { data: unknown[] } }>()
+    expect(none.props.data).toEqual([])
+    await actor.put(`/posts/${post.id}`, payload(U)).assertStatus(303)
+    expect(await tagNames(post.id)).toEqual([U])
+
+    await actor.put(`/posts/${post.id}`, payload(` ${U} ,${U},`)).assertStatus(303)
+    expect(await tagNames(post.id)).toEqual([U])
+
+    await actor.delete(`/posts/${post.id}`).assertStatus(303)
+    expect(await Post.where({ id: post.id }).count()).toBe(0)
+  })
+
+  it('refuses invalid tag input', async () => {
+    const actor = await http.actingAs(author).withCsrf()
+    const before = await Post.newQuery().count()
+    await actor.json().post('/posts', payload('a,b,c,d,e,f')).assertStatus(422)
+    await actor.json().post('/posts', payload('x'.repeat(31))).assertStatus(422)
+    expect(await Post.newQuery().count()).toBe(before)
+    await actor.json().post('/posts', payload('x'.repeat(30))).assertStatus(303)
+  })
+})

diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..61d4208
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,68 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+  let csrf: TestApp
+
+  const payload = (tags?: string) => ({ title: 'T', excerpt: 'E', body: 'B', ...(tags === undefined ? {} : { tags }) })
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'A', email: 'a@example.com', password: 'secret-pass' })
+    csrf = await http.actingAs(author).withCsrf()
+  })
+
+  async function showTags(id: number): Promise<string[]> {
+    const res = await http.json().get(`/posts/${id}`)
+    return (await res.json<{ props: { post: { tags: string[] } } }>()).props.post.tags
+  }
+
+  it('creates, trims and dedupes tags, then syncs them on update', async () => {
+    await csrf.post('/posts', payload(' bun ,bun, webdev,')).assertRedirect()
+    const [post] = await Post.newQuery().get()
+    expect(await Tag.newQuery().count()).toBe(2)
+    expect(await PostTag.where({ postId: post!.id }).count()).toBe(2)
+    expect(await showTags(post!.id)).toEqual(['bun', 'webdev'])
+
+    await csrf.put(`/posts/${post!.id}`, payload('bun')).assertRedirect()
+    expect(await PostTag.where({ postId: post!.id }).count()).toBe(1)
+    expect(await showTags(post!.id)).toEqual(['bun'])
+
+    await csrf.delete(`/posts/${post!.id}`).assertRedirect('/posts')
+    expect(await PostTag.newQuery().count()).toBe(0)
+  })
+
+  it('filters the list by tag', async () => {
+    await csrf.post('/posts', payload('bun')).assertRedirect()
+    await csrf.post('/posts', payload('other')).assertRedirect()
+
+    const res = await http.json().get('/posts?tag=bun')
+    const body = await res.json<{ props: { data: { tags: string[] }[] } }>()
+    expect(body.props.data.map((p) => p.tags)).toEqual([['bun']])
+
+    const none = await http.json().get('/posts?tag=nope')
+    expect((await none.json<{ props: { data: unknown[] } }>()).props.data).toEqual([])
+  })
+
+  it('refuses too many or too long tags and writes nothing', async () => {
+    await csrf.post('/posts', payload('a,b,c,d,e,f')).assertStatus(422)
+    await csrf.post('/posts', payload('x'.repeat(31))).assertStatus(422)
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+
+    await csrf.post('/posts', payload('x'.repeat(30))).assertRedirect()
+    expect(await Tag.newQuery().count()).toBe(1)
+  })
+})

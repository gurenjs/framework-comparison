+export const MAX_TAGS = 5
+export const MAX_TAG_LENGTH = 30
+
+// Comma-separated names → unique, trimmed, non-empty names. Every rule failure
+// is reported on the `tags` field itself, not on an array index.
+export function parseTags(raw: string | string[] | undefined): string[] {
+  const parts = Array.isArray(raw) ? raw : (raw ?? '').split(',')
+  return [...new Set(parts.map((name) => name.trim()).filter((name) => name !== ''))]
+}
+
+export const TagsFieldSchema = z
+  .string()
+  .optional()
+  .transform((raw, ctx) => {
+    const names = parseTags(raw)
+    if (names.some((name) => name.length > MAX_TAG_LENGTH)) {
+      ctx.addIssue({ code: 'custom', message: `Each tag must be ${MAX_TAG_LENGTH} characters or fewer.` })
+      return z.NEVER
+    }
+    if (names.length > MAX_TAGS) {
+      ctx.addIssue({ code: 'custom', message: `Use at most ${MAX_TAGS} tags.` })
+      return z.NEVER
+    }
+    return names
+  })
+
 export const PostPayloadSchema = z.object({
+  tags: TagsFieldSchema,
   title: z.string().trim().min(1, 'Title is required.').max(255, 'Title must be 255 characters or fewer.'),

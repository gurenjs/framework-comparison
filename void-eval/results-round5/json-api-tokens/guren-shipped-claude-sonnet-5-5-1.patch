@@ -0,0 +1,31 @@
+import { Controller } from '@guren/core'
+import { Post, type PostRecord } from '../../Models/Post.js'
+import { PostResource } from '../Resources/PostResource.js'
+import { PostPayloadSchema } from '../Validators/PostValidator.js'
+import { API_TOKEN_USER_ID_KEY } from '../Middleware/ApiTokenAuth.js'
+
+function summary(post: PostRecord) {
+  const { id, title, excerpt, authorId, createdAt } = new PostResource(post).toJSON()
+  return { id, title, excerpt, authorId, createdAt }
+}
+
+export default class ApiPostController extends Controller {
+  async index(): Promise<Response> {
+    const posts = await Post.newQuery().orderBy('id', 'desc').get()
+
+    return this.json({ data: posts.map(summary) })
+  }
+
+  // guren-audit-ignore: apiTokenAuth authenticates the token's owner, and any token holder may create posts as themselves
+  async store(): Promise<Response> {
+    const authorId = this.ctx.get(API_TOKEN_USER_ID_KEY) as number
+    const data = await this.validateBody(PostPayloadSchema)
+    // `authorId` comes from the token's owner, never from the request body.
+    const post = await Post.create(data, { set: { authorId } })
+    if (!post) {
+      return this.json({ message: 'Post could not be created.' }, { status: 500 })
+    }
+
+    return this.json({ data: summary(post) }, { status: 201 })
+  }
+}
diff --git a/app/Http/Controllers/ApiTokenController.ts b/app/Http/Controllers/ApiTokenController.ts
new file mode 100644
index 0000000..fa8f0e1
--- /dev/null
+++ b/app/Http/Controllers/ApiTokenController.ts
@@ -0,0 +1,31 @@
+import { randomBytes } from 'node:crypto'
+import { Controller, HttpException } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+import type { UserRecord } from '../../Models/User.js'
+import { hashApiToken } from '../Middleware/ApiTokenAuth.js'
+
+export default class ApiTokenController extends Controller {
+  async store(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { body } = this.validated('profile.tokens.store')
+    const plain = randomBytes(32).toString('hex')
+    const token = await ApiToken.create(body, {
+      set: { userId: user.id, tokenHash: hashApiToken(plain) },
+    })
+
+    return this.json({ id: token?.id, name: body.name, token: plain }, { status: 201 })
+  }
+
+  async destroy(): Promise<Response> {
+    const user = await this.auth.userOrFail<UserRecord>()
+    const { id } = this.validated('profile.tokens.destroy').params
+    const token = await ApiToken.first({ id, userId: user.id })
+    if (!token) {
+      throw HttpException.notFound()
+    }
+
+    await ApiToken.delete({ id: token.id })
+
+    return new Response(null, { status: 204 })
+  }
+}

diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..1968efa
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,45 @@
+import { createHash } from 'node:crypto'
+import { createRateLimitMiddleware, readBearerToken } from '@guren/core'
+import type { Context, Middleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_TOKEN_USER_ID_KEY = 'apiTokenUserId'
+
+export function hashApiToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex')
+}
+
+const unauthenticated = (ctx: Context) => ctx.json({ message: 'Unauthenticated.' }, 401)
+
+// Built on the first request: the default store starts a sweep timer, which
+// Cloudflare Workers refuses while a module is being evaluated.
+let limiter: Middleware | undefined
+
+/**
+ * Authenticates `Authorization: Bearer <token>` against the stored hash, then
+ * allows 60 requests a minute per token. The default store is in process memory.
+ */
+export const apiTokenAuth: Middleware = async (ctx, next) => {
+  const plain = readBearerToken(ctx.req.header('Authorization'))
+  if (!plain) {
+    return unauthenticated(ctx)
+  }
+
+  const token = await ApiToken.first({ tokenHash: hashApiToken(plain) })
+  if (!token) {
+    return unauthenticated(ctx)
+  }
+
+  ctx.set(API_TOKEN_USER_ID_KEY, token.userId)
+
+  limiter ??= createRateLimitMiddleware({
+    limit: 60,
+    windowMs: 60_000,
+    keyPrefix: 'api-token:',
+    keyGenerator: (ctx) => String(ctx.get('apiTokenId')),
+    onRateLimited: (ctx, retryAfter) =>
+      ctx.json({ message: 'Too many requests.', retryAfter }, 429),
+  })
+  ctx.set('apiTokenId', token.id)
+  return limiter(ctx, next)
+}

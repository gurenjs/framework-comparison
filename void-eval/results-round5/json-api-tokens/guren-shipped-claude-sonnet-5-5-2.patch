diff --git a/tests/ApiTokenController.test.ts b/tests/ApiTokenController.test.ts
new file mode 100644
index 0000000..ba573a2
--- /dev/null
+++ b/tests/ApiTokenController.test.ts
@@ -0,0 +1,80 @@
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { ApiToken } from '../app/Models/ApiToken.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+  let user: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    user = (await User.create({ name: 'Ann', email: 'ann@example.com', password: 'secret-pass-1' }))!
+  })
+
+  async function issueToken(name = 'CI'): Promise<{ id: number; token: string }> {
+    const csrf = await http.actingAs(user).withCsrf()
+    const res = await csrf.json().post('/profile/tokens', { name })
+    expect(res.status).toBe(201)
+    return res.json()
+  }
+
+  const bearer = (token: string) => http.json().withHeader('Authorization', `Bearer ${token}`)
+
+  test('stores only a hash of the token', async () => {
+    const { token } = await issueToken()
+    const secret = token.split('|')[1]
+    const rows = await ApiToken.newQuery().get()
+    expect(rows).toHaveLength(1)
+    expect(JSON.stringify(rows)).not.toContain(secret)
+  })
+
+  test('rejects a bad name', async () => {
+    const csrf = await http.actingAs(user).withCsrf()
+    expect((await csrf.json().post('/profile/tokens', { name: '' })).status).toBe(422)
+    expect((await csrf.json().post('/profile/tokens', { name: 'x'.repeat(51) })).status).toBe(422)
+    expect(await ApiToken.newQuery().get()).toHaveLength(0)
+  })
+
+  test('creates posts as the token owner and lists them', async () => {
+    const { token } = await issueToken()
+    const created = await bearer(token).post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    expect(created.status).toBe(201)
+    expect((await created.json<{ data: { authorId: number } }>()).data.authorId).toBe(user.id)
+    expect((await bearer(token).post('/api/posts', { title: '', excerpt: 'E', body: 'B' })).status).toBe(422)
+
+    const list = await bearer(token).get('/api/posts')
+    expect(list.status).toBe(200)
+    expect((await list.json<{ data: unknown[] }>()).data).toHaveLength(1)
+    expect(await Post.newQuery().get()).toHaveLength(1)
+  })
+
+  test('rejects bad and revoked tokens', async () => {
+    const { id, token } = await issueToken()
+    expect((await bearer(`${token}x`).get('/api/posts')).status).toBe(401)
+    expect((await bearer('nope').get('/api/posts')).status).toBe(401)
+
+    const csrf = await http.actingAs(user).withCsrf()
+    expect((await csrf.json().delete(`/profile/tokens/${id}`)).status).toBe(204)
+    expect((await bearer(token).get('/api/posts')).status).toBe(401)
+  })
+
+  test('limits each token to 60 requests a minute', async () => {
+    const first = await issueToken('one')
+    const second = await issueToken('two')
+    for (let i = 0; i < 60; i++) {
+      expect((await bearer(first.token).get('/api/posts')).status).toBe(200)
+    }
+    const limited = await bearer(first.token).get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    expect((await bearer(second.token).get('/api/posts')).status).toBe(200)
+  })
+})

diff --git a/app/Http/Middleware/ApiTokenAuth.ts b/app/Http/Middleware/ApiTokenAuth.ts
new file mode 100644
index 0000000..2bf0dc0
--- /dev/null
+++ b/app/Http/Middleware/ApiTokenAuth.ts
@@ -0,0 +1,59 @@
+import { createHash } from 'node:crypto'
+import { defineMiddleware } from '@guren/core'
+import { ApiToken } from '../../Models/ApiToken.js'
+
+export const API_TOKEN_USER_KEY = 'apiToken.userId'
+
+const LIMIT = 60
+const WINDOW_MS = 60_000
+
+interface Window {
+  start: number
+  count: number
+}
+
+// In process memory like the auth throttles: counts are not shared across instances.
+const windows = new Map<string, Window>()
+
+export function hashApiToken(secret: string): string {
+  return createHash('sha256').update(secret).digest('hex')
+}
+
+// Tokens are `<row id>|<secret>`; only the hash of the secret is stored.
+export function parseBearer(header: string | undefined): { id: number; secret: string } | null {
+  const match = header?.match(/^Bearer ([^\s|]+)\|([^\s|]+)$/i)
+  if (!match) return null
+  const id = Number(match[1])
+  return Number.isSafeInteger(id) && id > 0 ? { id, secret: match[2] } : null
+}
+
+function consume(key: string, now: number): number | null {
+  const current = windows.get(key)
+  if (!current || now - current.start >= WINDOW_MS) {
+    windows.set(key,{ start: now, count: 1 })
+    return null
+  }
+  if (current.count >= LIMIT) {
+    return Math.min(60, Math.max(1, Math.ceil((current.start + WINDOW_MS - now) / 1000)))
+  }
+  current.count += 1
+  return null
+}
+
+export const apiTokenAuth = defineMiddleware(async (ctx, next) => {
+  const unauthenticated = () => ctx.json({ message: 'Unauthenticated.' }, 401)
+
+  const parsed = parseBearer(ctx.req.header('Authorization'))
+  if (!parsed) return unauthenticated()
+
+  const token = await ApiToken.find(parsed.id)
+  if (!token || token.tokenHash !== hashApiToken(parsed.secret)) return unauthenticated()
+
+  const retryAfter = consume(token.tokenHash, Date.now())
+  if (retryAfter !== null) {
+    return ctx.json({ message: 'Too many requests.', retryAfter }, 429, { 'Retry-After': String(retryAfter) })
+  }
+
+  ctx.set(API_TOKEN_USER_KEY, token.userId)
+  return next()
+})

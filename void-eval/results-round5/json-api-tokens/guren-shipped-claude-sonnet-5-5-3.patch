diff --git a/app/Http/Middleware/ApiAuth.ts b/app/Http/Middleware/ApiAuth.ts
new file mode 100644
index 0000000..0102199
--- /dev/null
+++ b/app/Http/Middleware/ApiAuth.ts
@@ -0,0 +1,56 @@
+import {
+  API_TOKEN_KEY,
+  DatabaseApiTokenStore,
+  createRateLimitMiddleware,
+  getApiToken,
+  readBearerToken,
+  verifyApiToken,
+} from '@guren/core'
+import type { Context, Middleware } from '@guren/core'
+import { apiTokens } from '../../../db/schema.js'
+
+let store: DatabaseApiTokenStore | undefined
+
+// Built on first use: the ORM is configured during boot, after modules load.
+export function apiTokenStore(): DatabaseApiTokenStore {
+  store ??= new DatabaseApiTokenStore(apiTokens)
+  return store
+}
+
+let limiter: Middleware | undefined
+
+function unauthorized(ctx: Context): Response {
+  return ctx.json({ message: 'Unauthenticated.' }, 401)
+}
+
+// The 60 per minute budget belongs to the token, not the account or the IP.
+function throttle(): Middleware {
+  limiter ??= createRateLimitMiddleware({
+    limit: 60,
+    windowMs: 60_000,
+    keyPrefix: 'api:token:',
+    keyGenerator: (ctx) => getApiToken(ctx)?.token.id ?? 'unknown',
+    onRateLimited: (ctx, retryAfter) => {
+      const seconds = String(Math.min(60, Math.max(1, Math.ceil(retryAfter))))
+      return ctx.json({ message: 'Too many requests.', retryAfter: Number(seconds) }, 429, {
+        'Retry-After': seconds,
+      })
+    },
+  })
+  return limiter
+}
+
+/**
+ * Authenticates `Authorization: Bearer <token>` against `api_tokens`, then
+ * counts the request against that token. Always answers JSON.
+ */
+export const apiAuth: Middleware = async (ctx, next) => {
+  const plain = readBearerToken(ctx.req.header('Authorization'))
+  const verified = plain ? await verifyApiToken(plain, apiTokenStore()) : null
+  if (!verified) {
+    return unauthorized(ctx)
+  }
+
+  ctx.set(API_TOKEN_KEY, verified)
+  return throttle()(ctx, next)
+}

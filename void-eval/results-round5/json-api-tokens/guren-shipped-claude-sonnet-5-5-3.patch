diff --git a/tests/ApiTokens.test.ts b/tests/ApiTokens.test.ts
new file mode 100644
index 0000000..051acdf
--- /dev/null
+++ b/tests/ApiTokens.test.ts
@@ -0,0 +1,74 @@
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { User } from '../app/Models/User.js'
+import { Post } from '../app/Models/Post.js'
+import { apiTokenStore } from '../app/Http/Middleware/ApiAuth.js'
+
+describe('personal API tokens', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function createToken(userId: number, name = 'CI') {
+    const user = await User.find(userId)
+    const csrf = await http.actingAs(user!).json().withCsrf()
+    const response = await csrf.post('/profile/tokens', { name })
+    expect(response.status).toBe(201)
+    return (await response.json()) as { id: string; name: string; token: string }
+  }
+
+  async function makeUser(email: string) {
+    return User.create({ name: 'U', email, password: 'secret-password-1' })
+  }
+
+  test('token authenticates the owner and only a hash is stored', async () => {
+    const user = (await makeUser('a@example.com'))!
+    const created = await createToken(user.id)
+    const secret = created.token.split('|')[1] ?? ''
+    expect(secret.length).toBeGreaterThanOrEqual(16)
+    const stored = await apiTokenStore().findByUserId(user.id)
+    expect(JSON.stringify(stored)).not.toContain(secret)
+
+    const bearer = http.json().withHeader('Authorization', `Bearer ${created.token}`)
+    const created2 = await bearer.post('/api/posts', { title: 'T', excerpt: 'E', body: 'B', authorId: 999 })
+    expect(created2.status).toBe(201)
+    expect(((await created2.json()) as { data: { authorId: number } }).data.authorId).toBe(user.id)
+    expect((await bearer.post('/api/posts', { title: '', excerpt: 'E', body: 'B' })).status).toBe(422)
+    const list = await bearer.get('/api/posts')
+    expect(list.status).toBe(200)
+    expect(await Post.newQuery().count()).toBe(1)
+
+    expect((await http.json().get('/api/posts')).status).toBe(401)
+    expect((await http.json().withHeader('Authorization', `Bearer ${created.token}x`).get('/api/posts')).status).toBe(401)
+  })
+
+  test('revocation, ownership and per-token rate limit', async () => {
+    const a = (await makeUser('a@example.com'))!
+    const b = (await makeUser('b@example.com'))!
+    const t1 = await createToken(a.id, 'one')
+    const t2 = await createToken(a.id, 'two')
+    const tb = await createToken(b.id, 'b')
+
+    const csrfB = await http.actingAs((await User.find(b.id))!).json().withCsrf()
+    expect((await csrfB.delete(`/profile/tokens/${t1.id}`)).status).toBe(404)
+
+    const one = http.json().withHeader('Authorization', `Bearer ${t1.token}`)
+    for (let i = 0; i < 60; i++) expect((await one.get('/api/posts')).status).toBe(200)
+    const limited = await one.get('/api/posts')
+    expect(limited.status).toBe(429)
+    expect(Number(limited.headers.get('Retry-After'))).toBeLessThanOrEqual(60)
+    expect((await http.json().withHeader('Authorization', `Bearer ${t2.token}`).get('/api/posts')).status).toBe(200)
+
+    const csrfA = await http.actingAs((await User.find(a.id))!).json().withCsrf()
+    expect((await csrfA.delete(`/profile/tokens/${t2.id}`)).status).toBe(204)
+    expect((await http.json().withHeader('Authorization', `Bearer ${t2.token}`).get('/api/posts')).status).toBe(401)
+    expect((await http.json().withHeader('Authorization', `Bearer ${tb.token}`).get('/api/posts')).status).toBe(200)
+  })
+})

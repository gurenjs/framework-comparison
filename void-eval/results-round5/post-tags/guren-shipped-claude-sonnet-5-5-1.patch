diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..f27feea
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,51 @@
+import { defineModel } from '@guren/core'
+import { postTags, tags } from '../../db/schema.js'
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {}
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
+
+export async function tagNamesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+  const names = new Map<number, string[]>()
+  if (postIds.length === 0) return names
+
+  const links = await PostTag.newQuery().whereIn('postId', postIds).get()
+  const found = await Tag.newQuery()
+    .whereIn('id', [...new Set(links.map((link) => link.tagId))])
+    .get()
+  const nameById = new Map(found.map((tag) => [tag.id, tag.name]))
+
+  for (const link of links) {
+    const name = nameById.get(link.tagId)
+    if (name === undefined) continue
+    names.set(link.postId, [...(names.get(link.postId) ?? []), name])
+  }
+  for (const list of names.values()) list.sort()
+
+  return names
+}
+
+export async function postIdsWithTag(name: string): Promise<number[]> {
+  const tag = await Tag.first({ name })
+  if (!tag) return []
+
+  const links = await PostTag.newQuery().where('tagId', tag.id).get()
+  return links.map((link) => link.postId)
+}
+
+export async function syncPostTags(postId: number, names: string[]): Promise<void> {
+  const tagIds: number[] = []
+  for (const name of names) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    tagIds.push(tag!.id)
+  }
+
+  await PostTag.delete({ postId })
+  for (const tagId of tagIds) {
+    await PostTag.create({ postId, tagId })
+  }
+}

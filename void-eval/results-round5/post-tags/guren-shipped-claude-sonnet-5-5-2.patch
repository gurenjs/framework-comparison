diff --git a/app/Models/Tag.ts b/app/Models/Tag.ts
new file mode 100644
index 0000000..f26b194
--- /dev/null
+++ b/app/Models/Tag.ts
@@ -0,0 +1,33 @@
+import { defineModel } from '@guren/core'
+import { tags } from '../../db/schema.js'
+import { PostTag } from './PostTag.js'
+
+export type TagRecord = typeof tags.$inferSelect
+
+export class Tag extends defineModel(tags, {
+  fillable: ['name'],
+}) {
+  static async namesByPost(postIds: number[]): Promise<Map<number, string[]>> {
+    const names = new Map<number, string[]>(postIds.map((id) => [id, []]))
+    const links = await PostTag.whereIn('postId', postIds).get()
+    const rows = await Tag.whereIn('id', links.map((link) => link.tagId)).get()
+    const nameById = new Map(rows.map((row) => [row.id, row.name]))
+
+    for (const link of links) {
+      const name = nameById.get(link.tagId)
+      if (name !== undefined) names.get(link.postId)?.push(name)
+    }
+    for (const list of names.values()) list.sort()
+
+    return names
+  }
+
+  static async syncPost(postId: number, names: string[]): Promise<void> {
+    await PostTag.delete({ postId })
+
+    for (const name of names) {
+      const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+      if (tag?.id !== undefined) await PostTag.create({ postId, tagId: tag.id })
+    }
+  }
+}

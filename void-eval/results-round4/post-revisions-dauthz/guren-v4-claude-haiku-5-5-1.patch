@@ -0,0 +1,48 @@
+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface Revision {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  post: PostResourceData
+  revisions: Revision[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`History: ${post.title}`} />
+      <header>
+        <h1>History of {post.title}</h1>
+        <Link href={route('posts.show', { id: post.id })}>← Back to post</Link>
+      </header>
+
+      {revisions.length === 0 ? (
+        <p>No earlier versions yet.</p>
+      ) : (
+        <ul>
+          {revisions.map((revision) => (
+            <li key={revision.id}>
+              <span>{revision.title}</span>{' '}
+              <span>kept {new Date(revision.createdAt).toLocaleString()}</span>{' '}
+              <Link
+                href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                method="post"
+                as="button"
+                onBefore={() => window.confirm('Restore this version? The current version is kept in the history.')}
+              >
+                Restore
+              </Link>
+            </li>
+          ))}
+        </ul>
+      )}
+    </Layout>
+  )
+}

@@ -0,0 +1,110 @@
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../../src/app.js'
+import { resetDatabase } from '../../config/database.js'
+import { Post } from '../../app/Models/Post.js'
+import { PostRevision } from '../../app/Models/PostRevision.js'
+import { User, type UserRecord } from '../../app/Models/User.js'
+
+async function createUser(email: string): Promise<UserRecord> {
+  return (await User.create({ name: email, email, password: 'secret-password' })) as UserRecord
+}
+
+describe('post revisions', () => {
+  let http: TestApp
+  let author: UserRecord
+  let other: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await createUser('author@example.com')
+    other = await createUser('other@example.com')
+  })
+
+  async function createPost(title: string): Promise<number> {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title, excerpt: 'Excerpt', body: 'Body' }).assertRedirect()
+    const post = await Post.where({ title }).firstOrFail()
+    return post.id
+  }
+
+  async function editPost(postId: number, title: string): Promise<void> {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${postId}`, { title, excerpt: 'Excerpt', body: 'Body' }).assertRedirect(`/posts/${postId}`)
+  }
+
+  test('an edit keeps the previous version and history lists newest first', async () => {
+    const postId = await createPost('First')
+    await editPost(postId, 'Second')
+    await editPost(postId, 'Third')
+
+    const response = await http
+      .actingAs(author)
+      .withHeader('X-Inertia', 'true')
+      .get(`/posts/${postId}/revisions`)
+    const page = await response.json<{ component: string; props: { revisions: { title: string }[] } }>()
+    expect(page.component).toBe('posts/Revisions')
+    expect(page.props.revisions.map((r) => r.title)).toEqual(['Second', 'First'])
+  })
+
+  test('restoring a revision keeps the current version and redirects to the post', async () => {
+    const postId = await createPost('First')
+    await editPost(postId, 'Second')
+    await editPost(postId, 'Third')
+
+    const first = await PostRevision.where({ postId, title: 'First' }).firstOrFail()
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post(`/posts/${postId}/revisions/${first.id}/restore`).assertRedirect(`/posts/${postId}`)
+
+    const post = await Post.find(postId)
+    expect(post?.title).toBe('First')
+    const revisions = await PostRevision.where({ postId }).orderBy('id', 'desc').get()
+    expect(revisions.map((r) => r.title)).toEqual(['Third', 'Second', 'First'])
+  })
+
+  test('non-authors are forbidden and guests are sent to login', async () => {

@@ -0,0 +1,54 @@
+import { Head, Link } from '@inertiajs/react'
+import type { PostResourceData } from '@/app/Http/Resources/PostResource'
+import { route } from '@/.guren/routes.gen'
+import Layout from '../../components/Layout.js'
+
+interface RevisionSummary {
+  id: number
+  title: string
+  createdAt: string
+}
+
+interface Props {
+  post: PostResourceData
+  revisions: RevisionSummary[]
+}
+
+export default function PostRevisions({ post, revisions }: Props) {
+  return (
+    <Layout>
+      <Head title={`History of ${post.title}`} />
+      <section>
+        <h1>
+          <span aria-hidden />
+          Revisions of {post.title}
+        </h1>
+
+        {revisions.length === 0 ? <p>No earlier versions yet.</p> : null}
+
+        <ul>
+          {revisions.map((revision) => (
+            <li key={revision.id}>
+              <span>{revision.title}</span>{' '}
+              <time dateTime={revision.createdAt}>
+                {new Date(revision.createdAt).toLocaleString()}
+              </time>{' '}
+              <Link
+                href={route('posts.revisions.restore', { id: post.id, revisionId: revision.id })}
+                method="post"
+                as="button"
+                onBefore={() => window.confirm('Restore this revision? The current version is kept in the history.')}
+              >
+                Restore
+              </Link>
+            </li>
+          ))}
+        </ul>
+
+        <p>
+          <Link href={route('posts.show', { id: post.id })}>← Back to post</Link>
+        </p>
+      </section>
+    </Layout>
+  )
+}

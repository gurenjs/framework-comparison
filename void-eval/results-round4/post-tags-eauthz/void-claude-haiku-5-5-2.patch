diff --git a/lib/tags.ts b/lib/tags.ts
new file mode 100644
index 0000000..76c515f
--- /dev/null
+++ b/lib/tags.ts
@@ -0,0 +1,30 @@
+import { postTags, tags } from "@schema";
+import { db, eq, inArray } from "void/db";
+
+export async function withTags<T extends { id: number }>(rows: T[]): Promise<(T & { tags: string[] })[]> {
+  if (rows.length === 0) return [];
+  const links = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, rows.map((row) => row.id)));
+
+  const namesByPost = new Map<number, string[]>();
+  for (const link of links) {
+    namesByPost.set(link.postId, [...(namesByPost.get(link.postId) ?? []), link.name]);
+  }
+  return rows.map((row) => ({ ...row, tags: (namesByPost.get(row.id) ?? []).sort() }));
+}
+
+export async function setPostTags(postId: number, names: string[]): Promise<void> {
+  if (names.length === 0) {
+    await db.delete(postTags).where(eq(postTags.postId, postId));
+    return;
+  }
+  await db.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing({ target: tags.name });
+  const rows = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names));
+  await db.batch([
+    db.delete(postTags).where(eq(postTags.postId, postId)),
+    db.insert(postTags).values(rows.map((row) => ({ postId, tagId: row.id }))),
+  ]);
+}
diff --git a/lib/validators.ts b/lib/validators.ts

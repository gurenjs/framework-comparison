@@ -1,9 +1,35 @@
 import { z } from "zod";
 
+const MAX_TAGS_PER_POST = 5;
+const TAG_NAME_MAX_LENGTH = 30;
+
+/** Splits the comma-separated tags field into unique, trimmed, non-empty names. */
+export function parseTagNames(raw: string | undefined): string[] {
+  const names = (raw ?? "")
+    .split(",")
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0);
+  return [...new Set(names)];
+}
+
+const tagsFieldSchema = z
+  .string()
+  .optional()
+  .superRefine((raw, ctx) => {
+    const names = parseTagNames(raw);
+    if (names.length > MAX_TAGS_PER_POST) {
+      ctx.addIssue({ code: "custom", message: `A post can have at most ${MAX_TAGS_PER_POST} tags.` });
+    }
+    if (names.some((name) => [...name].length > TAG_NAME_MAX_LENGTH)) {
+      ctx.addIssue({ code: "custom", message: `Tags must be ${TAG_NAME_MAX_LENGTH} characters or fewer.` });
+    }
+  });
+
 export const postPayloadSchema = z.object({
   title: z.string().trim().min(1, "Title is required.").max(255, "Title must be 255 characters or fewer."),
   excerpt: z.string().trim().min(1, "Excerpt is required.").max(500, "Excerpt must be 500 characters or fewer."),
   body: z.string().trim().min(1, "Body is required."),
+  tags: tagsFieldSchema,
 });
 
 export const profileUpdateSchema = z.object({
@@ -19,6 +45,7 @@ export const profileUpdateSchema = z.object({
 export const listPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),

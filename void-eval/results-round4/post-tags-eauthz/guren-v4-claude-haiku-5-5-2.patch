diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..ed5da1e
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,125 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+describe('post tags', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  async function signedInAuthor(): Promise<TestApp> {
+    const user = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret' })
+    return http.actingAs(user).withCsrf()
+  }
+
+  async function tagNamesOf(postId: number): Promise<string[]> {
+    const links = await PostTag.where({ postId }).get()
+    const tags = await Tag.where({ id: links.map((link) => link.tagId) }).get()
+    return tags.map((tag) => tag.name).sort()
+  }
+
+  it('stores tags on create and shows them on the post page', async () => {
+    const csrf = await signedInAuthor()
+
+    await csrf.post('/posts', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: 'bun, webdev' }).assertRedirect('/posts/1')
+
+    expect(await tagNamesOf(1)).toEqual(['bun', 'webdev'])
+    const page = await http.get('/posts/1').assertOk()
+    expect(await page.text()).toContain('"tags":["bun","webdev"]')
+  })
+
+  it('replaces tags on edit', async () => {
+    const csrf = await signedInAuthor()
+    await csrf.post('/posts', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: 'bun, webdev' })
+
+    await csrf.put('/posts/1', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: 'bun' }).assertRedirect('/posts/1')
+
+    expect(await tagNamesOf(1)).toEqual(['bun'])
+  })
+
+  it('normalizes names: trims, drops empties, and counts duplicates once', async () => {
+    const csrf = await signedInAuthor()
+
+    await csrf.post('/posts', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: ' bun ,bun,,' }).assertRedirect()
+
+    expect(await tagNamesOf(1)).toEqual(['bun'])
+  })
+
+  it('filters the list by tag and keeps tags on every post', async () => {
+    const csrf = await signedInAuthor()
+    await csrf.post('/posts', { title: 'Bun post', excerpt: 'E', body: 'B', tags: 'bun' })
+    await csrf.post('/posts', { title: 'Plain post', excerpt: 'E', body: 'B', tags: '' })
+
+    const filtered = await http.get('/posts?tag=bun').assertOk()
+    const filteredText = await filtered.text()
+    expect(filteredText).toContain('Bun post')
+    expect(filteredText).not.toContain('Plain post')
+
+    const none = await http.get('/posts?tag=nobody-uses-this').assertOk()
+    expect(await none.text()).not.toContain('Bun post')
+
+    const unfiltered = await http.get('/posts').assertOk()
+    expect(await unfiltered.text()).toContain('"tags":[]')
+  })
+
+  it('keeps the tag filter in page links', async () => {
+    const csrf = await signedInAuthor()
+    for (let i = 0; i < 11; i++) {
+      await csrf.post('/posts', { title: `Post ${i}`, excerpt: 'E', body: 'B', tags: 'bun' })
+    }
+
+    const text = await (await http.get('/posts?tag=bun').assertOk()).text()
+    const pageLinks = text.match(/"\/posts\?[^"]*page=2[^"]*"/g) ?? []
+
+    expect(pageLinks.length).toBeGreaterThan(0)
+    for (const link of pageLinks) {
+      expect(link).toContain('tag=bun')
+    }
+  })
+
+  it('refuses more than five tags and writes nothing', async () => {
+    const csrf = await signedInAuthor()
+
+    await csrf
+      .post('/posts', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: 'a,b,c,d,e,f' })
+      .assertUnprocessable()
+
+    expect(await Post.all()).toHaveLength(0)
+    expect(await Tag.all()).toHaveLength(0)
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+
+  it('refuses a 31-character tag and accepts a 30-character one', async () => {
+    const csrf = await signedInAuthor()
+
+    await csrf
+      .post('/posts', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: 'x'.repeat(31) })
+      .assertUnprocessable()
+    await csrf
+      .post('/posts', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: 'x'.repeat(30) })
+      .assertRedirect()
+
+    expect(await tagNamesOf(1)).toEqual(['x'.repeat(30)])
+  })
+
+  it('deletes a tagged post', async () => {
+    const csrf = await signedInAuthor()
+    await csrf.post('/posts', { title: 'Hi', excerpt: 'Hello', body: 'Body', tags: 'bun' })
+
+    await csrf.delete('/posts/1').assertRedirect('/posts')
+
+    expect(await Post.all()).toHaveLength(0)
+    expect(await PostTag.all()).toHaveLength(0)
+  })
+})

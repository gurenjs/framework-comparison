+import { Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+
+interface Props {
+  tags: string[]
+}
+
+export default function PostTags({ tags }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <ul>
+      {tags.map((tag) => (
+        <li key={tag}>
+          <Link href={route('posts.index', { tag })}>{tag}</Link>
+        </li>
+      ))}
+    </ul>
+  )
+}

+++ b/resources/js/components/PostTags.tsx
@@ -0,0 +1,21 @@
+import { Link } from '@inertiajs/react'
+
+interface Props {
+  tags: string[]
+}
+
+export default function PostTags({ tags }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <p>
+      {tags.map((tag) => (
+        <Link key={tag} href={`/posts?tag=${encodeURIComponent(tag)}`}>
+          #{tag}
+        </Link>
+      ))}
+    </p>
+  )
+}

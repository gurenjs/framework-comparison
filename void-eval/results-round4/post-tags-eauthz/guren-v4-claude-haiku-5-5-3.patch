diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..bab9f26
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,115 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostTag, Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface InertiaPage {
+  component: string
+  props: { post?: { tags: string[] }; data?: { id: number; tags: string[] }[] }
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+  })
+
+  async function createPost(tags?: string): Promise<PostRecord> {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'Hello', excerpt: 'Short', body: 'Body text', tags }).assertRedirect()
+    const [post] = await Post.where({ title: 'Hello' }).get()
+    return post
+  }
+
+  async function pageAt(path: string): Promise<InertiaPage> {
+    const res = await http.withHeader('X-Inertia', 'true').get(path)
+    return res.json<InertiaPage>()
+  }
+
+  async function tagNamesOf(postId: number): Promise<string[]> {
+    const links = await PostTag.where({ postId }).get()
+    const names = await Promise.all(links.map(async (link) => (await Tag.find(link.tagId))?.name ?? ''))
+    return names.sort()
+  }
+
+  it('stores tags on create and shows them on the post page', async () => {
+    const post = await createPost('bun, webdev')
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun', 'webdev'])
+    expect((await pageAt(`/posts/${post.id}`)).props.post?.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('replaces the tags on edit', async () => {
+    const post = await createPost('bun, webdev')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .put(`/posts/${post.id}`, { title: 'Hello', excerpt: 'Short', body: 'Body text', tags: 'bun' })
+      .assertRedirect(`/posts/${post.id}`)
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun'])
+    expect((await pageAt(`/posts/${post.id}`)).props.post?.tags).toEqual(['bun'])
+  })
+
+  it('filters the list by tag and gives untagged posts an empty tags array', async () => {
+    const tagged = await createPost('bun')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.post('/posts', { title: 'Plain', excerpt: 'Short', body: 'Body text' }).assertRedirect()
+
+    const filtered = await pageAt('/posts?tag=bun')
+    expect(filtered.props.data?.map((post) => post.id)).toEqual([tagged.id])
+
+    const unknown = await pageAt('/posts?tag=nothing')
+    expect(unknown.props.data).toEqual([])
+
+    const all = await pageAt('/posts')
+    expect(all.props.data?.every((post) => Array.isArray(post.tags))).toBe(true)
+    expect(all.props.data?.find((post) => post.id !== tagged.id)?.tags).toEqual([])
+  })
+
+  it('refuses more than five tags with a 422 and writes nothing', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .post('/posts', { title: 'Hello', excerpt: 'Short', body: 'Body text', tags: 'a,b,c,d,e,f' })
+      .assertUnprocessable()
+
+    expect(await Post.where({ title: 'Hello' }).count()).toBe(0)
+    expect(await Tag.where({ name: ['a', 'b', 'c', 'd', 'e', 'f'] }).count()).toBe(0)
+  })
+
+  it('refuses a 31-character tag and accepts a 30-character one', async () => {
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf
+      .post('/posts', { title: 'Hello', excerpt: 'Short', body: 'Body text', tags: 'a'.repeat(31) })
+      .assertUnprocessable()
+    await csrf
+      .post('/posts', { title: 'Hello', excerpt: 'Short', body: 'Body text', tags: 'a'.repeat(30) })
+      .assertRedirect()
+
+    expect(await Post.where({ title: 'Hello' }).count()).toBe(1)
+  })
+
+  it('trims and deduplicates names', async () => {
+    const post = await createPost(' bun ,bun')
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun'])
+  })
+
+  it('deletes a tagged post', async () => {
+    const post = await createPost('bun')
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(0)
+  })
+})

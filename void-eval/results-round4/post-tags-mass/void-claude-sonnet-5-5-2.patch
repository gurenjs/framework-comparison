+type PostRow = Awaited<ReturnType<typeof selectPosts>>[number];
+export type PostWithAuthor = PostRow & { tags: string[] };
+
+/** Adds `tags` (names sorted alphabetically, `[]` when none) to each post. */
+export async function withTags(rows: PostRow[]): Promise<PostWithAuthor[]> {
+  if (rows.length === 0) return [];
+  const links = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(
+      inArray(
+        postTags.postId,
+        rows.map((r) => r.id),
+      ),
+    );
+  const byPost = new Map<number, string[]>();
+  for (const { postId, name } of links) byPost.set(postId, [...(byPost.get(postId) ?? []), name]);
+  return rows.map((r) => ({ ...r, tags: (byPost.get(r.id) ?? []).sort() }));
+}
+
+/** Makes the post's tags exactly `names`, creating unknown tags and detaching removed ones. */
+export async function syncTags(postId: number, names: string[]): Promise<void> {
+  if (names.length > 0) {
+    await db
+      .insert(tags)
+      .values(names.map((name) => ({ name })))
+      .onConflictDoNothing();
+  }
+  const rows = names.length > 0 ? await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names)) : [];
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+  if (rows.length > 0) {
+    await db
+      .insert(postTags)
+      .values(rows.map((r) => ({ postId, tagId: r.id })))
+      .onConflictDoNothing();
+  }
+}
+
+/** Condition matching posts carrying the tag called `name`. */

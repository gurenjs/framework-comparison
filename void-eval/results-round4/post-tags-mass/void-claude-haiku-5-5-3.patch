+/** Adds each post's tag names, sorted alphabetically; posts without tags get `[]`. */
+export async function withTags<T extends { id: number }>(rows: T[]): Promise<(T & { tags: string[] })[]> {
+  const ids = rows.map((row) => row.id);
+  const links = ids.length
+    ? await db
+        .select({ postId: postTags.postId, name: tags.name })
+        .from(postTags)
+        .innerJoin(tags, eq(tags.id, postTags.tagId))
+        .where(inArray(postTags.postId, ids))
+    : [];
+  return rows.map((row) => ({
+    ...row,
+    tags: links
+      .filter((link) => link.postId === row.id)
+      .map((link) => link.name)
+      .sort(),
+  }));
+}
+
+/** Replaces a post's tags with `names`, creating any tag names not seen before. */
+export async function setPostTags(postId: number, names: string[]): Promise<void> {
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+  if (names.length === 0) return;
+  await db
+    .insert(tags)
+    .values(names.map((name) => ({ name })))
+    .onConflictDoNothing({ target: tags.name });
+  const rows = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names));
+  await db.insert(postTags).values(rows.map((row) => ({ postId, tagId: row.id })));
+}
+
+/** Matches posts carrying the tag `name`; an unknown name matches nothing. */

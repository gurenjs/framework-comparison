diff --git a/app/Models/PostTag.ts b/app/Models/PostTag.ts
new file mode 100644
index 0000000..bdfcd33
--- /dev/null
+++ b/app/Models/PostTag.ts
@@ -0,0 +1,24 @@
+import { defineModel } from '@guren/core'
+import { postTags } from '../../db/schema.js'
+import type { PostRecord } from './Post.js'
+import { Tag } from './Tag.js'
+
+export class PostTag extends defineModel(postTags, {
+  fillable: ['postId', 'tagId'],
+}) {}
+
+export async function withTags<T extends PostRecord>(posts: T[]): Promise<(T & { tags: string[] })[]> {
+  const ids = posts.map((post) => post.id)
+  const links = ids.length > 0 ? await PostTag.newQuery().whereIn('postId', ids).get() : []
+  const tagIds = [...new Set(links.map((link) => link.tagId))]
+  const tagRows = tagIds.length > 0 ? await Tag.newQuery().whereIn('id', tagIds).get() : []
+  const names = new Map(tagRows.map((tag) => [tag.id, tag.name]))
+
+  return posts.map((post) => ({
+    ...post,
+    tags: links
+      .filter((link) => link.postId === post.id)
+      .map((link) => names.get(link.tagId) as string)
+      .sort(),
+  }))
+}

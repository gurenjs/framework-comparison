+import { Link } from '@inertiajs/react'
+
+interface Props {
+  tags: string[]
+}
+
+export default function TagList({ tags }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <ul>
+      {tags.map((tag) => (
+        <li key={tag}>
+          <Link href={`/posts?tag=${encodeURIComponent(tag)}`}>{tag}</Link>
+        </li>
+      ))}
+    </ul>
+  )
+}

diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..a58213f
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,150 @@
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface PageProps {
+  props: {
+    post?: { id: number; tags: string[] }
+    data?: { title: string; tags: string[] }[]
+  }
+}
+
+function postBody(title: string, tags?: string) {
+  return {
+    title,
+    excerpt: 'An excerpt',
+    body: 'A body',
+    ...(tags === undefined ? {} : { tags }),
+  }
+}
+
+async function tagNamesOf(postId: number): Promise<string[]> {
+  const rows = await PostTag.where({ postId }).get()
+  const names: string[] = []
+  for (const row of rows) {
+    const tag = await Tag.findOrFail(row.tagId)
+    names.push(tag.name)
+  }
+  return names.sort()
+}
+
+async function latestPost(): Promise<PostRecord> {
+  const [post] = await Post.newQuery().orderBy('id', 'desc').limit(1).get()
+  return post
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Author', email: 'author@example.com', password: 'secret' })
+  })
+
+  async function store(title: string, tags?: string) {
+    const csrf = await http.actingAs(author).withCsrf()
+    return await csrf.post('/posts', postBody(title, tags))
+  }
+
+  async function pageProps(url: string): Promise<PageProps['props']> {
+    const page = await (await http.withHeader('X-Inertia', 'true').get(url)).json<PageProps>()
+    return page.props
+  }
+
+  test('stores tags and shows them on the post page', async () => {
+    expect((await store('Tagged', 'bun, webdev')).status).toBe(303)
+    const post = await latestPost()
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun', 'webdev'])
+    expect((await pageProps(`/posts/${post.id}`)).post?.tags).toEqual(['bun', 'webdev'])
+  })
+
+  test('edit replaces the tag set', async () => {
+    await store('Tagged', 'bun, webdev')
+    const post = await latestPost()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.put(`/posts/${post.id}`, postBody('Tagged', 'bun')).assertRedirect(`/posts/${post.id}`)
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun'])
+    expect((await pageProps(`/posts/${post.id}`)).post?.tags).toEqual(['bun'])
+  })
+
+  test('filters the list by tag, keeping untagged posts with an empty tags array', async () => {
+    await store('Bun post', 'bun')
+    await store('Deno post', 'deno')
+    await store('Plain post')
+
+    const filtered = await pageProps('/posts?tag=bun')
+    expect(filtered.data?.map((post) => post.title)).toEqual(['Bun post'])
+
+    const missing = await pageProps('/posts?tag=missing')
+    expect(missing.data).toEqual([])
+
+    const unfiltered = await pageProps('/posts')
+    expect(unfiltered.data?.map((post) => post.tags)).toEqual([[], ['deno'], ['bun']])
+  })
+
+  test('page links of a filtered list keep the tag', async () => {
+    for (let index = 0; index < 11; index++) {
+      await store(`Bun ${index}`, 'bun')
+    }
+
+    const page = await (await http.withHeader('X-Inertia', 'true').get('/posts?tag=bun')).json<{
+      props: { pagination: { links: { pages: { url: string | null }[] } } }
+    }>()
+    const urls = page.props.pagination.links.pages.map((link) => link.url)
+    expect(urls.length).toBeGreaterThan(1)
+    for (const url of urls) {
+      expect(url).toContain('tag=bun')
+    }
+  })
+
+  test('refuses more than five tags without writing anything', async () => {
+    const res = await store('Tagged', 'a, b, c, d, e, f')
+    expect(res.status).toBe(422)
+    await res.assertJsonPath('errors.tags.0', 'Provide at most 5 tags.')
+
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+    expect(await PostTag.newQuery().count()).toBe(0)
+  })
+
+  test('refuses a 31-character tag and saves a 30-character one', async () => {
+    expect((await store('Too long', 'x'.repeat(31))).status).toBe(422)
+    expect(await Post.newQuery().count()).toBe(0)
+
+    await store('Just right', 'x'.repeat(30))
+    const post = await latestPost()
+    expect(await tagNamesOf(post.id)).toEqual(['x'.repeat(30)])
+  })
+
+  test('trims and deduplicates names', async () => {
+    await store('Tagged', ' bun ,bun')
+    const post = await latestPost()
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(1)
+  })
+
+  test('deleting a tagged post removes its tag links', async () => {
+    await store('Tagged', 'bun, webdev')
+    const post = await latestPost()
+
+    const csrf = await http.actingAs(author).withCsrf()
+    await csrf.delete(`/posts/${post.id}`).assertRedirect('/posts')
+
+    expect(await Post.find(post.id)).toBeNull()
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(0)
+  })
+})

+interface Props {
+  tags: string[]
+}
+
+export default function PostTags({ tags }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <ul>
+      {tags.map((tag) => (
+        <li key={tag}>
+          <Link href={`${route('posts.index')}?tag=${encodeURIComponent(tag)}`}>{tag}</Link>
+        </li>
+      ))}
+    </ul>
+  )
+}

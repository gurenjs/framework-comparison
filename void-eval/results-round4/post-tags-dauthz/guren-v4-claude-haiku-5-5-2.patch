diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..0310519
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,156 @@
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+interface InertiaPage {
+  component: string
+  props: { post?: { id: number; tags: string[] }; data?: { id: number; tags: string[] }[]; tag?: string | null }
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = (await User.create({ name: 'Author', email: 'author@example.com', password: 'secret' })) as UserRecord
+  })
+
+  async function signedIn(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function inertiaPage(path: string): Promise<InertiaPage> {
+    const response = await http.withHeader('X-Inertia', 'true').get(path)
+    return response.json<InertiaPage>()
+  }
+
+  async function createPost(tags: string): Promise<PostRecord> {
+    const title = `Post ${crypto.randomUUID()}`
+    const csrf = await signedIn()
+    const response = await csrf.post('/posts', { title, excerpt: 'Excerpt', body: 'Body', tags })
+    expect(response.status).toBe(303)
+    const [post] = await Post.where({ title }).get()
+    return post as PostRecord
+  }
+
+  async function tagNamesOf(postId: number): Promise<string[]> {
+    const links = await PostTag.where({ postId }).get()
+    const names: string[] = []
+    for (const link of links) {
+      const tag = await Tag.find(link.tagId)
+      if (tag) names.push(tag.name)
+    }
+    return names.sort()
+  }
+
+  test('store attaches the listed tags and the post page shows them', async () => {
+    const post = await createPost('bun, webdev')
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun', 'webdev'])
+    const page = await inertiaPage(`/posts/${post.id}`)
+    expect(page.props.post?.tags).toEqual(['bun', 'webdev'])
+  })
+
+  test('update replaces the tags of a post', async () => {
+    const post = await createPost('bun, webdev')
+    const csrf = await signedIn()
+    await csrf.put(`/posts/${post.id}`, { title: 'Post', excerpt: 'Excerpt', body: 'Body', tags: 'bun' })
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun'])
+    const page = await inertiaPage(`/posts/${post.id}`)
+    expect(page.props.post?.tags).toEqual(['bun'])
+  })
+
+  test('index filters by tag and keeps empty tag lists', async () => {
+    const bunPost = await createPost('bun')
+    const untagged = await createPost('')
+
+    const filtered = await inertiaPage('/posts?tag=bun')
+    expect(filtered.props.data?.map((post) => post.id)).toEqual([bunPost.id])
+    expect(filtered.props.tag).toBe('bun')
+
+    const missing = await inertiaPage('/posts?tag=missing')
+    expect(missing.props.data).toEqual([])
+
+    const all = await inertiaPage('/posts')
+    expect(all.props.data?.map((post) => [post.id, post.tags])).toEqual([
+      [untagged.id, []],
+      [bunPost.id, ['bun']],
+    ])
+  })
+
+  test('page links of a filtered list keep the tag', async () => {
+    for (let i = 0; i < 11; i++) {
+      await createPost('bun')
+    }
+
+    const page = await inertiaPage('/posts?tag=bun')
+    const pages = (page.props as { pagination: { links: { pages: { page: number; url: string | null }[] } } })
+      .pagination.links.pages
+    const second = pages.find((link) => link.page === 2)
+    expect(second?.url).toContain('tag=bun')
+    expect(second?.url).toContain('page=2')
+  })
+
+  test('more than five tags is refused and nothing is written', async () => {
+    const csrf = await signedIn()
+    const response = await csrf.post('/posts', {
+      title: 'Post',
+      excerpt: 'Excerpt',
+      body: 'Body',
+      tags: 'a, b, c, d, e, f',
+    })
+
+    expect(response.status).toBe(422)
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await Tag.newQuery().count()).toBe(0)
+    expect(await PostTag.newQuery().count()).toBe(0)
+  })
+
+  test('tag names are limited to 30 characters', async () => {
+    const csrf = await signedIn()
+    const refused = await csrf.post('/posts', { title: 'Post', excerpt: 'Excerpt', body: 'Body', tags: 'x'.repeat(31) })
+    expect(refused.status).toBe(422)
+    expect(await Post.newQuery().count()).toBe(0)
+
+    const accepted = await createPost('x'.repeat(30))
+    expect(await tagNamesOf(accepted.id)).toEqual(['x'.repeat(30)])
+  })
+
+  test('surrounding spaces and repeats collapse to one tag', async () => {
+    const post = await createPost(' bun ,bun')
+
+    expect(await tagNamesOf(post.id)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: post.id }).count()).toBe(1)
+  })
+
+  test('a non-author cannot delete a tagged post', async () => {
+    const post = await createPost('bun')
+    const other = (await User.create({ name: 'Other', email: 'other@example.com', password: 'secret' })) as UserRecord
+    const csrf = await http.actingAs(other).withCsrf()
+
+    expect((await csrf.delete(`/posts/${post.id}`)).status).toBe(403)
+    expect(await Post.newQuery().count()).toBe(1)
+    expect(await PostTag.newQuery().count()).toBe(1)
+  })
+
+  test('deleting a tagged post removes its tag links', async () => {
+    const post = await createPost('bun, webdev')
+    const csrf = await signedIn()
+    const response = await csrf.delete(`/posts/${post.id}`)
+
+    expect(response.status).toBe(303)
+    expect(await Post.newQuery().count()).toBe(0)
+    expect(await PostTag.newQuery().count()).toBe(0)
+  })
+})

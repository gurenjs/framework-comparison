+const TAG_MAX_LENGTH = 30
+const POST_MAX_TAGS = 5
+
+export function parseTags(input: string | undefined): string[] {
+  const names = (input ?? '')
+    .split(',')
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0)
+  return [...new Set(names)]
+}

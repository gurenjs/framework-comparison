@@ -0,0 +1,14 @@
+import { Link } from "@void/react";
+
+export function TagLinks({ tags }: { tags: string[] }) {
+  if (tags.length === 0) return null;
+  return (
+    <p className="tags">
+      {tags.map((name) => (
+        <Link key={name} href="/posts" data={{ tag: name }}>
+          {name}
+        </Link>
+      ))}
+    </p>
+  );
+}
diff --git a/lib/tags.ts b/lib/tags.ts
new file mode 100644
index 0000000..e54f42f
--- /dev/null
+++ b/lib/tags.ts
@@ -0,0 +1,37 @@
+import { postTags, posts, tags } from "@schema";
+import { db, eq, inArray } from "void/db";
+
+export async function withTags<T extends { id: number }>(rows: T[]): Promise<(T & { tags: string[] })[]> {
+  const ids = rows.map((row) => row.id);
+  const names = new Map<number, string[]>();
+  if (ids.length > 0) {
+    const links = await db
+      .select({ postId: postTags.postId, name: tags.name })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(inArray(postTags.postId, ids));
+    for (const link of links) {
+      names.set(link.postId, [...(names.get(link.postId) ?? []), link.name].sort());
+    }
+  }
+  return rows.map((row) => ({ ...row, tags: names.get(row.id) ?? [] }));
+}
+
+export function taggedWith(name: string) {
+  return inArray(
+    posts.id,
+    db
+      .select({ id: postTags.postId })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(eq(tags.name, name)),
+  );
+}
+
+export async function replacePostTags(postId: number, names: string[]): Promise<void> {
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+  if (names.length === 0) return;
+  await db.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing({ target: tags.name });
+  const rows = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names));
+  await db.insert(postTags).values(rows.map((row) => ({ postId, tagId: row.id })));
+}

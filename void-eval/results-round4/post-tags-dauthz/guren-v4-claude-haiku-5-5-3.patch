+export default function TagList({ tags }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <p>
+      {tags.map((tag) => (
+        <Fragment key={tag}>
+          <Link href={route('posts.index', { tag })}>{tag}</Link>{' '}
+        </Fragment>
+      ))}
+    </p>
+  )
+}

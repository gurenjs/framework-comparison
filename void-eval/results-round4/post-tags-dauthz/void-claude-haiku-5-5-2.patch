@@ -1,9 +1,28 @@
 import { z } from "zod";
 
+/** Comma-separated names: trimmed, empty entries and repeats dropped. */
+export function parseTagNames(raw: string): string[] {
+  const names = raw
+    .split(",")
+    .map((name) => name.trim())
+    .filter((name) => name.length > 0);
+  return [...new Set(names)];
+}
+
+const tagsField = z.string().default("").superRefine((raw, ctx) => {
+  const names = parseTagNames(raw);
+  if (names.some((name) => name.length > 30)) {
+    ctx.addIssue({ code: "custom", message: "Each tag must be 30 characters or fewer." });
+  } else if (names.length > 5) {
+    ctx.addIssue({ code: "custom", message: "A post can have at most 5 tags." });
+  }
+});
+
 export const postPayloadSchema = z.object({
   title: z.string().trim().min(1, "Title is required.").max(255, "Title must be 255 characters or fewer."),
   excerpt: z.string().trim().min(1, "Excerpt is required.").max(500, "Excerpt must be 500 characters or fewer."),
   body: z.string().trim().min(1, "Body is required."),
+  tags: tagsField,
 });
 
 export const profileUpdateSchema = z.object({
@@ -19,6 +38,7 @@ export const profileUpdateSchema = z.object({
 export const listPostsQuerySchema = z.object({
   page: z.coerce.number().int().min(1).default(1),

diff --git a/lib/tags.ts b/lib/tags.ts
new file mode 100644
index 0000000..1c8f3b1
--- /dev/null
+++ b/lib/tags.ts
@@ -0,0 +1,45 @@
+import { posts, postTags, tags } from "@schema";
+import { asc, db, eq, inArray } from "void/db";
+import { parseTagNames } from "./validators";
+
+export function postHasTag(name: string) {
+  return inArray(
+    posts.id,
+    db
+      .select({ id: postTags.postId })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(eq(tags.name, name)),
+  );
+}
+
+export async function saveTags(postId: number, raw: string): Promise<void> {
+  const names = parseTagNames(raw);
+  if (names.length > 0) {
+    await db
+      .insert(tags)
+      .values(names.map((name) => ({ name })))
+      .onConflictDoNothing({ target: tags.name });
+  }
+  const ids = names.length > 0 ? await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names)) : [];
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+  if (ids.length > 0) {
+    await db.insert(postTags).values(ids.map(({ id }) => ({ postId, tagId: id })));
+  }
+}
+
+export async function withTags<T extends { id: number }>(rows: T[]): Promise<(T & { tags: string[] })[]> {
+  const byPost = new Map<number, string[]>();
+  if (rows.length > 0) {
+    const links = await db
+      .select({ postId: postTags.postId, name: tags.name })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(inArray(postTags.postId, rows.map((row) => row.id)))
+      .orderBy(asc(tags.name));
+    for (const { postId, name } of links) {
+      byPost.set(postId, [...(byPost.get(postId) ?? []), name]);
+    }
+  }
+  return rows.map((row) => ({ ...row, tags: byPost.get(row.id) ?? [] }));
+}
diff --git a/lib/validators.ts b/lib/validators.ts

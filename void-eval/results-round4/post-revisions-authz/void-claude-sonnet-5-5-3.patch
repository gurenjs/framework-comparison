diff --git a/lib/revisions.ts b/lib/revisions.ts
new file mode 100644
index 0000000..67e2163
--- /dev/null
+++ b/lib/revisions.ts
@@ -0,0 +1,47 @@
+import { HTTPException } from "hono/http-exception";
+import { postRevisions, posts } from "@schema";
+import { and, db, eq } from "void/db";
+import { z } from "zod";
+
+/** Keeps the post's current title, excerpt and body as a new revision. */
+export async function keepRevision(postId: number): Promise<void> {
+  const [current] = await db
+    .select({ title: posts.title, excerpt: posts.excerpt, body: posts.body })
+    .from(posts)
+    .where(eq(posts.id, postId));
+  if (!current) return;
+  await db.insert(postRevisions).values({ postId, ...current });
+}
+
+/** Edits a post, keeping the version it had before as a revision. */
+export async function updatePostWithRevision(
+  postId: number,
+  values: { title: string; excerpt: string; body: string },
+): Promise<void> {
+  await keepRevision(postId);
+  await db.update(posts).set(values).where(eq(posts.id, postId));
+}
+
+/** Restoring is an edit: the current version is kept as a revision first. */
+export async function restoreRevision(
+  postId: number,
+  revision: { title: string; excerpt: string; body: string },
+): Promise<void> {
+  await updatePostWithRevision(postId, {
+    title: revision.title,
+    excerpt: revision.excerpt,
+    body: revision.body,
+  });
+}
+
+/** Finds a revision of the given post; a revision of another post is a 404. */
+export async function findRevisionOrFail(postId: number, rawRevisionId: string | undefined) {
+  const parsed = z.coerce.number().int().positive().safeParse(rawRevisionId);
+  if (!parsed.success) throw new HTTPException(404, { message: "Revision not found" });
+  const [revision] = await db
+    .select()
+    .from(postRevisions)
+    .where(and(eq(postRevisions.id, parsed.data), eq(postRevisions.postId, postId)));
+  if (!revision) throw new HTTPException(404, { message: "Revision not found" });
+  return revision;
+}

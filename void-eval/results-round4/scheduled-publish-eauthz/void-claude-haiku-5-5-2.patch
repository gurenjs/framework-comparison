diff --git a/lib/schedule.ts b/lib/schedule.ts
new file mode 100644
index 0000000..4eddb5a
--- /dev/null
+++ b/lib/schedule.ts
@@ -0,0 +1,15 @@
+/** Shows a stored UTC instant in a datetime-local input, in the browser's time zone. */
+export function toDateTimeLocal(iso: string | null | undefined): string {
+  if (!iso) return "";
+  const date = new Date(iso);
+  return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
+}
+
+/** Turns a datetime-local value (browser time zone) into the UTC ISO string the server stores. */
+export function fromDateTimeLocal(local: string): string {
+  return local ? new Date(local).toISOString() : "";
+}
+
+export function isScheduled(iso: string | null): boolean {
+  return iso !== null && new Date(iso).getTime() > Date.now();
+}

+export function toPublishedAt(publishAt: string | null | undefined): string | null {
+  return publishAt ? new Date(publishAt).toISOString() : null
+}
+
+export function isVisibleTo(
+  post: Pick<PostRecord, 'authorId' | 'publishedAt'>,
+  viewerId: number | null,
+): boolean {
+  if (viewerId !== null && viewerId === post.authorId) return true
+  return post.publishedAt === null || Date.parse(post.publishedAt) <= Date.now()
+}
+
+// ISO 8601 UTC strings compare correctly as text, so the database can filter on them.
+export function visibleTo(viewerId: number | null): WhereGroupCallback<PostRecord> {
+  const now = new Date().toISOString()
+  return (query) => {
+    query.whereNull('publishedAt').orWhere('publishedAt', '<=', now)
+    if (viewerId !== null) query.orWhere('authorId', viewerId)
+  }
+}

+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,27 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+  postAuthorId: number
+}
+
+/**
+ * Bound to the Comment model in app/Providers/AuthorizationProvider.ts. The
+ * caller supplies `postAuthorId` alongside the comment, since the post's
+ * author is not on the comment row.
+ */
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  report(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike): boolean {
+    if (user === null) return false
+    const userId = Number(user.id)
+    return userId === comment.userId || userId === comment.postAuthorId
+  }
+}

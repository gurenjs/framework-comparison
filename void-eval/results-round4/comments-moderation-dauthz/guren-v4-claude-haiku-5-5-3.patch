diff --git a/tests/CommentController.test.ts b/tests/CommentController.test.ts
new file mode 100644
index 0000000..f3e09c8
--- /dev/null
+++ b/tests/CommentController.test.ts
@@ -0,0 +1,153 @@
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Comment } from '../app/Models/Comment.js'
+import { CommentReport } from '../app/Models/CommentReport.js'
+import { Post } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const PASSWORD = 'secret-password'
+
+async function makeUser(name: string): Promise<UserRecord> {
+  return (await User.create({ name, email: `${name}@example.com`, password: PASSWORD })) as UserRecord
+}
+
+async function makePost(authorId: number): Promise<number> {
+  const post = await Post.forceCreate({ title: 'Post', excerpt: 'Excerpt', body: 'Body', authorId })
+  return post!.id
+}
+
+interface CommentProp {
+  body: string
+  author: { name: string }
+}
+
+async function pageComments(http: TestApp, postId: number): Promise<CommentProp[]> {
+  const res = await http.withHeader('X-Inertia', 'true').get(`/posts/${postId}`)
+  return (await res.json<{ props: { comments: CommentProp[] } }>()).props.comments
+}
+
+describe('comments', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  test('a guest is sent to login and stores nothing', async () => {
+    const author = await makeUser('author')
+    const postId = await makePost(author.id)
+
+    const csrf = await http.withCsrf()
+    await csrf.post(`/posts/${postId}/comments`, { body: 'hello' }).assertRedirect('/login')
+
+    expect(await Comment.newQuery().get()).toHaveLength(0)
+  })
+
+  test('a signed-in user comments on another post, shown oldest first with its author', async () => {
+    const author = await makeUser('author')
+    const reader = await makeUser('reader')
+    const postId = await makePost(author.id)
+
+    const session = await http.actingAs(reader).withCsrf()
+    await session.post(`/posts/${postId}/comments`, { body: 'first' }).assertRedirect(`/posts/${postId}`)
+    await session.post(`/posts/${postId}/comments`, { body: 'second' }).assertRedirect(`/posts/${postId}`)
+
+    const rows = await Comment.newQuery().where({ postId }).orderBy('id', 'asc').get()
+    expect(rows.map((row) => [row.body, row.userId])).toEqual([
+      ['first', reader.id],
+      ['second', reader.id],
+    ])
+
+    const comments = await pageComments(http, postId)
+    expect(comments.map((comment) => [comment.body, comment.author.name])).toEqual([
+      ['first', 'reader'],
+      ['second', 'reader'],
+    ])
+  })
+
+  test('an invalid body is rejected and stores nothing', async () => {
+    const author = await makeUser('author')
+    const postId = await makePost(author.id)
+
+    const session = await http.actingAs(author).withCsrf()
+    await session.post(`/posts/${postId}/comments`, { body: '   ' }).assertUnprocessable()
+    await session.post(`/posts/${postId}/comments`, { body: 'x'.repeat(2001) }).assertUnprocessable()
+
+    expect(await Comment.newQuery().get()).toHaveLength(0)
+  })
+
+  test('only the comment author or the post author can delete a comment', async () => {
+    const author = await makeUser('author')
+    const commenter = await makeUser('commenter')
+    const stranger = await makeUser('stranger')
+    const postId = await makePost(author.id)
+    await Comment.create({ body: 'by commenter' }, { set: { postId, userId: commenter.id } })
+    const comment = (await Comment.newQuery().get())[0]!
+
+    await (await http.actingAs(stranger).withCsrf()).delete(`/comments/${comment.id}`).assertForbidden()
+    expect(await Comment.newQuery().get()).toHaveLength(1)
+
+    await (await http.actingAs(commenter).withCsrf())
+      .delete(`/comments/${comment.id}`)
+      .assertRedirect(`/posts/${postId}`)
+    expect(await Comment.newQuery().get()).toHaveLength(0)
+
+    await Comment.create({ body: 'by commenter again' }, { set: { postId, userId: commenter.id } })
+    const second = (await Comment.newQuery().get())[0]!
+    await (await http.actingAs(author).withCsrf())
+      .delete(`/comments/${second.id}`)
+      .assertRedirect(`/posts/${postId}`)
+    expect(await Comment.newQuery().get()).toHaveLength(0)
+  })
+
+  test('reports are idempotent, and three reporters hide a comment from the page only', async () => {
+    const author = await makeUser('author')
+    const commenter = await makeUser('commenter')
+    const reporters = [await makeUser('r1'), await makeUser('r2'), await makeUser('r3')]
+    const postId = await makePost(author.id)
+    await Comment.create({ body: 'spam' }, { set: { postId, userId: commenter.id } })
+    const comment = (await Comment.newQuery().get())[0]!
+
+    const first = await http.actingAs(reporters[0]!).withCsrf()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    await first.post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await CommentReport.newQuery().where({ commentId: comment.id }).get()).toHaveLength(1)
+
+    await (await http.actingAs(reporters[1]!).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await pageComments(http, postId)).toHaveLength(1)
+
+    await (await http.actingAs(reporters[2]!).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+    expect(await pageComments(http, postId)).toHaveLength(0)
+    expect(await Comment.newQuery().get()).toHaveLength(1)
+  })
+
+  test('a stranger cannot delete a post', async () => {
+    const author = await makeUser('author')
+    const stranger = await makeUser('stranger')
+    const postId = await makePost(author.id)
+
+    await (await http.actingAs(stranger).withCsrf()).delete(`/posts/${postId}`).assertForbidden()
+
+    expect(await Post.newQuery().where({ id: postId }).get()).toHaveLength(1)
+  })
+
+  test('deleting a post deletes its comments', async () => {
+    const author = await makeUser('author')
+    const commenter = await makeUser('commenter')
+    const postId = await makePost(author.id)
+    await Comment.create({ body: 'one' }, { set: { postId, userId: commenter.id } })
+    const comment = (await Comment.newQuery().get())[0]!
+    await (await http.actingAs(commenter).withCsrf()).post(`/comments/${comment.id}/report`).assertNoContent()
+
+    await (await http.actingAs(author).withCsrf()).delete(`/posts/${postId}`).assertRedirect('/posts')
+
+    expect(await Comment.newQuery().get()).toHaveLength(0)
+    expect(await CommentReport.newQuery().get()).toHaveLength(0)
+  })
+})

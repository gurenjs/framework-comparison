+++ b/routes/comments/[id]/report.ts
@@ -0,0 +1,16 @@
+import { defineHandler } from "void";
+import { db, eq } from "void/db";
+import { commentReports, comments } from "@schema";
+import { parseCommentId } from "../../../lib/comments";
+import { userOrRedirect } from "../../../lib/guards";
+
+export const POST = defineHandler(async (c) => {
+  const user = userOrRedirect(c);
+  if (user instanceof Response) return user;
+  const commentId = parseCommentId(c.req.param("id"));
+  const [comment] = await db.select({ id: comments.id }).from(comments).where(eq(comments.id, commentId));
+  if (comment) {
+    await db.insert(commentReports).values({ commentId, userId: user.id }).onConflictDoNothing();
+  }
+  return null;
+});

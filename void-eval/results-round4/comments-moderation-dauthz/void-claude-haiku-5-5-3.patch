diff --git a/lib/comments.ts b/lib/comments.ts
new file mode 100644
index 0000000..7172178
--- /dev/null
+++ b/lib/comments.ts
@@ -0,0 +1,36 @@
+import { HTTPException } from "hono/http-exception";
+import { comments, commentReports } from "@schema";
+import { and, asc, db, eq, sql } from "void/db";
+import { users } from "./users";
+import { postIdSchema } from "./validators";
+
+export const HIDE_AFTER_REPORTS = 3;
+
+/** Comments on a post that are not yet hidden by reports, oldest first. */
+export function selectVisibleComments(postId: number) {
+  const reportCount = sql<number>`(select count(*) from ${commentReports} where ${commentReports.commentId} = ${comments.id})`;
+  return db
+    .select({
+      id: comments.id,
+      postId: comments.postId,
+      body: comments.body,
+      createdAt: comments.createdAt,
+      author: { id: users.id, name: users.name },
+    })
+    .from(comments)
+    .innerJoin(users, eq(users.id, comments.userId))
+    .where(and(eq(comments.postId, postId), sql`${reportCount} < ${HIDE_AFTER_REPORTS}`))
+    .orderBy(asc(comments.createdAt), asc(comments.id));
+}
+
+export function parseCommentId(raw: string | undefined): number {
+  const parsed = postIdSchema.safeParse(raw);
+  if (!parsed.success) throw new HTTPException(404, { message: "Comment not found" });
+  return parsed.data;
+}
+
+export async function findCommentOrFail(id: number) {
+  const [comment] = await db.select().from(comments).where(eq(comments.id, id));
+  if (!comment) throw new HTTPException(404, { message: "Comment not found" });
+  return comment;
+}

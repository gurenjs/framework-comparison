+            <Link href={`/posts/${post.id}/edit`}>Edit</Link>{" "}
+            <button type="button" onClick={destroy}>Delete</button>
+          </p>
+        )}
+      </article>
+
+      <section>
+        <h2>Comments</h2>
+        {comments.length === 0 && <p>No comments yet.</p>}
+        {comments.map((comment) => (
+          <CommentItem
+            key={comment.id}
+            comment={comment}
+            postAuthorId={post.authorId}
+            viewerId={viewerId}
+          />
+        ))}
+
+        {viewerId ? (
+          <Form form={form}>
+            <label>
+              Comment <textarea rows={4} value={form.data.body as string} onChange={(e) => form.setData("body", e.target.value)} />
+            </label>
+            {form.errors.body && <p className="error">{form.errors.body}</p>}
+            <button disabled={form.pending}>Post comment</button>
+          </Form>
+        ) : (
+          <p>
+            <Link href="/login">Sign in</Link> to leave a comment.
+          </p>
+        )}
+      </section>
+    </>
+  );
+}
+
+function CommentItem({
+  comment,
+  postAuthorId,
+  viewerId,
+}: {
+  comment: Comment;
+  postAuthorId: string;
+  viewerId: string | null;
+}) {
+  const [reported, setReported] = useState(false);
+  const canDelete = viewerId !== null && (viewerId === comment.author.id || viewerId === postAuthorId);
+
+  async function destroy() {
+    if (!confirm("Delete this comment?")) return;
+    await fetch(`/comments/${comment.id}`, { method: "DELETE", redirect: "manual" });
+    window.location.reload();
+  }
+
+  async function report() {
+    await fetch(`/comments/${comment.id}/report`, { method: "POST" });
+    setReported(true);
+  }
+
   return (
     <article>
-      <h1>{post.title}</h1>
       <p>
         <small>
-          by {post.author.name} · {new Date(post.createdAt).toLocaleDateString()}
+          {comment.author.name} · {new Date(comment.createdAt).toLocaleString()}
         </small>
       </p>
-      <p>{post.excerpt}</p>
-      <div>{post.body}</div>
-      {canManage && (
-        <p>
-          <Link href={`/posts/${post.id}/edit`}>Edit</Link>{" "}
-          <button type="button" onClick={destroy}>Delete</button>
-        </p>
-      )}
+      <div>{comment.body}</div>
+      <p>
+        {canDelete && (
+          <button type="button" onClick={destroy}>
+            Delete
+          </button>
+        )}{" "}
+        {viewerId !== null &&
+          (reported ? (
+            <small>Reported</small>
+          ) : (
+            <button type="button" onClick={report}>
+              Report
+            </button>
+          ))}
+      </p>
     </article>
   );
 }

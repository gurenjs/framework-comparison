diff --git a/app/Models/Comment.ts b/app/Models/Comment.ts
new file mode 100644
index 0000000..40880c2
--- /dev/null
+++ b/app/Models/Comment.ts
@@ -0,0 +1,40 @@
+import { defineModel, type BelongsToRecord } from '@guren/core'
+import { comments, commentReports } from '../../db/schema.js'
+import type { UserRecord } from './User.js'
+
+export type CommentRecord = typeof comments.$inferSelect
+export type CommentReportRecord = typeof commentReports.$inferSelect
+export type CommentAuthorSummary = Pick<UserRecord, 'id' | 'name'>
+
+export const REPORTS_TO_HIDE = 3
+
+export class Comment extends defineModel(comments, {
+  // `postId` and `userId` are set by the controller from the route and session.
+  fillable: ['body'],
+}) {
+  static override relationTypes: { author: BelongsToRecord<CommentAuthorSummary> } = {
+    author: null,
+  }
+
+  static async visibleOnPost(postId: number): Promise<(CommentRecord & { author: CommentAuthorSummary })[]> {
+    const rows = await Comment.newQuery()
+      .with('author')
+      .where({ postId })
+      .orderBy('id', 'asc')
+      .get()
+    const reports = await CommentReport.where({ commentId: rows.map((row) => row.id) }).get()
+
+    const reportCounts = new Map<number, number>()
+    for (const report of reports) {
+      reportCounts.set(report.commentId, (reportCounts.get(report.commentId) ?? 0) + 1)
+    }
+
+    return rows.filter((row) => (reportCounts.get(row.id) ?? 0) < REPORTS_TO_HIDE) as (CommentRecord & {
+      author: CommentAuthorSummary
+    })[]
+  }
+}
+
+Comment.belongsTo('author', () => import('./User.js').then((module) => module.User), 'userId', 'id')
+
+export class CommentReport extends defineModel(commentReports) {}
diff --git a/app/Policies/CommentPolicy.ts b/app/Policies/CommentPolicy.ts
new file mode 100644
index 0000000..728044c
--- /dev/null
+++ b/app/Policies/CommentPolicy.ts
@@ -0,0 +1,22 @@
+import { Policy, type AuthUser } from '@guren/core'
+
+interface CommentLike {
+  userId: number
+  postAuthorId: number
+}
+
+export class CommentPolicy extends Policy {
+  create(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  report(user: AuthUser | null): boolean {
+    return user !== null
+  }
+
+  delete(user: AuthUser | null, comment: CommentLike): boolean {
+    if (user === null) return false
+    const userId = Number(user.id)
+    return userId === comment.userId || userId === comment.postAuthorId
+  }
+}

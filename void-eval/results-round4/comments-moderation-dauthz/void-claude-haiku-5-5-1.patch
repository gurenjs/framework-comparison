diff --git a/lib/comments.ts b/lib/comments.ts
new file mode 100644
index 0000000..0e349ee
--- /dev/null
+++ b/lib/comments.ts
@@ -0,0 +1,61 @@
+import { HTTPException } from "hono/http-exception";
+import { commentReports, comments, posts } from "@schema";
+import { and, asc, db, eq, inArray, notInArray, sql } from "void/db";
+import { users } from "./users";
+import { commentIdSchema } from "./validators";
+
+const HIDDEN_AFTER_REPORTS = 3;
+
+function hiddenCommentIds() {
+  return db
+    .select({ id: commentReports.commentId })
+    .from(commentReports)
+    .groupBy(commentReports.commentId)
+    .having(sql`count(*) >= ${HIDDEN_AFTER_REPORTS}`);
+}
+
+export function listVisibleComments(postId: number) {
+  return db
+    .select({
+      id: comments.id,
+      body: comments.body,
+      createdAt: comments.createdAt,
+      author: { id: users.id, name: users.name },
+    })
+    .from(comments)
+    .innerJoin(users, eq(users.id, comments.userId))
+    .where(and(eq(comments.postId, postId), notInArray(comments.id, hiddenCommentIds())))
+    .orderBy(asc(comments.id));
+}
+
+export function parseCommentId(raw: string | undefined): number {
+  const parsed = commentIdSchema.safeParse(raw);
+  if (!parsed.success) throw new HTTPException(404, { message: "Comment not found" });
+  return parsed.data;
+}
+
+export async function findCommentOrFail(id: number) {
+  const [comment] = await db
+    .select({
+      id: comments.id,
+      postId: comments.postId,
+      userId: comments.userId,
+      postAuthorId: posts.authorId,
+    })
+    .from(comments)
+    .innerJoin(posts, eq(posts.id, comments.postId))
+    .where(eq(comments.id, id));
+  if (!comment) throw new HTTPException(404, { message: "Comment not found" });
+  return comment;
+}
+
+export async function deleteComment(id: number): Promise<void> {
+  await db.delete(commentReports).where(eq(commentReports.commentId, id));
+  await db.delete(comments).where(eq(comments.id, id));
+}
+
+export async function deleteCommentsOfPost(postId: number): Promise<void> {
+  const postCommentIds = db.select({ id: comments.id }).from(comments).where(eq(comments.postId, postId));
+  await db.delete(commentReports).where(inArray(commentReports.commentId, postCommentIds));
+  await db.delete(comments).where(eq(comments.postId, postId));
+}

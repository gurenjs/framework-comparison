-          <button type="button" onClick={destroy}>Delete</button>
+          <small>
+            by {post.author.name} · {new Date(post.createdAt).toLocaleDateString()}
+          </small>
         </p>
-      )}
-    </article>
+        <p>{post.excerpt}</p>
+        <div>{post.body}</div>
+        {canManage && (
+          <p>
+            <Link href={`/posts/${post.id}/edit`}>Edit</Link>{" "}
+            <button type="button" onClick={destroy}>Delete</button>
+          </p>
+        )}
+      </article>
+
+      <section>
+        <h2>Comments</h2>
+        {comments.map((comment) => (
+          <article key={comment.id}>
+            <p>
+              <small>
+                {comment.author.name} · {new Date(comment.createdAt).toLocaleString()}
+              </small>
+            </p>
+            <p>{comment.body}</p>
+            <p>
+              {(canManage || viewerId === comment.author.id) && (
+                <button type="button" onClick={() => destroyComment(comment.id)}>Delete</button>
+              )}{" "}
+              {viewerId && (
+                <button type="button" onClick={() => reportComment(comment.id)}>Report</button>
+              )}
+            </p>
+          </article>
+        ))}
+
+        {viewerId ? (
+          <Form form={commentForm}>
+            <label>
+              Comment <textarea rows={3} value={String(commentForm.data.body)} onChange={(e) => commentForm.setData("body", e.target.value)} />
+            </label>
+            {commentForm.errors.body && <p className="error">{commentForm.errors.body}</p>}
+            <button disabled={commentForm.pending}>Comment</button>
+          </Form>
+        ) : (
+          <p>
+            <Link href="/login">Log in</Link> to comment.
+          </p>
+        )}
+      </section>
+    </>
   );
 }

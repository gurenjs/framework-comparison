diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..69afa32
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,106 @@
+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const POST_FIELDS = { title: 'Hi', excerpt: 'Short', body: 'Body text' }
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: UserRecord
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-pass' })
+  })
+
+  async function signedIn(): Promise<TestApp> {
+    return http.actingAs(author).withCsrf()
+  }
+
+  async function tagNamesOf(postId: number): Promise<string[]> {
+    const rows = await PostTag.where({ postId }).get()
+    const names = await Promise.all(rows.map(async (row) => (await Tag.find(row.tagId))?.name ?? ''))
+    return names.sort()
+  }
+
+  async function inertiaProps(url: string): Promise<Record<string, any>> {
+    const res = await http.withHeader('X-Inertia', 'true').withHeader('Accept', 'application/json').get(url)
+    return (await res.json<{ props: Record<string, any> }>()).props
+  }
+
+  it('stores, attaches and shows tags on create', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: 'bun, webdev' }).assertRedirect('/posts/1')
+
+    const post = await Post.findOrFail(1)
+    expect(await tagNamesOf(post.id)).toEqual(['bun', 'webdev'])
+
+    const props = await inertiaProps('/posts/1')
+    expect(props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  it('replaces tags on edit', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: 'bun, webdev' })
+    const post = await Post.findOrFail(1)
+
+    await csrf.put(`/posts/${post.id}`, { ...POST_FIELDS, tags: 'bun' }).assertRedirect(`/posts/${post.id}`)
+    expect(await tagNamesOf(post.id)).toEqual(['bun'])
+  })
+
+  it('filters the list by tag and keeps the filter on page links', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: 'bun' })
+    await csrf.post('/posts', { ...POST_FIELDS, title: 'Other', tags: 'node' })
+
+    const filtered = await inertiaProps('/posts?tag=bun')
+    expect(filtered.data.map((post: { title: string }) => post.title)).toEqual(['Hi'])
+
+    const pageUrls = filtered.pagination.links.pages.map((page: { url: string }) => page.url)
+    expect(pageUrls.length).toBeGreaterThan(0)
+    for (const url of pageUrls) expect(url).toContain('tag=bun')
+
+    const unused = await inertiaProps('/posts?tag=nobody-uses-this')
+    expect(unused.data).toEqual([])
+
+    const unfiltered = await inertiaProps('/posts')
+    expect(unfiltered.data.map((post: { tags: string[] }) => post.tags)).toEqual([['node'], ['bun']])
+  })
+
+  it('refuses more than five tags with a 422 on tags and saves nothing', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: 'a,b,c,d,e,f' }).assertUnprocessable()
+    expect(await Post.where({}).count()).toBe(0)
+    expect(await Tag.where({}).count()).toBe(0)
+  })
+
+  it('refuses a 31-character tag and accepts a 30-character one', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: 'x'.repeat(31) }).assertUnprocessable()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: 'x'.repeat(30) }).assertRedirect('/posts/1')
+    expect(await tagNamesOf(1)).toEqual(['x'.repeat(30)])
+  })
+
+  it('trims and de-duplicates tag names', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: ' bun ,bun,,' }).assertRedirect('/posts/1')
+    expect(await tagNamesOf(1)).toEqual(['bun'])
+  })
+
+  it('deletes a tagged post', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { ...POST_FIELDS, tags: 'bun' })
+    await csrf.delete('/posts/1').assertRedirect('/posts')
+    expect(await Post.where({}).count()).toBe(0)
+    expect(await PostTag.where({}).count()).toBe(0)
+  })
+})

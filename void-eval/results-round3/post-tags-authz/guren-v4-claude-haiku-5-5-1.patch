+
+async function syncTags(postId: number, input: string): Promise<void> {
+  const wantedIds = new Set<number>()
+  for (const name of parseTagNames(input)) {
+    const tag = (await Tag.first({ name })) ?? (await Tag.create({ name }))
+    wantedIds.add(tag.id)
+  }

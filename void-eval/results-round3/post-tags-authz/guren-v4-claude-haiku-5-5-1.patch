+++ b/resources/js/components/TagLinks.tsx
@@ -0,0 +1,22 @@
+import { Link } from '@inertiajs/react'
+import { route } from '@/.guren/routes.gen'
+
+interface Props {
+  tags: string[]
+}
+
+export default function TagLinks({ tags }: Props) {
+  if (tags.length === 0) {
+    return null
+  }
+
+  return (
+    <p>
+      {tags.map((tag) => (
+        <span key={tag}>
+          <Link href={`${route('posts.index')}?tag=${encodeURIComponent(tag)}`}>#{tag}</Link>{' '}
+        </span>
+      ))}
+    </p>
+  )
+}

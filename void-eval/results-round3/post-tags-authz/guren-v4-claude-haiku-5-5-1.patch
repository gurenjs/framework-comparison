diff --git a/tests/PostTags.test.ts b/tests/PostTags.test.ts
new file mode 100644
index 0000000..6070b98
--- /dev/null
+++ b/tests/PostTags.test.ts
@@ -0,0 +1,110 @@
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post } from '../app/Models/Post.js'
+import { PostTag } from '../app/Models/PostTag.js'
+import { Tag } from '../app/Models/Tag.js'
+import { User } from '../app/Models/User.js'
+
+async function pageProps(http: TestApp, url: string): Promise<Record<string, any>> {
+  const html = await (await http.get(url)).text()
+  const match = html.match(/<script data-page="app" type="application\/json">([\s\S]*?)<\/script>/)
+  if (!match) throw new Error('no Inertia page payload')
+  return JSON.parse(match[1])
+}
+
+describe('post tags', () => {
+  let http: TestApp
+  let author: User
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+    author = await User.create({ name: 'Ada', email: 'ada@example.com', password: 'secret-password' })
+  })
+
+  async function signedIn(): Promise<TestApp> {
+    return (await http.actingAs(author)).withCsrf()
+  }
+
+  test('store attaches tags and show lists them sorted', async () => {
+    const csrf = await signedIn()
+    await csrf
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: 'webdev, bun' })
+      .assertRedirect('/posts/1')
+
+    expect((await Tag.where({}).get()).map((tag) => tag.name).sort()).toEqual(['bun', 'webdev'])
+    expect(await PostTag.where({ postId: 1 }).count()).toBe(2)
+    const props = await pageProps(http, '/posts/1')
+    expect(props.props.post.tags).toEqual(['bun', 'webdev'])
+  })
+
+  test('update replaces tags and the edit form starts with them', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: 'bun, webdev' })
+    await csrf.put('/posts/1', { title: 'T', excerpt: 'E', body: 'B', tags: 'bun' }).assertRedirect('/posts/1')
+
+    expect(await PostTag.where({ postId: 1 }).count()).toBe(1)
+    expect((await pageProps(http, '/posts/1')).props.post.tags).toEqual(['bun'])
+    expect((await pageProps(await signedIn(), '/posts/1/edit')).props.post.tags).toEqual(['bun'])
+  })
+
+  test('update by a non-author is forbidden and leaves tags alone', async () => {
+    await (await signedIn()).post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: 'bun' })
+    const other = await User.create({ name: 'Bob', email: 'bob@example.com', password: 'secret-password' })
+    const csrf = await (await http.actingAs(other)).withCsrf()
+    await csrf.put('/posts/1', { title: 'T', excerpt: 'E', body: 'B', tags: 'webdev' }).assertForbidden()
+    expect((await Tag.where({}).get()).map((tag) => tag.name)).toEqual(['bun'])
+  })
+
+  test('filter lists only posts carrying the tag', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { title: 'Bun post', excerpt: 'E', body: 'B', tags: 'bun' })
+    await csrf.post('/posts', { title: 'Other', excerpt: 'E', body: 'B' })
+
+    const filtered = await pageProps(http, '/posts?tag=bun')
+    expect(filtered.props.data.map((post: { title: string }) => post.title)).toEqual(['Bun post'])
+    expect(filtered.props.pagination.links.pages[0].url).toContain('tag=bun')
+    expect((await pageProps(http, '/posts?tag=nobody')).props.data).toEqual([])
+    const all = await pageProps(http, '/posts')
+    expect(all.props.data.map((post: { tags: string[] }) => post.tags)).toEqual([[], ['bun']])
+  })
+
+  test('six tags are refused and nothing is written', async () => {
+    const csrf = await signedIn()
+    await csrf
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: 'a,b,c,d,e,f' })
+      .assertUnprocessable()
+    expect(await Post.where({}).count()).toBe(0)
+    expect(await Tag.where({}).count()).toBe(0)
+    expect(await PostTag.where({}).count()).toBe(0)
+  })
+
+  test('tag name length is limited to 30 characters', async () => {
+    const csrf = await signedIn()
+    await csrf
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: 'a'.repeat(31) })
+      .assertUnprocessable()
+    await csrf
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: 'a'.repeat(30) })
+      .assertRedirect('/posts/1')
+  })
+
+  test('duplicate and padded names save one tag', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: ' bun ,bun' })
+    expect((await Tag.where({}).get()).map((tag) => tag.name)).toEqual(['bun'])
+    expect(await PostTag.where({ postId: 1 }).count()).toBe(1)
+  })
+
+  test('deleting a tagged post succeeds', async () => {
+    const csrf = await signedIn()
+    await csrf.post('/posts', { title: 'T', excerpt: 'E', body: 'B', tags: 'bun' })
+    await csrf.delete('/posts/1').assertRedirect('/posts')
+    expect(await PostTag.where({}).count()).toBe(0)
+  })
+})

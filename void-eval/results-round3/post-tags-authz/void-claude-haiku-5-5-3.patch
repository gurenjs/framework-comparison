diff --git a/lib/tags.ts b/lib/tags.ts
new file mode 100644
index 0000000..4948a4f
--- /dev/null
+++ b/lib/tags.ts
@@ -0,0 +1,40 @@
+import { postTags, posts, tags } from "@schema";
+import { asc, db, eq, inArray } from "void/db";
+
+/** Replaces a post's tags with `names`, creating any tag name not seen before. */
+export async function saveTags(postId: number, names: string[]): Promise<void> {
+  await db.delete(postTags).where(eq(postTags.postId, postId));
+  if (names.length === 0) return;
+  await db.insert(tags).values(names.map((name) => ({ name }))).onConflictDoNothing();
+  const rows = await db.select({ id: tags.id }).from(tags).where(inArray(tags.name, names));
+  await db.insert(postTags).values(rows.map((row) => ({ postId, tagId: row.id })));
+}
+
+/** Adds `tags: string[]` (sorted names) to each post. */
+export async function attachTags<T extends { id: number }>(rows: T[]): Promise<(T & { tags: string[] })[]> {
+  if (rows.length === 0) return [];
+  const links = await db
+    .select({ postId: postTags.postId, name: tags.name })
+    .from(postTags)
+    .innerJoin(tags, eq(tags.id, postTags.tagId))
+    .where(inArray(postTags.postId, rows.map((row) => row.id)))
+    .orderBy(asc(tags.name));
+  const namesByPost = new Map<number, string[]>();
+  for (const link of links) {
+    const names = namesByPost.get(link.postId);
+    if (names) names.push(link.name);
+    else namesByPost.set(link.postId, [link.name]);
+  }
+  return rows.map((row) => ({ ...row, tags: namesByPost.get(row.id) ?? [] }));
+}
+
+export function postsTaggedWith(name: string) {
+  return inArray(
+    posts.id,
+    db
+      .select({ id: postTags.postId })
+      .from(postTags)
+      .innerJoin(tags, eq(tags.id, postTags.tagId))
+      .where(eq(tags.name, name)),
+  );
+}

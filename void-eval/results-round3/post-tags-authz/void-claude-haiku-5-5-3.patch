+      ctx.addIssue({ code: "custom", message: "Each tag must be 30 characters or fewer.", input: raw });
+    }
+    if (names.length > 5) ctx.addIssue({ code: "custom", message: "A post can have at most 5 tags.", input: raw });
+    return names;
+  });

diff --git a/lib/datetime.ts b/lib/datetime.ts
new file mode 100644
index 0000000..dcb7071
--- /dev/null
+++ b/lib/datetime.ts
@@ -0,0 +1,11 @@
+/** Shows an ISO timestamp in a datetime-local input, in the viewer's time zone. */
+export function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return "";
+  const time = new Date(iso);
+  return new Date(time.getTime() - time.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
+}
+
+/** Turns a datetime-local value, in the viewer's time zone, into an ISO timestamp. */
+export function fromLocalInput(local: string): string {
+  return local ? new Date(local).toISOString() : "";
+}

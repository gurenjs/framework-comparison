+import { beforeAll, beforeEach, describe, expect, it } from 'bun:test'
+import { TestApp } from '@guren/testing'
+import app from '../src/app.js'
+import { resetDatabase } from '../config/database.js'
+import { Post, type PostRecord } from '../app/Models/Post.js'
+import { User, type UserRecord } from '../app/Models/User.js'
+
+const FUTURE = '2999-01-01T09:00:00.000Z'
+const PAST = '2000-01-01T09:00:00.000Z'
+
+async function makeUser(email: string): Promise<UserRecord> {
+  return User.create({ name: email, email, password: 'secret' })
+}
+
+async function makePost(authorId: number, publishedAt: string | null): Promise<PostRecord> {
+  return Post.forceCreate({ title: 'Launch', excerpt: 'Soon', body: 'Body', authorId, publishedAt })
+}
+
+describe('scheduled posts', () => {
+  let http: TestApp
+
+  beforeAll(async () => {
+    http = await TestApp.fromApp(app)
+  })
+
+  beforeEach(async () => {
+    await resetDatabase()
+  })
+
+  it('hides a scheduled post from guests and other users, shows it to its author', async () => {
+    const author = await makeUser('author@example.com')
+    const other = await makeUser('other@example.com')
+    const scheduled = await makePost(author.id, FUTURE)
+
+    await http.get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(other).get(`/posts/${scheduled.id}`).assertNotFound()
+    await http.actingAs(author).get(`/posts/${scheduled.id}`).assertOk()
+
+    const guestList = await http.get('/posts')
+    expect(await guestList.text()).not.toContain('Launch')
+
+    const authorList = await http.actingAs(author).get('/posts')
+    expect(await authorList.text()).toContain('Launch')
+  })
+
+  it('makes a post public once its time has passed, without any action', async () => {
+    const author = await makeUser('author@example.com')
+    const scheduled = await makePost(author.id, FUTURE)
+    await Post.update({ id: scheduled.id }, { publishedAt: PAST })
+
+    await http.get(`/posts/${scheduled.id}`).assertOk()
+  })
+
+  it('rejects a publish date that is not a date and time', async () => {
+    const author = await makeUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', { title: 'T', excerpt: 'E', body: 'B', publishAt: 'next tuesday' })
+      .assertUnprocessable()
+  })
+
+  it('stores a scheduled post when a publish date is given on create', async () => {
+    const author = await makeUser('author@example.com')
+    const csrf = await http.actingAs(author).withCsrf()
+
+    await csrf
+      .post('/posts', { title: 'Later', excerpt: 'E', body: 'B', publishAt: FUTURE })
+      .assertRedirect()
+
+    const [post] = await Post.where({ title: 'Later' }).get()
+    expect(post?.publishedAt).toBe(FUTURE)
+  })
+})

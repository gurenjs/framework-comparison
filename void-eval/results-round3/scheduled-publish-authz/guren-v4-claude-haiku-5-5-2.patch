new file mode 100644
index 0000000..ec722e1
--- /dev/null
+++ b/resources/js/components/PublishAt.tsx
@@ -0,0 +1,34 @@
+interface Props {
+  value: string
+  error?: string
+  onChange: (value: string) => void
+}
+
+export default function PublishAt({ value, error, onChange }: Props) {
+  return (
+    <div>
+      <label>Publish at</label>
+      <input
+        type="datetime-local"
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+      />
+      {error ? <p>{error}</p> : null}
+    </div>
+  )
+}
+
+export function toLocalInput(iso: string | null | undefined): string {
+  if (!iso) return ''
+  const date = new Date(iso)
+  const pad = (part: number) => String(part).padStart(2, '0')
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+export function toPublishAt(local: string | null | undefined): string | null {
+  return local ? new Date(local).toISOString() : null
+}
+
+export function isScheduled(publishedAt: string | null): boolean {
+  return publishedAt !== null && new Date(publishedAt).getTime() > Date.now()
+}
